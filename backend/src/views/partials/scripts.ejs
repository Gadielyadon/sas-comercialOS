<script>
// ── Modo sin internet: Service Worker ─────────────────────────
// Guarda en el equipo las pantallas de Ventas / Stock / Inventario y los datos del
// punto de venta, para poder seguir trabajando si se corta internet.
(function () {
  if (!('serviceWorker' in navigator)) return;
  // Al cerrar sesión se olvida el vendedor guardado en este equipo (otro usuario podría usarlo)
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href="/logout"]');
    if (a) { try { localStorage.removeItem('ax_vendedor'); localStorage.removeItem('ax_warm_at'); } catch (_) {} }
  });
  window.addEventListener('load', function () {
    if (window.AxAuth) AxAuth.finalizarLogin();   // si recién se inició sesión, guarda la verificación para el modo sin internet
    navigator.serviceWorker.register('/sw.js').then(function () {
      if (!document.body.getAttribute('data-user-role')) return;          // solo con sesión iniciada
      if (!navigator.onLine) return;
      var ultimo = Number(localStorage.getItem('ax_warm_at') || 0);
      if (Date.now() - ultimo < 20 * 60 * 1000) return;                   // como mucho cada 20 min
      var SID = <%- JSON.stringify(typeof sucursal_id !== 'undefined' && sucursal_id ? sucursal_id : null) %>;
      var urls = ['/ventas', '/stock', '/inventario', '/api/payment-methods', '/api/config', '/api/clientes'];
      if (SID) urls.push('/api/products?sucursal_id=' + SID);
      navigator.serviceWorker.ready.then(function (reg) {
        if (reg.active) {
          reg.active.postMessage({ type: 'WARM', urls: urls });
          // También los archivos que esta pantalla ya cargó (Bootstrap, íconos, fuentes, estilos)
          var assets = performance.getEntriesByType('resource').map(function (e) { return e.name; })
            .filter(function (n) { return /\.(css|js|woff2?|ttf|png|ico|svg)(\?|$)/i.test(n) || /fonts\.googleapis\.com\/css/.test(n); });
          reg.active.postMessage({ type: 'ASSETS', urls: assets });
          localStorage.setItem('ax_warm_at', String(Date.now()));
        }
      });
    }).catch(function () {});
  });
})();
</script>



