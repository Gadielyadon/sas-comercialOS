<%# ── Topbar fija: hamburguesa (izquierda) + sucursal y campanita (derecha) ── %>
<%
  const _topSucLista = (typeof locals.sucursales_lista !== 'undefined' && Array.isArray(locals.sucursales_lista))
    ? locals.sucursales_lista : [];
  const _topSucActualId = (typeof locals.sucursal !== 'undefined' && locals.sucursal) ? locals.sucursal.id : 1;
%>
<header class="ax-topbar">

  <div class="ax-topbar-section">
    <button class="ax-hamburger" id="axTopbarHamburger" title="Mostrar u ocultar el menú" style="display:flex;">
      <i class="bi bi-list"></i>
    </button>
    <% if (typeof module !== 'undefined' && module) { %>
      <span class="ax-topbar-empresa"><%= module %></span>
    <% } %>
  </div>

  <div class="ax-topbar-right">

    <% if (_topSucLista.length > 1) { %>
    <div style="position:relative;flex-shrink:0;">
      <button id="btnCambiarSuc" onclick="toggleDropSuc(event)" title="Cambiar sucursal" class="ax-notif-btn">
        <i class="bi bi-arrow-left-right"></i>
      </button>
      <div id="dropSuc" style="display:none;position:absolute;top:calc(100% + 8px);right:0;min-width:190px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.25);z-index:9999;overflow:hidden;">
        <div style="padding:8px 13px 5px;font-size: 10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);">Cambiar a</div>
        <% _topSucLista.forEach(s => { const esActual = s.id === _topSucActualId; %>
        <button onclick="cambiarSucursal(<%= s.id %>, '<%= s.nombre.replace(/'/g,"\\'") %>')"
          style="width:100%;padding:9px 14px;border:none;background:<%= esActual ? 'var(--bg-hover)' : 'transparent' %>;color:var(--text-primary);font-size: 14px;font-weight:<%= esActual ? '700' : '500' %>;cursor:pointer;text-align:left;display:flex;align-items:center;gap:8px;font-family:var(--font-body);"
          onmouseover="if(<%= !esActual %>)this.style.background='var(--bg-hover)'"
          onmouseout="if(<%= !esActual %>)this.style.background='transparent'">
          <i class="bi bi-<%= esActual ? 'check-circle-fill' : 'circle' %>" style="font-size: 11.5px;color:<%= esActual ? '#10b981' : 'inherit' %>;"></i>
          <%= s.nombre %>
        </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div id="notifWrap" style="position:relative;flex-shrink:0;">
      <button id="notifBtn" onclick="axNotif.toggle(event)" title="Notificaciones" class="ax-notif-btn">
        <i class="bi bi-bell-fill"></i>
        <span id="notifBadge" class="ax-notif-badge"></span>
      </button>

      <!-- Globito: avisa que hay novedades, para quien no mira la campanita -->
      <div id="notifTip" style="display:none;position:absolute;top:calc(100% + 12px);right:0;z-index:9998;">
        <div style="position:absolute;top:-5px;right:16px;width:10px;height:10px;background:var(--bg-card);border-left:1px solid var(--border-color);border-top:1px solid var(--border-color);transform:rotate(45deg);"></div>
        <div style="display:flex;align-items:center;gap:10px;white-space:nowrap;background:var(--bg-card);border:1px solid var(--border-color);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.18);padding:10px 12px;">
          <div style="width:30px;height:30px;border-radius:9px;background:rgba(99,102,241,.12);color:#6366f1;display:flex;align-items:center;justify-content:center;font-size: 16px;flex-shrink:0;">
            <i class="bi bi-stars"></i>
          </div>
          <button onclick="axNotif.abrirDesdeTip()" style="background:none;border:none;padding:0;text-align:left;cursor:pointer;font-family:var(--font-body);">
            <div style="font-size: 14px;font-weight:800;color:var(--text-primary);line-height:1.3;">Tenés novedades</div>
            <div style="font-size: 12.5px;color:var(--text-secondary);line-height:1.3;">Tocá para ver qué hay de nuevo</div>
          </button>
          <button onclick="axNotif.ocultarTip(event)" title="Ahora no" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size: 13.5px;padding:2px 0 2px 4px;line-height:1;flex-shrink:0;">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>
    </div>

  </div>
</header>
