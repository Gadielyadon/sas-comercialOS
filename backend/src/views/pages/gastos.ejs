<%- include('../partials/scripts') %>
<script>
const _MES  = <%= mes %>;
const _ANIO = <%= anio %>;

// ── Marcar pagado ──────────────────────────────────────────────
function marcarPagado(gastoId, mes, anio, pagarTodo) {
  document.getElementById('pagoGastoId').value = gastoId;
  document.getElementById('pagoMes').value     = mes;
  document.getElementById('pagoAnio').value    = anio;
  document.getElementById('pagoTodo').value    = pagarTodo ? '1' : '0';
  document.getElementById('pagoFecha').value   = new Date().toISOString().split('T')[0];
  document.getElementById('pagoMetodo').value  = '';
  document.getElementById('pagoTodoAviso').style.display    = pagarTodo ? 'block' : 'none';
  document.getElementById('pagoSoloMesAviso').style.display = (!pagarTodo && pagarTodo === false) ? 'block' : 'none';
  document.getElementById('modalPago').classList.add('open');
  setTimeout(function(){ document.getElementById('pagoFecha').focus(); }, 80);
}
function cerrarModalPago() { document.getElementById('modalPago').classList.remove('open'); }

async function confirmarPago() {
  var id       = document.getElementById('pagoGastoId').value;
  var mes      = document.getElementById('pagoMes').value;
  var anio     = document.getElementById('pagoAnio').value;
  var fecha    = document.getElementById('pagoFecha').value;
  var metodo   = document.getElementById('pagoMetodo').value;
  var pagarTodo= document.getElementById('pagoTodo').value === '1';
  try {
    var r = await fetch('/gastos/api/recurrentes/' + id + '/pagar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        mes: Number(mes), anio: Number(anio),
        pagado: true,
        fecha_pago: fecha,
        metodo_pago: metodo || null,
        pagar_todo: pagarTodo,
      }),
    });
    if (!r.ok) { var d = await r.json(); alert(d.error || 'Error'); return; }
    cerrarModalPago();
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Marcar pendiente ───────────────────────────────────────────
async function marcarPendiente(gastoId, mes, anio) {
  if (!confirm('¿Marcar como pendiente?')) return;
  try {
    var r = await fetch('/gastos/api/recurrentes/' + gastoId + '/pagar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mes: mes, anio: anio, pagado: false }),
    });
    if (!r.ok) { var d = await r.json(); alert(d.error || 'Error'); return; }
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Editar monto ───────────────────────────────────────────────
function editarMonto(gastoId, montoActual, mes, anio) {
  document.getElementById('montoGastoId').value = gastoId;
  document.getElementById('montoMes').value     = mes;
  document.getElementById('montoAnio').value    = anio;
  document.getElementById('montoValor').value   = montoActual;
  document.getElementById('modalMonto').classList.add('open');
  setTimeout(function(){ document.getElementById('montoValor').select(); }, 80);
}
function cerrarModalMonto() { document.getElementById('modalMonto').classList.remove('open'); }

async function confirmarMonto() {
  var id    = document.getElementById('montoGastoId').value;
  var mes   = document.getElementById('montoMes').value;
  var anio  = document.getElementById('montoAnio').value;
  var monto = parseFloat(document.getElementById('montoValor').value);
  if (isNaN(monto) || monto < 0) { alert('Monto inválido'); return; }
  try {
    var r = await fetch('/gastos/api/recurrentes/' + id + '/pagar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mes: Number(mes), anio: Number(anio), pagado: false, monto_real: monto }),
    });
    if (!r.ok) { var d = await r.json(); alert(d.error || 'Error'); return; }
    cerrarModalMonto();
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Nuevo / editar gasto fijo ──────────────────────────────────
function abrirModalGasto(rec) {
  document.getElementById('gastoError').style.display = 'none';
  if (rec) {
    document.getElementById('modalGastoTitulo').textContent = 'Editar gasto fijo';
    document.getElementById('gasto_edit_id').value  = rec.id;
    document.getElementById('g_descripcion').value  = rec.descripcion;
    document.getElementById('g_categoria_id').value = rec.categoria_id || '';
    document.getElementById('g_monto').value        = rec.monto_estimado;
    document.getElementById('g_dia').value          = rec.dia_vencimiento;
  } else {
    document.getElementById('modalGastoTitulo').textContent = 'Nuevo gasto fijo';
    document.getElementById('gasto_edit_id').value  = '';
    document.getElementById('g_descripcion').value  = '';
    document.getElementById('g_categoria_id').value = '';
    document.getElementById('g_monto').value        = '';
    document.getElementById('g_dia').value          = '1';
  }
  document.getElementById('modalGasto').classList.add('open');
  setTimeout(function(){ document.getElementById('g_descripcion').focus(); }, 80);
}
function cerrarModalGasto() { document.getElementById('modalGasto').classList.remove('open'); }

async function guardarGasto() {
  var errEl = document.getElementById('gastoError');
  errEl.style.display = 'none';
  var id           = document.getElementById('gasto_edit_id').value;
  var descripcion  = document.getElementById('g_descripcion').value.trim();
  var categoria_id = document.getElementById('g_categoria_id').value || null;
  var monto        = parseFloat(document.getElementById('g_monto').value);
  var dia          = parseInt(document.getElementById('g_dia').value);

  if (!descripcion)           { errEl.textContent = 'El nombre es obligatorio'; errEl.style.display='block'; return; }
  if (isNaN(monto)||monto<=0) { errEl.textContent = 'El monto debe ser mayor a 0'; errEl.style.display='block'; return; }
  if (!dia||dia<1||dia>31)    { errEl.textContent = 'El día debe estar entre 1 y 31'; errEl.style.display='block'; return; }

  try {
    var url    = id ? '/gastos/api/recurrentes/' + id : '/gastos/api/recurrentes';
    var method = id ? 'PUT' : 'POST';
    var r = await fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ descripcion: descripcion, categoria_id: categoria_id, monto_estimado: monto, dia_vencimiento: dia }),
    });
    if (!r.ok) { var d = await r.json(); errEl.textContent = d.error||'Error'; errEl.style.display='block'; return; }
    cerrarModalGasto();
    location.reload();
  } catch(e) { errEl.textContent = 'Error de conexión'; errEl.style.display='block'; }
}

// ── Buscador por período ───────────────────────────────────────
var _buscarDesde = '';
var _buscarHasta  = '';
var _buscarQ      = '';

var fmtB = function(n) { return '$' + Number(n||0).toLocaleString('es-AR', {minimumFractionDigits:2}); };
var fmtFechaB = function(f) { return f ? new Date(f+'T00:00:00').toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'}) : '—'; };

function setFiltroRapido(tipo) {
  var hoy = new Date();
  var pad = function(n) { return String(n).padStart(2,'0'); };
  var ymd = function(d) { return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); };

  document.querySelectorAll('.filtro-rapido').forEach(function(b){ b.classList.remove('activo'); });
  event.target.classList.add('activo');

  var desde, hasta;
  if (tipo === 'mes') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
    hasta  = ymd(new Date(hoy.getFullYear(), hoy.getMonth()+1, 0));
  } else if (tipo === 'mes_ant') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth()-1, 1));
    hasta  = ymd(new Date(hoy.getFullYear(), hoy.getMonth(), 0));
  } else if (tipo === 'trim') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth()-2, 1));
    hasta  = ymd(hoy);
  } else if (tipo === 'anio') {
    desde = hoy.getFullYear() + '-01-01';
    hasta  = ymd(hoy);
  }
  document.getElementById('filtroDesde').value = desde;
  document.getElementById('filtroHasta').value  = hasta;
  buscarGastos();
}

async function buscarGastos() {
  var desde = document.getElementById('filtroDesde').value;
  var hasta  = document.getElementById('filtroHasta').value;
  var q      = document.getElementById('filtroQ').value.trim();

  if (!desde && !hasta && !q) {
    alert('Ingresá al menos una fecha o un término de búsqueda');
    return;
  }

  // Guardar para el imprimir
  _buscarDesde = desde;
  _buscarHasta  = hasta;
  _buscarQ      = q;

  var params = new URLSearchParams();
  if (desde) params.set('desde', desde);
  if (hasta)  params.set('hasta',  hasta);
  if (q)      params.set('q',      q);

  try {
    var r = await fetch('/gastos/api/buscar?' + params.toString());
    var d = await r.json();
    if (!r.ok) { alert(d.error || 'Error'); return; }

    // KPIs
    var kpis = document.getElementById('buscarKpis');
    kpis.style.display = 'grid';
    var pct = d.total > 0 ? Math.round(d.pagado / d.total * 100) : 0;
    var cantPag  = d.gastos.filter(function(g){ return g.pagado; }).length;
    var cantPend = d.gastos.filter(function(g){ return !g.pagado; }).length;

    function kpiDiv(label, valor, color) {
      return '<div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">' +
        '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:' + color + ';margin-bottom:4px;">' + label + '</div>' +
        '<div style="font-size:18px;font-weight:900;color:' + color + ';font-family:var(--font-mono);">' + valor + '</div>' +
        '</div>';
    }
    kpis.innerHTML =
      kpiDiv('Total', fmtB(d.total) + ' (' + d.cantidad + ' gastos)', 'var(--color-primary)') +
      kpiDiv('Pagado', fmtB(d.pagado) + ' (' + cantPag + ')', 'var(--color-success)') +
      kpiDiv('Pendiente', fmtB(d.pendiente) + ' (' + cantPend + ')', 'var(--color-alert)') +
      '<div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">' +
        '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#6366f1;margin-bottom:4px;">% Pagado</div>' +
        '<div style="font-size:18px;font-weight:900;color:#6366f1;font-family:var(--font-mono);">' + pct + '%</div>' +
        '<div style="height:5px;background:var(--bg-surface);border-radius:3px;margin-top:6px;overflow:hidden;">' +
          '<div style="height:100%;width:' + pct + '%;background:#6366f1;border-radius:3px;"></div>' +
        '</div>' +
      '</div>';

    var tituloTxt = d.cantidad + ' gasto' + (d.cantidad!==1?'s':'') + ' encontrados';
    if (desde) tituloTxt += ' · desde ' + fmtFechaB(desde);
    if (hasta)  tituloTxt += ' hasta '  + fmtFechaB(hasta);
    document.getElementById('buscarTitulo').textContent = tituloTxt;

    if (!d.gastos.length) {
      document.getElementById('buscarResultado').style.display = 'none';
      document.getElementById('buscarVacio').style.display    = 'block';
      return;
    }

    document.getElementById('buscarVacio').style.display    = 'none';
    document.getElementById('buscarResultado').style.display = 'block';

    document.getElementById('buscarTbody').innerHTML = d.gastos.map(function(g, i) {
      var cat  = g.categoria || g.rec_cat || '—';
      var desc = g.rec_nombre || g.descripcion || '—';
      var pag  = !!g.pagado;
      var bg   = i % 2 === 0 ? 'var(--bg-surface)' : 'var(--bg-surface-2)';
      var estadoSpan = pag
        ? '<span style="background:rgba(16,185,129,.1);color:var(--color-success);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">&#10003; Pagado</span>'
        : '<span style="background:rgba(245,158,11,.1);color:var(--color-alert);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">Pendiente</span>';
      var montoColor = pag ? 'var(--color-success)' : 'var(--color-danger)';
      return '<tr style="border-bottom:1px solid var(--border-color);background:' + bg + ';">' +
        '<td style="padding:8px 12px;color:var(--text-secondary);font-size:12px;">' + fmtFechaB(g.fecha) + '</td>' +
        '<td style="padding:8px 12px;color:var(--text-primary);font-weight:600;">' + cat + '</td>' +
        '<td style="padding:8px 12px;color:var(--text-primary);">' + desc + '</td>' +
        '<td style="padding:8px 12px;text-align:center;">' + estadoSpan + '</td>' +
        '<td style="padding:8px 12px;text-align:right;font-family:var(--font-mono);font-weight:800;color:' + montoColor + ';">' + fmtB(g.monto) + '</td>' +
        '<td style="padding:8px 12px;text-align:center;color:var(--text-secondary);font-size:12px;">' + (g.metodo_pago||'—') + '</td>' +
        '<td style="padding:8px 12px;text-align:center;color:var(--text-secondary);font-size:12px;">' + fmtFechaB(g.fecha_pago) + '</td>' +
        '</tr>';
    }).join('');

  } catch(e) { alert('Error de conexión'); }
}

// ── Imprimir búsqueda — mismo diseño que gastos fijos ─────────
function imprimirBusqueda() {
  var params = new URLSearchParams();
  if (_buscarDesde) params.set('desde', _buscarDesde);
  if (_buscarHasta)  params.set('hasta',  _buscarHasta);
  if (_buscarQ)      params.set('q',      _buscarQ);
  window.open('/gastos/resumen-busqueda?' + params.toString(), '_blank');
}

// ── Modal Imprimir (gastos fijos del mes) ─────────────────────
function abrirModalImprimir() {
  document.getElementById('imprimirMes').value  = _MES;
  document.getElementById('imprimirAnio').value = _ANIO;
  document.getElementById('modalImprimir').classList.add('open');
}
function cerrarModalImprimir() {
  document.getElementById('modalImprimir').classList.remove('open');
}
function confirmarImprimir() {
  var mes  = document.getElementById('imprimirMes').value;
  var anio = document.getElementById('imprimirAnio').value;
  if (!anio || isNaN(Number(anio))) { alert('Año inválido'); return; }
  cerrarModalImprimir();
  window.open('/gastos/resumen?mes=' + mes + '&anio=' + anio, '_blank');
}

// ── Categorías ─────────────────────────────────────────────────
function abrirModalCategorias() {
  document.getElementById('nuevaCatNombre').value = '';
  document.getElementById('catError').style.display = 'none';
  document.getElementById('modalCategorias').classList.add('open');
  setTimeout(function(){ document.getElementById('nuevaCatNombre').focus(); }, 80);
}
function cerrarModalCategorias() {
  document.getElementById('modalCategorias').classList.remove('open');
}

async function guardarCategoria() {
  var errEl  = document.getElementById('catError');
  errEl.style.display = 'none';
  var nombre = document.getElementById('nuevaCatNombre').value.trim();
  var icono  = document.getElementById('nuevaCatIcono').value;
  var color  = document.getElementById('nuevaCatColor').value;
  if (!nombre) { errEl.textContent = 'El nombre es obligatorio'; errEl.style.display='block'; return; }
  try {
    var r = await fetch('/gastos/api/categorias', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nombre: nombre, icono: icono, color: color }),
    });
    if (!r.ok) { var d = await r.json(); errEl.textContent = d.error||'Error'; errEl.style.display='block'; return; }
    cerrarModalCategorias();
    location.reload();
  } catch(e) { errEl.textContent = 'Error de conexión'; errEl.style.display='block'; }
}

async function eliminarCategoria(id) {
  if (!confirm('¿Eliminar esta categoría? Los gastos que la usen quedarán sin categoría.')) return;
  try {
    var r = await fetch('/gastos/api/categorias/' + id, { method: 'DELETE' });
    if (!r.ok) { alert('Error al eliminar'); return; }
    var row = document.getElementById('cat-row-' + id);
    if (row) row.remove();
  } catch(e) { alert('Error de conexión'); }
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    cerrarModalPago();
    cerrarModalMonto();
    cerrarModalGasto();
    cerrarModalCategorias();
    cerrarModalImprimir();
  }
});
</script>
