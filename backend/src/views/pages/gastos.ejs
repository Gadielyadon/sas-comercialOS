<%- include('../partials/head', { title: 'Gastos' }) %>

<% const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']; %>
<% const fmt = n => '$' + Number(n||0).toLocaleString('es-AR', {minimumFractionDigits:2}); %>
<% const fmtFecha = f => f ? new Date(f+'T00:00:00').toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'}) : '—'; %>

<div class="app-layout">
  <%- include('../partials/sidebar', { active: 'gastos', user }) %>
  <div class="main-content">
    <%- include('../partials/header', { module: 'Gastos', user }) %>

    <div class="page-body">

      <!-- ── Buscador por período ──────────────────────────────── -->
      <div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:12px;padding:16px 20px;margin-bottom:20px;" class="no-print">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-secondary);margin-bottom:12px;display:flex;align-items:center;gap:6px;">
          <i class="bi bi-search"></i> Buscar gastos por período
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:12px;align-items:end;">
          <div>
            <label class="form-lbl">Desde</label>
            <input type="date" id="filtroDesde" class="form-input" style="cursor:pointer;">
          </div>
          <div>
            <label class="form-lbl">Hasta</label>
            <input type="date" id="filtroHasta" class="form-input" style="cursor:pointer;">
          </div>
          <div>
            <label class="form-lbl">Buscar <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional)</span></label>
            <input type="text" id="filtroQ" class="form-input" placeholder="Descripción o categoría..." onkeydown="if(event.key==='Enter')buscarGastos()">
          </div>
          <button onclick="buscarGastos()" style="padding:9px 20px;background:linear-gradient(135deg,var(--color-primary),#4f46e5);color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;gap:6px;white-space:nowrap;height:38px;">
            <i class="bi bi-search"></i> Buscar
          </button>
        </div>
        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
          <span style="font-size:11px;color:var(--text-secondary);font-weight:600;align-self:center;">Acceso rápido:</span>
          <button onclick="setFiltroRapido('mes')"  class="filtro-rapido">Este mes</button>
          <button onclick="setFiltroRapido('mes_ant')" class="filtro-rapido">Mes anterior</button>
          <button onclick="setFiltroRapido('trim')" class="filtro-rapido">Últimos 3 meses</button>
          <button onclick="setFiltroRapido('anio')" class="filtro-rapido">Este año</button>
        </div>
        <!-- Resultados -->
        <div id="buscarKpis" style="display:none;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px;"></div>
        <div id="buscarResultado" style="display:none;border:1px solid var(--border-color);border-radius:10px;overflow:hidden;margin-top:12px;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:var(--bg-surface-2);border-bottom:1px solid var(--border-color);">
            <span style="font-size:13px;font-weight:700;color:var(--text-primary);" id="buscarTitulo">Resultados</span>
            <button onclick="window.print()" style="padding:5px 12px;background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;color:var(--text-secondary);font-family:var(--font-body);display:flex;align-items:center;gap:5px;">
              <i class="bi bi-printer"></i> Imprimir
            </button>
          </div>
          <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px;" id="buscarTabla">
              <thead>
                <tr style="background:var(--bg-surface-2);">
                  <th style="padding:8px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Fecha</th>
                  <th style="padding:8px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Categoría</th>
                  <th style="padding:8px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Descripción</th>
                  <th style="padding:8px 12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Estado</th>
                  <th style="padding:8px 12px;text-align:right;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Monto</th>
                  <th style="padding:8px 12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Forma pago</th>
                  <th style="padding:8px 12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Eliminar</th>
                </tr>
              </thead>
              <tbody id="buscarTbody"></tbody>
            </table>
          </div>
        </div>
        <div id="buscarVacio" style="display:none;text-align:center;padding:24px;color:var(--text-secondary);font-size:13px;">
          <i class="bi bi-search" style="font-size:24px;display:block;margin-bottom:6px;opacity:.4;"></i>
          Sin resultados para ese período
        </div>
      </div>


      <!-- ── Navegación mes ───────────────────────────────────────── -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:22px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <a href="/gastos?mes=<%= mesPrev %>&anio=<%= anioPrev %>"
            style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:8px;border:1.5px solid var(--border-color);color:var(--text-secondary);text-decoration:none;font-size:16px;transition:.15s;"
            onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
            <i class="bi bi-chevron-left"></i>
          </a>
          <div style="text-align:center;">
            <div style="font-size:20px;font-weight:900;color:var(--text-primary);">
              <%= mesNombre %> <%= anio %>
            </div>
            <% if (!esHoy) { %>
            <a href="/gastos" style="font-size:11px;color:var(--color-primary);font-weight:600;text-decoration:none;">Ir al mes actual →</a>
            <% } else { %>
            <div style="font-size:11px;color:var(--text-secondary);">Mes actual</div>
            <% } %>
          </div>
          <a href="/gastos?mes=<%= mesSig %>&anio=<%= anioSig %>"
            style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:8px;border:1.5px solid var(--border-color);color:var(--text-secondary);text-decoration:none;font-size:16px;transition:.15s;"
            onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
            <i class="bi bi-chevron-right"></i>
          </a>
        </div>

        <!-- Acciones -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button onclick="abrirModalImprimir()" class="btn-action btn-action-outline" style="display:flex;align-items:center;gap:6px;">
            <i class="bi bi-printer"></i> Imprimir
          </button>
          <button onclick="abrirModalCategorias()" class="btn-action btn-action-outline" style="display:flex;align-items:center;gap:6px;">
            <i class="bi bi-tags"></i> Categorías
          </button>
          <button onclick="abrirModalGasto()" class="btn-action btn-action-primary" style="display:flex;align-items:center;gap:6px;">
            <i class="bi bi-plus-lg"></i> Nuevo gasto
          </button>
        </div>
      </div>

      <!-- ── KPIs ─────────────────────────────────────────────────── -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:22px;">
        <div class="stat-card" style="border-top:3px solid var(--color-primary);">
          <div class="stat-label">Total del mes</div>
          <div class="stat-value" style="color:var(--color-primary);"><%= fmt(resumen.total) %></div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;"><%= gastosMes.length %> gasto<%= gastosMes.length !== 1 ? 's' : '' %> fijo<%= gastosMes.length !== 1 ? 's' : '' %></div>
        </div>
        <div class="stat-card" style="border-top:3px solid var(--color-success);">
          <div class="stat-label">Pagado</div>
          <div class="stat-value" style="color:var(--color-success);"><%= fmt(resumen.totalPagado) %></div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;"><%= gastosMes.filter(g=>g.pagado).length %> abonado<%= gastosMes.filter(g=>g.pagado).length !== 1 ? 's' : '' %></div>
        </div>
        <div class="stat-card" style="border-top:3px solid var(--color-alert);">
          <div class="stat-label">Pendiente</div>
          <div class="stat-value" style="color:var(--color-alert);"><%= fmt(resumen.totalPendiente) %></div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;"><%= resumen.cantPendiente %> sin pagar</div>
        </div>
        <!-- Barra de progreso -->
        <div class="stat-card" style="border-top:3px solid #6366f1;">
          <div class="stat-label">Progreso del mes</div>
          <% const pct = resumen.total > 0 ? Math.round(resumen.totalPagado / resumen.total * 100) : 0; %>
          <div style="font-size:18px;font-weight:900;color:#6366f1;margin:4px 0;"><%= pct %>%</div>
          <div style="height:6px;background:var(--bg-surface-2);border-radius:4px;overflow:hidden;margin-top:4px;">
            <div style="height:100%;width:<%= pct %>%;background:<%= pct===100?'var(--color-success)':'#6366f1' %>;border-radius:4px;transition:width .4s;"></div>
          </div>
        </div>
      </div>

      <!-- ── Gastos agrupados por categoría ───────────────────────── -->
      <% if (!gastosMes.length) { %>
      <div class="ax-empty">
        <i class="bi bi-receipt ax-empty-icon"></i>
        <div class="ax-empty-title">Sin gastos fijos configurados</div>
        <div class="ax-empty-sub">Agregá tus gastos fijos y se van a regenerar solos cada mes</div>
        <button onclick="abrirModalGasto()" class="btn-action btn-action-primary" style="margin-top:14px;">
          <i class="bi bi-plus-lg"></i> Agregar primer gasto
        </button>
      </div>
      <% } else { %>
      <% const grupos = {}; %>
      <% for (const g of gastosMes) { const cat = g.categoria_nombre || 'Otros'; if (!grupos[cat]) grupos[cat] = []; grupos[cat].push(g); } %>
      <% for (const [cat, items] of Object.entries(grupos).sort()) { %>
      <%
        const totalCat   = items.reduce((s, i) => s + Number(i.gasto_monto), 0);
        const pagadoCat  = items.filter(i=>i.pagado).reduce((s, i) => s + Number(i.gasto_monto), 0);
        const todosPagados = items.every(i => i.pagado);
        const algunoPend   = items.some(i => !i.pagado);
      %>
      <div class="card" style="margin-bottom:14px;overflow:hidden;">
        <!-- Cabecera de categoría -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;background:var(--bg-surface-2);border-bottom:1px solid var(--border-color);">
          <div style="display:flex;align-items:center;gap:8px;">
            <i class="bi bi-<%= items[0].cat_icono || 'tag' %>" style="color:<%= items[0].cat_color || 'var(--color-primary)' %>;font-size:15px;"></i>
            <span style="font-weight:800;font-size:14px;color:var(--text-primary);"><%= cat %></span>
            <span style="font-size:11px;color:var(--text-secondary);">(<%= items.length %> gasto<%= items.length!==1?'s':'' %>)</span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;">
            <% if (todosPagados) { %>
            <span style="background:rgba(16,185,129,.15);color:var(--color-success);font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;display:flex;align-items:center;gap:4px;">
              <i class="bi bi-check-circle-fill"></i> Todo pagado
            </span>
            <% } else if (algunoPend) { %>
            <span style="background:rgba(245,158,11,.15);color:var(--color-alert);font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;display:flex;align-items:center;gap:4px;">
              <i class="bi bi-clock"></i> Con pendientes
            </span>
            <% } %>
            <span style="font-size:15px;font-weight:900;color:var(--text-primary);font-family:var(--font-mono);"><%= fmt(totalCat) %></span>
          </div>
        </div>

        <!-- Ítems de la categoría -->
        <% for (const g of items) { %>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 18px;border-bottom:1px solid var(--border-color);gap:12px;flex-wrap:wrap;background:var(--bg-surface);"
             id="fila-<%= g.id %>">

          <!-- Info del gasto -->
          <div style="flex:1;min-width:180px;">
            <div style="font-weight:700;font-size:13.5px;color:var(--text-primary);">
              <%= g.descripcion %>
              <% if (g.tipo === 'extraordinario') { %>
              <span style="background:rgba(99,102,241,.12);color:#6366f1;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;margin-left:5px;">Extraordinario</span>
              <% } %>
              <% if (g.cuotas_total) { %>
              <span style="background:rgba(245,158,11,.12);color:#d97706;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;margin-left:5px;">Cuota <%= g.cuota_actual || '?' %>/<%= g.cuotas_total %></span>
              <% } %>
              <% if (g.tiene_arrastre) { %>
              <a href="/gastos?mes=<%= g.mes_arrastre %>&anio=<%= g.anio_arrastre %>"
                title="Ver el mes donde quedó pendiente"
                style="background:rgba(239,68,68,.15);color:var(--color-danger);font-size:10px;font-weight:800;padding:1px 7px;border-radius:10px;margin-left:6px;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;gap:3px;transition:.15s;"
                onmouseover="this.style.background='rgba(239,68,68,.28)'" onmouseout="this.style.background='rgba(239,68,68,.15)'">
                <i class="bi bi-arrow-up-circle-fill" style="font-size:9px;"></i> Arrastre <%= fmt(g.monto_arrastre) %> →
              </a>
              <% } %>
            </div>
            <% if (g.notas) { %>
            <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;font-style:italic;"><i class="bi bi-sticky" style="font-size:10px;"></i> <%= g.notas %></div>
            <% } %>
            <% if (g.pagado && g.fecha_pago) { %>
            <div style="font-size:11px;color:var(--color-success);margin-top:2px;">
              ✓ Pagado el <%= fmtFecha(g.fecha_pago) %><%= g.metodo_pago ? ' · ' + g.metodo_pago : '' %>
            </div>
            <% } else if (!g.pagado) { %>
            <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;">Vence día <%= g.dia_vencimiento %></div>
            <% } %>
          </div>

          <!-- Monto -->
          <div style="font-family:var(--font-mono);font-size:15px;font-weight:900;color:var(--text-primary);min-width:110px;text-align:right;">
            <%= fmt(g.gasto_monto) %>
            <% if (g.tiene_arrastre) { %>
            <div style="font-size:10px;font-weight:500;color:var(--text-muted);">Base: <%= fmt(g.monto_base) %></div>
            <% } %>
          </div>

          <!-- Botones de estado -->
          <div style="display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;">
            <% if (!g.pagado) { %>
              <% if (g.tiene_arrastre) { %>
              <!-- Con arrastre: dos opciones claras -->
              <div style="display:flex;flex-direction:column;gap:5px;align-items:flex-end;">
                <button onclick="marcarPagado(<%= g.id %>, <%= mes %>, <%= anio %>, true)"
                  style="padding:7px 13px;background:rgba(16,185,129,.12);color:var(--color-success);border:1.5px solid rgba(16,185,129,.25);border-radius:8px;font-size:11.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:5px;font-family:var(--font-body);white-space:nowrap;">
                  <i class="bi bi-check-circle-fill"></i> Pagar todo (<%= fmt(g.gasto_monto) %>)
                </button>
                <button onclick="abrirPagosGasto(<%= g.gasto_id %>, '<%= (g.descripcion||'').replace(/'/g,'') %>')"
                  style="padding:5px 13px;background:var(--bg-surface-2);color:var(--text-secondary);border:1.5px solid var(--border-color);border-radius:8px;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;font-family:var(--font-body);white-space:nowrap;">
                  <i class="bi bi-cash-stack"></i> Registrar pago parcial
                </button>
              </div>
              <% } else { %>
              <!-- Sin arrastre: botón de pagos parciales -->
              <button onclick="abrirPagosGasto(<%= g.gasto_id %>, '<%= (g.descripcion||'').replace(/'/g,'') %>')"
                style="padding:7px 14px;background:rgba(16,185,129,.12);color:var(--color-success);border:1.5px solid rgba(16,185,129,.25);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:5px;font-family:var(--font-body);">
                <i class="bi bi-cash-stack"></i> Registrar pago
              </button>
              <% } %>
              <button onclick="abrirModalGastoDesdeBtn(this)"
                data-rec="<%- JSON.stringify({id:g.id,descripcion:g.descripcion,categoria_id:g.categoria_id,monto_estimado:g.monto_estimado,dia_vencimiento:g.dia_vencimiento,tipo:g.tipo||'fijo',cuotas_total:g.cuotas_total||null,fecha_fin:g.fecha_fin||null,notas:g.notas||null}).replace(/"/g,'&quot;') %>"
                style="padding:7px 10px;background:var(--bg-surface-2);color:var(--text-secondary);border:1.5px solid var(--border-color);border-radius:8px;font-size:12px;cursor:pointer;font-family:var(--font-body);transition:.15s;"
                title="Editar gasto"
                onmouseover="this.style.borderColor='var(--color-primary)';this.style.color='var(--color-primary)'"
                onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)'">
                <i class="bi bi-pencil"></i>
              </button>
              <button onclick="eliminarGastoFijo(<%= g.id %>, '<%= (g.descripcion||'').replace(/'/g,'') %>')"
                style="padding:7px 10px;background:var(--bg-surface-2);color:var(--text-muted);border:1.5px solid var(--border-color);border-radius:8px;font-size:12px;cursor:pointer;font-family:var(--font-body);transition:.15s;"
                title="Eliminar este gasto fijo"
                onmouseover="this.style.color='var(--color-danger)';this.style.borderColor='rgba(239,68,68,.3)'"
                onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border-color)'">
                <i class="bi bi-trash3"></i>
              </button>
            <% } else { %>
            <!-- Pagado: checkbox discreto + opción de deshacer pequeña -->
            <div style="display:flex;align-items:center;gap:10px;">
              <label onclick="marcarPendiente(<%= g.id %>, <%= mes %>, <%= anio %>)"
                style="display:flex;align-items:center;gap:7px;cursor:pointer;padding:6px 12px;border-radius:8px;border:1.5px solid rgba(16,185,129,.25);background:rgba(16,185,129,.08);transition:.15s;"
                title="Hacer clic para marcar como pendiente"
                onmouseover="this.style.background='rgba(16,185,129,.18)'" onmouseout="this.style.background='rgba(16,185,129,.08)'">
                <span style="width:18px;height:18px;border-radius:5px;background:var(--color-success);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <i class="bi bi-check" style="color:#fff;font-size:12px;font-weight:900;"></i>
                </span>
                <span style="font-size:12px;font-weight:700;color:var(--color-success);">Pagado</span>
              </label>
              <button onclick="abrirModalGastoDesdeBtn(this)"
                data-rec="<%- JSON.stringify({id:g.id,descripcion:g.descripcion,categoria_id:g.categoria_id,monto_estimado:g.monto_estimado,dia_vencimiento:g.dia_vencimiento,tipo:g.tipo||'fijo',cuotas_total:g.cuotas_total||null,fecha_fin:g.fecha_fin||null,notas:g.notas||null}).replace(/"/g,'&quot;') %>"
                style="padding:6px 9px;background:var(--bg-surface-2);color:var(--text-muted);border:1.5px solid var(--border-color);border-radius:8px;font-size:12px;cursor:pointer;font-family:var(--font-body);transition:.15s;"
                title="Editar gasto"
                onmouseover="this.style.borderColor='var(--color-primary)';this.style.color='var(--color-primary)'"
                onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-muted)'">
                <i class="bi bi-pencil"></i>
              </button>
              <button onclick="eliminarGastoFijo(<%= g.id %>, '<%= (g.descripcion||'').replace(/'/g,'') %>')"
                style="padding:6px 9px;background:var(--bg-surface-2);color:var(--text-muted);border:1.5px solid var(--border-color);border-radius:8px;font-size:12px;cursor:pointer;font-family:var(--font-body);transition:.15s;"
                title="Eliminar este gasto fijo"
                onmouseover="this.style.color='var(--color-danger)';this.style.borderColor='rgba(239,68,68,.3)'"
                onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border-color)'">
                <i class="bi bi-trash3"></i>
              </button>
            </div>
            <% } %>
          </div>

        </div>
        <% } %>
      </div>
      <% } %>
      <% } %>

      <!-- ── Gastos históricos (variables sin recurrente) ──────── -->
      <% if (typeof gastosHistoricos !== 'undefined' && gastosHistoricos && gastosHistoricos.length > 0) { %>
      <div style="margin-top:28px;" class="no-print">

        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <div style="height:1px;flex:1;background:var(--border-color);"></div>
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-secondary);display:flex;align-items:center;gap:6px;">
            <i class="bi bi-clock-history"></i> Gastos variables cargados
            <span style="font-size:10px;font-weight:400;color:var(--text-secondary);">(<%= gastosHistoricos.length %>)</span>
          </span>
          <div style="height:1px;flex:1;background:var(--border-color);"></div>
        </div>

        <% const totalHist = gastosHistoricos.reduce((s,g) => s + Number(g.monto), 0); %>
        <% const pagadosHist = gastosHistoricos.filter(g => g.pagado).reduce((s,g) => s + Number(g.monto), 0); %>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;">
          <div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);margin-bottom:4px;">Total</div>
            <div style="font-size:17px;font-weight:900;color:var(--text-primary);font-family:var(--font-mono);">$<%= totalHist.toLocaleString('es-AR',{minimumFractionDigits:2}) %></div>
          </div>
          <div style="background:var(--bg-surface-2);border:1px solid rgba(16,185,129,.2);border-radius:10px;padding:12px 14px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--color-success);margin-bottom:4px;">Pagado</div>
            <div style="font-size:17px;font-weight:900;color:var(--color-success);font-family:var(--font-mono);">$<%= pagadosHist.toLocaleString('es-AR',{minimumFractionDigits:2}) %></div>
          </div>
          <div style="background:var(--bg-surface-2);border:1px solid rgba(245,158,11,.2);border-radius:10px;padding:12px 14px;">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--color-alert);margin-bottom:4px;">Pendiente</div>
            <div style="font-size:17px;font-weight:900;color:var(--color-alert);font-family:var(--font-mono);">$<%= (totalHist - pagadosHist).toLocaleString('es-AR',{minimumFractionDigits:2}) %></div>
          </div>
        </div>

        <div style="border:1px solid var(--border-color);border-radius:10px;overflow:hidden;">
          <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
            <thead>
              <tr style="background:var(--bg-surface-2);">
                <th style="padding:8px 14px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Fecha</th>
                <th style="padding:8px 14px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Categoría</th>
                <th style="padding:8px 14px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Descripción</th>
                <th style="padding:8px 14px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Estado</th>
                <th style="padding:8px 14px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Método</th>
                <th style="padding:8px 14px;text-align:right;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Monto</th>
                <th style="padding:8px 14px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);">Eliminar</th>
              </tr>
            </thead>
            <tbody>
              <% for (let i = 0; i < gastosHistoricos.length; i++) { %>
              <% const g = gastosHistoricos[i]; %>
              <tr style="border-bottom:1px solid var(--border-color);background:<%= i%2===0 ? 'var(--bg-surface)' : 'var(--bg-surface-2)' %>;">
                <td style="padding:8px 14px;color:var(--text-secondary);font-size:12px;white-space:nowrap;">
                  <%= new Date(g.fecha + 'T00:00:00').toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'}) %>
                </td>
                <td style="padding:8px 14px;font-weight:600;color:var(--text-primary);"><%= g.categoria || '—' %></td>
                <td style="padding:8px 14px;color:var(--text-primary);"><%= g.descripcion || '—' %></td>
                <td style="padding:8px 14px;text-align:center;">
                  <% if (g.pagado) { %>
                  <span style="background:rgba(16,185,129,.1);color:var(--color-success);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">✓ Pagado</span>
                  <% } else { %>
                  <span style="background:rgba(245,158,11,.1);color:var(--color-alert);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">Pendiente</span>
                  <% } %>
                </td>
                <td style="padding:8px 14px;text-align:center;color:var(--text-secondary);font-size:12px;"><%= g.metodo_pago || '—' %></td>
                <td style="padding:8px 14px;text-align:right;font-family:var(--font-mono);font-weight:800;color:<%= g.pagado ? 'var(--color-success)' : 'var(--color-danger)' %>;">
                  $<%= Number(g.monto).toLocaleString('es-AR',{minimumFractionDigits:2}) %>
                </td>
                <td style="padding:8px 14px;text-align:center;">
                  <button onclick="eliminarGastoFijo(<%= g.id %>, '<%= (g.descripcion||'').replace(/'/g,'') %>')"
                    style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:14px;padding:3px 6px;border-radius:5px;transition:.15s;"
                    title="Eliminar"
                    onmouseover="this.style.color='var(--color-danger)'" onmouseout="this.style.color='var(--text-secondary)'">
                    <i class="bi bi-trash3"></i>
                  </button>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
      <% } %>

    </div><!-- /page-body -->
    <%- include('../partials/footer') %>
  </div>
</div>

<!-- MODAL: Selector de mes para imprimir -->
<div class="sale-overlay" id="modalImprimir" onclick="if(event.target.id==='modalImprimir')cerrarModalImprimir()">
  <div class="sale-modal" style="max-width:420px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--color-primary),#4f46e5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;">
          <i class="bi bi-printer-fill"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:800;color:var(--text-primary);">Imprimir resumen</div>
          <div style="font-size:11px;color:var(--text-secondary);">Seleccioná el mes a imprimir</div>
        </div>
      </div>
      <button onclick="cerrarModalImprimir()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
      <div>
        <label class="form-lbl">Mes</label>
        <select id="imprimirMes" class="form-input" style="cursor:pointer;">
          <option value="1">Enero</option>
          <option value="2">Febrero</option>
          <option value="3">Marzo</option>
          <option value="4">Abril</option>
          <option value="5">Mayo</option>
          <option value="6">Junio</option>
          <option value="7">Julio</option>
          <option value="8">Agosto</option>
          <option value="9">Septiembre</option>
          <option value="10">Octubre</option>
          <option value="11">Noviembre</option>
          <option value="12">Diciembre</option>
        </select>
      </div>
      <div>
        <label class="form-lbl">Año</label>
        <input type="number" id="imprimirAnio" class="form-input" min="2020" max="2099" value="<%= anio %>">
      </div>
    </div>

    <!-- Preview rápido de qué va a mostrar -->
    <div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:var(--radius-sm);padding:14px;margin-bottom:20px;">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);margin-bottom:10px;">El resumen incluye:</div>
      <div style="display:flex;flex-direction:column;gap:7px;">
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--text-primary);">
          <i class="bi bi-check-circle-fill" style="color:var(--color-success);"></i>
          <span><strong>Sección 1 — Pagado:</strong> todos los gastos abonados con fecha, método y monto real</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--text-primary);">
          <i class="bi bi-clock-fill" style="color:var(--color-alert);"></i>
          <span><strong>Sección 2 — Pendiente:</strong> lo que quedó sin pagar, incluyendo arrastres</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--text-primary);">
          <i class="bi bi-bar-chart-fill" style="color:var(--color-primary);"></i>
          <span><strong>Resumen ejecutivo:</strong> totales, porcentaje pagado y distribución por categoría</span>
        </div>
      </div>
    </div>

    <button onclick="confirmarImprimir()"
      style="width:100%;padding:12px;background:linear-gradient(135deg,var(--color-primary),#4f46e5);color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);">
      <i class="bi bi-printer-fill"></i> Abrir resumen
    </button>
  </div>
</div>

<!-- MODAL: Gestionar categorías -->
<div class="sale-overlay" id="modalCategorias" onclick="if(event.target.id==='modalCategorias')cerrarModalCategorias()">
  <div class="sale-modal" style="max-width:520px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div style="font-size:16px;font-weight:800;color:var(--text-primary);">Gestionar categorías</div>
      <button onclick="cerrarModalCategorias()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>

    <!-- Lista de categorías existentes -->
    <div id="listaCategorias" style="max-height:260px;overflow-y:auto;margin-bottom:16px;border:1px solid var(--border-color);border-radius:var(--radius-sm);">
      <% if (!categorias.length) { %>
      <div style="padding:20px;text-align:center;color:var(--text-secondary);font-size:13px;">Sin categorías. Agregá la primera.</div>
      <% } else { %>
      <% for (const cat of categorias) { %>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border-color);background:var(--bg-surface);"
           id="cat-row-<%= cat.id %>">
        <div style="display:flex;align-items:center;gap:10px;">
          <div style="width:10px;height:10px;border-radius:50%;background:<%= cat.color || '#6b7280' %>;flex-shrink:0;"></div>
          <i class="bi bi-<%= cat.icono || 'tag' %>" style="color:<%= cat.color || 'var(--text-secondary)' %>;font-size:14px;"></i>
          <span style="font-size:13px;font-weight:600;color:var(--text-primary);"><%= cat.nombre %></span>
        </div>
        <button onclick="eliminarCategoria(<%= cat.id %>)"
          style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:15px;padding:3px 6px;border-radius:6px;transition:.15s;"
          title="Eliminar categoría"
          onmouseover="this.style.color='var(--color-danger)'" onmouseout="this.style.color='var(--text-muted)'">
          <i class="bi bi-trash"></i>
        </button>
      </div>
      <% } %>
      <% } %>
    </div>

    <!-- Formulario nueva categoría -->
    <div style="border:1px solid var(--border-color);border-radius:var(--radius-sm);padding:14px;background:var(--bg-surface-2);">
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);margin-bottom:12px;">Nueva categoría</div>
      <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
        <div>
          <label class="form-lbl">Nombre</label>
          <input type="text" id="nuevaCatNombre" class="form-input" placeholder="Ej: Servicios, Empleados…">
        </div>
        <div>
          <label class="form-lbl">Icono</label>
          <select id="nuevaCatIcono" class="form-input" style="cursor:pointer;min-width:130px;">
            <option value="tag">🏷️ Etiqueta</option>
            <option value="lightning-charge">⚡ Servicios</option>
            <option value="people">👥 Empleados</option>
            <option value="house">🏠 Local</option>
            <option value="truck">🚚 Logística</option>
            <option value="cart">🛒 Compras</option>
            <option value="telephone">📞 Comunicación</option>
            <option value="shield-check">🛡️ Seguros</option>
            <option value="cash">💵 Impuestos</option>
            <option value="tools">🔧 Mantenimiento</option>
          </select>
        </div>
        <div>
          <label class="form-lbl">Color</label>
          <input type="color" id="nuevaCatColor" value="#6366f1"
            style="width:42px;height:38px;border:1.5px solid var(--border-color);border-radius:var(--radius-xs);cursor:pointer;padding:2px;background:var(--bg-surface);">
        </div>
      </div>
      <div id="catError" style="display:none;margin-top:8px;font-size:12px;color:var(--color-danger);"></div>
      <button onclick="guardarCategoria()"
        style="margin-top:12px;width:100%;padding:10px;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dark,#1a42c0));color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
        <i class="bi bi-plus-lg"></i> Agregar categoría
      </button>
    </div>
  </div>
</div>

<!-- MODAL: Marcar pagado (fecha + método) -->
<div class="sale-overlay" id="modalPago" onclick="if(event.target.id==='modalPago')cerrarModalPago()">
  <div class="sale-modal" style="max-width:400px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div style="font-size:16px;font-weight:800;color:var(--text-primary);">Registrar pago</div>
      <button onclick="cerrarModalPago()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>
    <input type="hidden" id="pagoGastoId">
    <input type="hidden" id="pagoMes">
    <input type="hidden" id="pagoAnio">
    <input type="hidden" id="pagoTodo">
    <!-- Indicador de qué se está pagando -->
    <div id="pagoTodoAviso" style="display:none;padding:10px 14px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);border-radius:8px;margin-bottom:14px;font-size:12.5px;color:var(--color-success);">
      <i class="bi bi-check-circle-fill"></i> <strong>Pagar todo</strong> — se va a cancelar el mes actual y el arrastre pendiente del mes anterior.
    </div>
    <div id="pagoSoloMesAviso" style="display:none;padding:10px 14px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.25);border-radius:8px;margin-bottom:14px;font-size:12.5px;color:#6366f1;">
      <i class="bi bi-info-circle-fill"></i> <strong>Solo este mes</strong> — el arrastre del mes anterior seguirá pendiente y se trasladará al mes que viene.
    </div>
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div>
        <label class="form-lbl">Fecha de pago</label>
        <input type="date" id="pagoFecha" class="form-input">
      </div>
      <div>
        <label class="form-lbl">Forma de pago <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional)</span></label>
        <select id="pagoMetodo" class="form-input" style="cursor:pointer;">
          <option value="">— Sin especificar —</option>
          <option value="Efectivo">Efectivo</option>
          <option value="Transferencia">Transferencia</option>
          <option value="Tarjeta débito">Tarjeta débito</option>
          <option value="Tarjeta crédito">Tarjeta crédito</option>
          <option value="Cheque">Cheque</option>
        </select>
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:20px;">
      <button onclick="confirmarPago()"
        style="flex:1;padding:11px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
        <i class="bi bi-check-circle-fill"></i> Confirmar pago
      </button>
      <button onclick="cerrarModalPago()" class="btn-action btn-action-outline" style="padding:11px 16px;">Cancelar</button>
    </div>
  </div>
</div>

<!-- MODAL: Editar monto -->
<div class="sale-overlay" id="modalMonto" onclick="if(event.target.id==='modalMonto')cerrarModalMonto()">
  <div class="sale-modal" style="max-width:360px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div style="font-size:16px;font-weight:800;color:var(--text-primary);">Ajustar monto</div>
      <button onclick="cerrarModalMonto()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>
    <input type="hidden" id="montoGastoId">
    <input type="hidden" id="montoMes">
    <input type="hidden" id="montoAnio">
    <div>
      <label class="form-lbl">Monto real de este mes</label>
      <input type="number" id="montoValor" class="form-input" min="0" step="0.01" placeholder="0.00">
      <div style="font-size:11px;color:var(--text-secondary);margin-top:4px;">Solo modifica este mes. El estimado original no cambia.</div>
    </div>
    <div style="display:flex;gap:8px;margin-top:20px;">
      <button onclick="confirmarMonto()"
        style="flex:1;padding:11px;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dark,#1a42c0));color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
        Guardar
      </button>
      <button onclick="cerrarModalMonto()" class="btn-action btn-action-outline" style="padding:11px 16px;">Cancelar</button>
    </div>
  </div>
</div>

<!-- MODAL: Nuevo / editar gasto fijo -->
<div class="sale-overlay" id="modalGasto" onclick="if(event.target.id==='modalGasto')cerrarModalGasto()">
  <div class="sale-modal" style="max-width:520px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div style="font-size:16px;font-weight:800;color:var(--text-primary);" id="modalGastoTitulo">Nuevo gasto fijo</div>
      <button onclick="cerrarModalGasto()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>
    <input type="hidden" id="gasto_edit_id">
    <div style="display:flex;flex-direction:column;gap:14px;">

      <!-- Tipo de gasto -->
      <div>
        <label class="form-lbl">Tipo de gasto</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;" id="tipoGastoSelector">
          <button type="button" id="btnTipoFijo" onclick="setTipoGasto('fijo')"
            style="padding:10px;border-radius:8px;border:2px solid var(--color-primary);background:rgba(27,79,216,.1);color:var(--color-primary);font-size:12px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:6px;">
            <i class="bi bi-arrow-repeat"></i> Mensual fijo
          </button>
          <button type="button" id="btnTipoExtraordinario" onclick="setTipoGasto('extraordinario')"
            style="padding:10px;border-radius:8px;border:2px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-secondary);font-size:12px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:6px;">
            <i class="bi bi-lightning-charge"></i> Extraordinario
          </button>
        </div>
        <div id="tipoHint" style="font-size:11px;color:var(--text-secondary);margin-top:5px;">Se genera todos los meses automáticamente.</div>
      </div>

      <!-- Nombre y categoría -->
      <div>
        <label class="form-lbl">Nombre del gasto *</label>
        <input type="text" id="g_descripcion" class="form-input" placeholder="Ej: Luz, Alquiler, Cuota préstamo…">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="form-lbl">Categoría</label>
          <select id="g_categoria_id" class="form-input" style="cursor:pointer;">
            <option value="">— Sin categoría —</option>
            <% for (const cat of categorias) { %>
            <option value="<%= cat.id %>"><%= cat.nombre %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label class="form-lbl">Monto estimado *</label>
          <input type="number" id="g_monto" class="form-input" min="0" step="0.01" placeholder="0.00">
        </div>
      </div>

      <!-- Día de vencimiento (oculto para extraordinario) -->
      <div id="g_dia_wrap">
        <label class="form-lbl">Día de vencimiento <span style="font-weight:400;text-transform:none;font-size:10px;">(1-31)</span></label>
        <input type="number" id="g_dia" class="form-input" min="1" max="31" value="1">
        <div style="font-size:11px;color:var(--text-secondary);margin-top:3px;">El sistema lo ajusta si el mes tiene menos días.</div>
      </div>

      <!-- Cuotas / Fecha de corte (solo para tipo fijo) -->
      <div id="g_limite_wrap">
        <label class="form-lbl">Límite <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional — dejá vacío si es indefinido)</span></label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div>
            <label style="font-size:10.5px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">Cantidad de cuotas</label>
            <input type="number" id="g_cuotas" class="form-input" min="1" placeholder="Ej: 12" style="font-size:13px;">
            <div style="font-size:10px;color:var(--text-secondary);margin-top:2px;">Ej: préstamo en 12 cuotas</div>
          </div>
          <div>
            <label style="font-size:10.5px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">O fecha de corte</label>
            <input type="month" id="g_fecha_fin" class="form-input" style="font-size:13px;">
            <div style="font-size:10px;color:var(--text-secondary);margin-top:2px;">Ej: Diciembre 2026</div>
          </div>
        </div>
      </div>

      <!-- Nota general -->
      <div>
        <label class="form-lbl">Nota <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional)</span></label>
        <textarea id="g_notas" class="form-input" rows="2" placeholder="Ej: Cuota del préstamo HSBC, Plan de pagos…" style="resize:vertical;min-height:58px;"></textarea>
      </div>

    </div>
    <div style="display:flex;gap:8px;margin-top:20px;">
      <button onclick="guardarGasto()"
        style="flex:1;padding:11px;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dark,#1a42c0));color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
        Guardar
      </button>
      <button onclick="cerrarModalGasto()" class="btn-action btn-action-outline" style="padding:11px 16px;">Cancelar</button>
    </div>
    <div id="gastoError" style="display:none;margin-top:10px;padding:9px 12px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);border-radius:8px;font-size:13px;color:#dc2626;"></div>
  </div>
</div>

<%- include('../partials/scripts') %>

<!-- MODAL: Pagos parciales del gasto mensual -->
<div class="sale-overlay" id="modalPagosGasto" onclick="if(event.target.id==='modalPagosGasto')cerrarPagosGasto()">
  <div class="sale-modal" style="max-width:500px;text-align:left;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#10b981,#059669);display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px;">
          <i class="bi bi-cash-stack"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:800;color:var(--text-primary);">Pagos del gasto</div>
          <div style="font-size:11px;color:var(--text-secondary);" id="pgNombre">—</div>
        </div>
      </div>
      <button onclick="cerrarPagosGasto()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:20px;"><i class="bi bi-x-lg"></i></button>
    </div>

    <!-- KPIs -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;">
      <div style="background:rgba(27,79,216,.07);border:1px solid rgba(27,79,216,.18);border-radius:8px;padding:9px 12px;">
        <div style="font-size:9px;font-weight:700;text-transform:uppercase;color:var(--color-primary);margin-bottom:3px;">Total</div>
        <div style="font-size:15px;font-weight:900;color:var(--color-primary);font-family:var(--font-mono);" id="pgTotal">—</div>
      </div>
      <div style="background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.18);border-radius:8px;padding:9px 12px;">
        <div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#059669;margin-bottom:3px;">Pagado</div>
        <div style="font-size:15px;font-weight:900;color:#059669;font-family:var(--font-mono);" id="pgPagado">—</div>
      </div>
      <div style="background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.18);border-radius:8px;padding:9px 12px;">
        <div style="font-size:9px;font-weight:700;text-transform:uppercase;color:#d97706;margin-bottom:3px;">Pendiente</div>
        <div style="font-size:15px;font-weight:900;color:#d97706;font-family:var(--font-mono);" id="pgPendiente">—</div>
      </div>
    </div>

    <!-- Historial de pagos -->
    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-secondary);margin-bottom:6px;">Historial de pagos</div>
    <div id="pgHistorial" style="display:flex;flex-direction:column;gap:5px;margin-bottom:14px;max-height:180px;overflow-y:auto;">
      <div style="text-align:center;color:var(--text-secondary);font-size:12px;padding:10px;">Cargando…</div>
    </div>

    <!-- Formulario nuevo pago -->
    <div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">
      <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--text-secondary);margin-bottom:10px;">Registrar nuevo pago</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
        <div>
          <label class="form-lbl">Monto</label>
          <div style="display:flex;gap:5px;">
            <input type="number" id="pgMonto" class="form-input" min="0" step="0.01" placeholder="0,00" style="flex:1;">
            <button onclick="pgTodo()" style="padding:7px 10px;background:rgba(16,185,129,.1);color:#059669;border:1.5px solid rgba(16,185,129,.3);border-radius:var(--radius-sm);font-size:11px;font-weight:700;cursor:pointer;font-family:var(--font-body);">Todo</button>
          </div>
        </div>
        <div>
          <label class="form-lbl">Fecha</label>
          <input type="date" id="pgFecha" class="form-input">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
        <div>
          <label class="form-lbl">Forma de pago <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional)</span></label>
          <select id="pgMetodo" class="form-input" style="cursor:pointer;">
            <option value="">— Sin especificar —</option>
            <option value="Efectivo">Efectivo</option>
            <option value="Transferencia">Transferencia</option>
            <option value="Tarjeta débito">Tarjeta débito</option>
            <option value="Tarjeta crédito">Tarjeta crédito</option>
            <option value="Cheque">Cheque</option>
            <option value="Mercado Pago">Mercado Pago</option>
          </select>
        </div>
        <div>
          <label class="form-lbl">Nota <span style="font-weight:400;text-transform:none;font-size:10px;">(opcional)</span></label>
          <input type="text" id="pgNota" class="form-input" placeholder="Ej: de cuenta HSBC…">
        </div>
      </div>
      <div id="pgError" style="display:none;font-size:12px;color:#dc2626;margin-bottom:8px;"></div>
      <button onclick="pgConfirmar()"
        style="width:100%;padding:10px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:6px;">
        <i class="bi bi-check-circle-fill"></i> Confirmar pago
      </button>
    </div>
  </div>
</div>
<script>
const _MES  = <%= mes %>;
const _ANIO = <%= anio %>;

// ── Marcar pagado ──────────────────────────────────────────────
function marcarPagado(gastoId, mes, anio, pagarTodo) {
  document.getElementById('pagoGastoId').value = gastoId;
  document.getElementById('pagoMes').value     = mes;
  document.getElementById('pagoAnio').value    = anio;
  document.getElementById('pagoTodo').value    = pagarTodo ? '1' : '0';
  document.getElementById('pagoFecha').value   = new Date().toISOString().split('T')[0];
  document.getElementById('pagoMetodo').value  = '';
  // Mostrar el aviso correcto
  document.getElementById('pagoTodoAviso').style.display    = pagarTodo ? 'block' : 'none';
  document.getElementById('pagoSoloMesAviso').style.display = pagarTodo ? 'none' : 'none'; // solo mostrar si hay arrastre y eligió solo mes
  if (!pagarTodo && gastoId) {
    // Verificar si este gasto tiene arrastre revisando si se pasó false explícitamente
    // Solo mostrar aviso "solo este mes" si pagarTodo === false (no undefined)
    if (pagarTodo === false) {
      document.getElementById('pagoSoloMesAviso').style.display = 'block';
    }
  }
  document.getElementById('modalPago').classList.add('open');
  setTimeout(() => document.getElementById('pagoFecha').focus(), 80);
}
function cerrarModalPago() { document.getElementById('modalPago').classList.remove('open'); }

async function confirmarPago() {
  const id       = document.getElementById('pagoGastoId').value;
  const mes      = document.getElementById('pagoMes').value;
  const anio     = document.getElementById('pagoAnio').value;
  const fecha    = document.getElementById('pagoFecha').value;
  const metodo   = document.getElementById('pagoMetodo').value;
  const pagarTodo= document.getElementById('pagoTodo').value === '1';
  try {
    const r = await fetch(`/gastos/api/recurrentes/${id}/pagar`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        mes: Number(mes), anio: Number(anio),
        pagado: true,
        fecha_pago: fecha,
        metodo_pago: metodo || null,
        pagar_todo: pagarTodo,   // ← el service decide si cierra el mes anterior
      }),
    });
    if (!r.ok) { const d = await r.json(); alert(d.error || 'Error'); return; }
    cerrarModalPago();
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Marcar pendiente ───────────────────────────────────────────
async function marcarPendiente(gastoId, mes, anio) {
  if (!confirm('¿Marcar como pendiente?')) return;
  try {
    const r = await fetch(`/gastos/api/recurrentes/${gastoId}/pagar`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mes, anio, pagado: false }),
    });
    if (!r.ok) { const d = await r.json(); alert(d.error || 'Error'); return; }
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Editar monto ───────────────────────────────────────────────
function editarMonto(gastoId, montoActual, mes, anio) {
  document.getElementById('montoGastoId').value = gastoId;
  document.getElementById('montoMes').value     = mes;
  document.getElementById('montoAnio').value    = anio;
  document.getElementById('montoValor').value   = montoActual;
  document.getElementById('modalMonto').classList.add('open');
  setTimeout(() => document.getElementById('montoValor').select(), 80);
}
function cerrarModalMonto() { document.getElementById('modalMonto').classList.remove('open'); }

async function confirmarMonto() {
  const id    = document.getElementById('montoGastoId').value;
  const mes   = document.getElementById('montoMes').value;
  const anio  = document.getElementById('montoAnio').value;
  const monto = parseFloat(document.getElementById('montoValor').value);
  if (isNaN(monto) || monto < 0) { alert('Monto inválido'); return; }
  try {
    const r = await fetch(`/gastos/api/recurrentes/${id}/pagar`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mes: Number(mes), anio: Number(anio), pagado: false, monto_real: monto }),
    });
    if (!r.ok) { const d = await r.json(); alert(d.error || 'Error'); return; }
    cerrarModalMonto();
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── Nuevo / editar gasto fijo ──────────────────────────────────
// Helper: lee el data-rec del botón lápiz y abre el modal completo
function abrirModalGastoDesdeBtn(btn) {
  try {
    const rec = JSON.parse(btn.dataset.rec);
    abrirModalGasto(rec);
  } catch(e) {
    console.error('Error parseando rec:', e);
  }
}

let _tipoGasto = 'fijo';
function setTipoGasto(tipo) {
  _tipoGasto = tipo;
  const btnFijo = document.getElementById('btnTipoFijo');
  const btnExt  = document.getElementById('btnTipoExtraordinario');
  const hint    = document.getElementById('tipoHint');
  const limWrap = document.getElementById('g_limite_wrap');
  const diaWrap = document.getElementById('g_dia_wrap');
  if (tipo === 'fijo') {
    btnFijo.style.borderColor = 'var(--color-primary)';
    btnFijo.style.background  = 'rgba(27,79,216,.1)';
    btnFijo.style.color       = 'var(--color-primary)';
    btnExt.style.borderColor  = 'var(--border-color)';
    btnExt.style.background   = 'var(--bg-surface-2)';
    btnExt.style.color        = 'var(--text-secondary)';
    hint.textContent = 'Se genera todos los meses automáticamente.';
    limWrap.style.display = 'block';
    diaWrap.style.display = 'block';
  } else {
    btnExt.style.borderColor  = '#6366f1';
    btnExt.style.background   = 'rgba(99,102,241,.1)';
    btnExt.style.color        = '#6366f1';
    btnFijo.style.borderColor = 'var(--border-color)';
    btnFijo.style.background  = 'var(--bg-surface-2)';
    btnFijo.style.color       = 'var(--text-secondary)';
    hint.textContent = 'Gasto puntual — se genera solo una vez este mes.';
    limWrap.style.display = 'none';
    diaWrap.style.display = 'none';
  }
}

function abrirModalGasto(rec) {
  document.getElementById('gastoError').style.display = 'none';
  if (rec) {
    document.getElementById('modalGastoTitulo').textContent = 'Editar gasto';
    document.getElementById('gasto_edit_id').value  = rec.id;
    document.getElementById('g_descripcion').value  = rec.descripcion;
    document.getElementById('g_categoria_id').value = rec.categoria_id || '';
    document.getElementById('g_monto').value        = rec.monto_estimado;
    document.getElementById('g_dia').value          = rec.dia_vencimiento;
    document.getElementById('g_cuotas').value       = rec.cuotas_total || '';
    document.getElementById('g_fecha_fin').value    = rec.fecha_fin || '';
    document.getElementById('g_notas').value        = rec.notas || '';
    setTipoGasto(rec.tipo || 'fijo');
  } else {
    document.getElementById('modalGastoTitulo').textContent = 'Nuevo gasto';
    document.getElementById('gasto_edit_id').value  = '';
    document.getElementById('g_descripcion').value  = '';
    document.getElementById('g_categoria_id').value = '';
    document.getElementById('g_monto').value        = '';
    document.getElementById('g_dia').value          = '1';
    document.getElementById('g_cuotas').value       = '';
    document.getElementById('g_fecha_fin').value    = '';
    document.getElementById('g_notas').value        = '';
    setTipoGasto('fijo');
  }
  document.getElementById('modalGasto').classList.add('open');
  setTimeout(() => document.getElementById('g_descripcion').focus(), 80);
}
function cerrarModalGasto() { document.getElementById('modalGasto').classList.remove('open'); }

async function guardarGasto() {
  const errEl = document.getElementById('gastoError');
  errEl.style.display = 'none';
  const id          = document.getElementById('gasto_edit_id').value;
  const descripcion = document.getElementById('g_descripcion').value.trim();
  const categoria_id= document.getElementById('g_categoria_id').value || null;
  const monto       = parseFloat(document.getElementById('g_monto').value);
  const dia         = parseInt(document.getElementById('g_dia').value) || 1;
  const cuotas      = document.getElementById('g_cuotas').value ? parseInt(document.getElementById('g_cuotas').value) : null;
  const fecha_fin   = document.getElementById('g_fecha_fin').value || null;
  const notas       = document.getElementById('g_notas').value.trim() || null;

  if (!descripcion)           { errEl.textContent = 'El nombre es obligatorio'; errEl.style.display='block'; return; }
  if (isNaN(monto)||monto<=0) { errEl.textContent = 'El monto debe ser mayor a 0'; errEl.style.display='block'; return; }
  if (_tipoGasto === 'fijo' && (!dia||dia<1||dia>31)) { errEl.textContent = 'El día debe estar entre 1 y 31'; errEl.style.display='block'; return; }

  try {
    const url    = id ? `/gastos/api/recurrentes/${id}` : '/gastos/api/recurrentes';
    const method = id ? 'PUT' : 'POST';
    const r = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ descripcion, categoria_id, monto_estimado: monto, dia_vencimiento: dia,
                             tipo: _tipoGasto, cuotas_total: cuotas, fecha_fin, notas }),
    });
    if (!r.ok) { const d = await r.json(); errEl.textContent = d.error||'Error'; errEl.style.display='block'; return; }
    cerrarModalGasto();
    location.reload();
  } catch(e) { errEl.textContent = 'Error de conexión'; errEl.style.display='block'; }
}

// ── Pagos parciales del gasto ──────────────────────────────────
let _pgGastoId = null;
const fmtPG = n => '$' + Number(n||0).toLocaleString('es-AR',{minimumFractionDigits:2});

async function abrirPagosGasto(gastoId, nombre) {
  _pgGastoId = gastoId;
  document.getElementById('pgNombre').textContent = nombre || 'Gasto';
  document.getElementById('pgMonto').value  = '';
  document.getElementById('pgFecha').value  = new Date().toISOString().split('T')[0];
  document.getElementById('pgMetodo').value = '';
  document.getElementById('pgNota').value   = '';
  document.getElementById('pgError').style.display = 'none';
  document.getElementById('modalPagosGasto').classList.add('open');
  await pgCargar();
}
function cerrarPagosGasto() { document.getElementById('modalPagosGasto').classList.remove('open'); }

async function pgCargar() {
  try {
    const r = await fetch('/gastos/api/gasto/' + _pgGastoId + '/pagos');
    const d = await r.json();
    document.getElementById('pgTotal').textContent    = fmtPG(d.total);
    document.getElementById('pgPagado').textContent   = fmtPG(d.pagado);
    document.getElementById('pgPendiente').textContent= fmtPG(d.pendiente);
    const hEl = document.getElementById('pgHistorial');
    if (!d.pagos || !d.pagos.length) {
      hEl.innerHTML = '<div style="text-align:center;color:var(--text-secondary);font-size:12px;padding:10px 0;">Sin pagos aún — podés registrar el primero abajo</div>';
    } else {
      hEl.innerHTML = d.pagos.map(p => {
        const f = p.fecha ? p.fecha.slice(8)+'/'+p.fecha.slice(5,7)+'/'+p.fecha.slice(0,4) : '--';
        const metodoNota = [p.metodo, p.nota].filter(Boolean).join(' · ');
        return `<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(16,185,129,.06);border-radius:8px;border:1px solid rgba(16,185,129,.15);">
          <i class="bi bi-check-circle-fill" style="color:#059669;font-size:14px;flex-shrink:0;"></i>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:700;color:var(--text-primary);">${fmtPG(p.monto)}</div>
            <div style="font-size:11px;color:var(--text-secondary);">${f}${metodoNota ? ' · ' + metodoNota : ''}</div>
          </div>
          <button onclick="pgEliminar(${p.id})" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:13px;padding:3px;"
            title="Eliminar pago" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='var(--text-secondary)'">
            <i class="bi bi-trash3"></i>
          </button>
        </div>`;
      }).join('');
    }
  } catch(e) {}
}

function pgTodo() {
  const pnd = parseFloat((document.getElementById('pgPendiente').textContent||'0').replace(/[^0-9,.]/g,'').replace(/\./g,'').replace(',','.')) || 0;
  document.getElementById('pgMonto').value = pnd.toFixed(2);
}

async function pgConfirmar() {
  const errEl  = document.getElementById('pgError');
  errEl.style.display = 'none';
  const monto  = parseFloat(document.getElementById('pgMonto').value);
  const fecha  = document.getElementById('pgFecha').value;
  const metodo = document.getElementById('pgMetodo').value;
  const nota   = document.getElementById('pgNota').value.trim();
  if (!monto || monto <= 0) { errEl.textContent='Ingresá un monto válido'; errEl.style.display='block'; return; }
  try {
    const r = await fetch('/gastos/api/gasto/' + _pgGastoId + '/pago', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ monto, fecha, metodo, nota }),
    });
    if (!r.ok) { const e=await r.json().catch(()=>({})); errEl.textContent=e.error||'Error'; errEl.style.display='block'; return; }
    document.getElementById('pgMonto').value = '';
    document.getElementById('pgNota').value  = '';
    await pgCargar();
    // Si quedó saldo 0, cerrar y recargar
    const pnd = parseFloat((document.getElementById('pgPendiente').textContent||'0').replace(/[^0-9,.]/g,'').replace(/\./g,'').replace(',','.')) || 0;
    if (pnd <= 0) { cerrarPagosGasto(); location.reload(); }
  } catch(e) { errEl.textContent='Error de conexión'; errEl.style.display='block'; }
}

async function pgEliminar(pagoId) {
  if (!confirm('¿Eliminar este pago?')) return;
  try {
    await fetch('/gastos/api/pago/' + pagoId, { method: 'DELETE' });
    await pgCargar();
  } catch(e) { alert('Error de conexión'); }
}

// ── Eliminar gasto fijo ────────────────────────────────────────
async function eliminarGastoFijo(id, nombre) {
  if (!confirm('¿Eliminar el gasto "' + nombre + '"? Se eliminará de todos los meses donde no haya sido pagado. Los meses ya pagados quedan en el historial.')) return;
  try {
    const r = await fetch('/gastos/api/gasto/' + id, { method: 'DELETE' });
    if (!r.ok) { const e = await r.json().catch(()=>({})); alert(e.error || 'Error al eliminar'); return; }
    location.reload();
  } catch(e) { alert('Error de conexión'); }
}

// ── CSS filtros rápidos ────────────────────────────────────────
(function(){
  var st = document.createElement('style');
  st.textContent = '.filtro-rapido{padding:4px 12px;border-radius:20px;border:1.5px solid var(--border-color);background:var(--bg-surface);color:var(--text-secondary);font-size:11px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:.15s;}.filtro-rapido:hover{border-color:var(--color-primary);color:var(--color-primary);}@media print{.no-print{display:none!important;}}';
  document.head.appendChild(st);
})();

const fmtBuscar = function(n){ return '$' + Number(n||0).toLocaleString('es-AR',{minimumFractionDigits:2}); };
const fmtFechaBuscar = function(f){ return f ? new Date(f+'T00:00:00').toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'}) : '—'; };

function setFiltroRapido(tipo) {
  var hoy = new Date();
  var pad = function(n){ return String(n).padStart(2,'0'); };
  var ymd = function(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); };
  document.querySelectorAll('.filtro-rapido').forEach(function(b){ b.classList.remove('activo'); });
  event.target.classList.add('activo');
  var desde, hasta;
  if (tipo === 'mes') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
    hasta = ymd(new Date(hoy.getFullYear(), hoy.getMonth()+1, 0));
  } else if (tipo === 'mes_ant') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth()-1, 1));
    hasta = ymd(new Date(hoy.getFullYear(), hoy.getMonth(), 0));
  } else if (tipo === 'trim') {
    desde = ymd(new Date(hoy.getFullYear(), hoy.getMonth()-2, 1));
    hasta = ymd(hoy);
  } else if (tipo === 'anio') {
    desde = hoy.getFullYear() + '-01-01';
    hasta = ymd(hoy);
  }
  document.getElementById('filtroDesde').value = desde;
  document.getElementById('filtroHasta').value  = hasta;
  buscarGastos();
}

async function buscarGastos() {
  var desde = document.getElementById('filtroDesde').value;
  var hasta  = document.getElementById('filtroHasta').value;
  var q      = document.getElementById('filtroQ').value.trim();
  if (!desde && !hasta && !q) { alert('Ingresá al menos una fecha o término'); return; }
  var params = new URLSearchParams();
  if (desde) params.set('desde', desde);
  if (hasta)  params.set('hasta',  hasta);
  if (q)      params.set('q',      q);
  try {
    var r = await fetch('/gastos/api/buscar?' + params.toString());
    var d = await r.json();
    if (!r.ok) { alert(d.error || 'Error'); return; }
    // KPIs
    var kpis = document.getElementById('buscarKpis');
    kpis.style.display = 'grid';
    var pct = d.total > 0 ? Math.round(d.pagado/d.total*100) : 0;
    var cantPag  = d.gastos.filter(function(g){return g.pagado;}).length;
    var cantPend = d.gastos.filter(function(g){return !g.pagado;}).length;
    function kpiDiv(label, valor, color) {
      return '<div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">' +
        '<div style="font-size:10px;font-weight:700;text-transform:uppercase;color:'+color+';margin-bottom:4px;">'+label+'</div>' +
        '<div style="font-size:17px;font-weight:900;color:'+color+';font-family:var(--font-mono);">'+valor+'</div>' +
        '</div>';
    }
    kpis.innerHTML =
      kpiDiv('Total', fmtBuscar(d.total) + ' (' + d.cantidad + ')', 'var(--color-primary)') +
      kpiDiv('Pagado', fmtBuscar(d.pagado) + ' (' + cantPag + ')', 'var(--color-success)') +
      kpiDiv('Pendiente', fmtBuscar(d.pendiente) + ' (' + cantPend + ')', 'var(--color-alert)') +
      '<div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:10px;padding:12px 14px;">' +
        '<div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#6366f1;margin-bottom:4px;">% Pagado</div>' +
        '<div style="font-size:17px;font-weight:900;color:#6366f1;font-family:var(--font-mono);">' + pct + '%</div>' +
        '<div style="height:5px;background:var(--bg-surface);border-radius:3px;margin-top:6px;overflow:hidden;">' +
          '<div style="height:100%;width:'+pct+'%;background:#6366f1;border-radius:3px;"></div>' +
        '</div>' +
      '</div>';
    // Título
    var tit = d.cantidad + ' gasto' + (d.cantidad!==1?'s':'') + ' encontrados';
    if (desde) tit += ' · desde ' + fmtFechaBuscar(desde);
    if (hasta)  tit += ' hasta '  + fmtFechaBuscar(hasta);
    document.getElementById('buscarTitulo').textContent = tit;
    if (!d.gastos.length) {
      document.getElementById('buscarResultado').style.display = 'none';
      document.getElementById('buscarVacio').style.display = 'block';
      return;
    }
    document.getElementById('buscarVacio').style.display    = 'none';
    document.getElementById('buscarResultado').style.display = 'block';
    document.getElementById('buscarTbody').innerHTML = d.gastos.map(function(g, i) {
      var cat  = g.categoria || g.rec_cat || '—';
      var desc = g.descripcion || '—';
      var pag  = !!g.pagado;
      var bg   = i%2===0 ? 'var(--bg-surface)' : 'var(--bg-surface-2)';
      var est  = pag
        ? '<span style="background:rgba(16,185,129,.1);color:var(--color-success);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">&#10003; Pagado</span>'
        : '<span style="background:rgba(245,158,11,.1);color:var(--color-alert);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;">Pendiente</span>';
      return '<tr style="border-bottom:1px solid var(--border-color);background:'+bg+';">' +
        '<td style="padding:8px 12px;color:var(--text-secondary);font-size:12px;">' + fmtFechaBuscar(g.fecha) + '</td>' +
        '<td style="padding:8px 12px;font-weight:600;color:var(--text-primary);">' + cat + '</td>' +
        '<td style="padding:8px 12px;color:var(--text-primary);">' + desc + '</td>' +
        '<td style="padding:8px 12px;text-align:center;">' + est + '</td>' +
        '<td style="padding:8px 12px;text-align:right;font-family:var(--font-mono);font-weight:800;color:'+(pag?'var(--color-success)':'var(--color-danger)')+';">' + fmtBuscar(g.monto) + '</td>' +
        '<td style="padding:8px 12px;text-align:center;color:var(--text-secondary);font-size:12px;">' + (g.metodo_pago||'—') + '</td>' +
        '<td style="padding:8px 12px;text-align:center;"><button onclick="eliminarGastoBuscador('+g.id+')" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:14px;padding:3px;" title="Eliminar"><i class="bi bi-trash3"></i></button></td>' +
        '</tr>';
    }).join('');
  } catch(e) { alert('Error de conexión'); }
}

async function eliminarGastoBuscador(id) {
  if (!confirm('¿Eliminar este gasto?')) return;
  try {
    const r = await fetch('/gastos/api/gasto/' + id, { method: 'DELETE' });
    if (!r.ok) { const e = await r.json().catch(()=>({})); alert(e.error||'Error'); return; }
    buscarGastos(); // recargar resultados
  } catch(e) { alert('Error de conexión'); }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    cerrarModalPago();
    cerrarModalMonto();
    cerrarModalGasto();
    cerrarModalCategorias();
    cerrarModalImprimir();
    cerrarPagosGasto();
  }
});

// ── Modal Imprimir ─────────────────────────────────────────────
function abrirModalImprimir() {
  document.getElementById('imprimirMes').value  = _MES;
  document.getElementById('imprimirAnio').value = _ANIO;
  document.getElementById('modalImprimir').classList.add('open');
}
function cerrarModalImprimir() {
  document.getElementById('modalImprimir').classList.remove('open');
}
function confirmarImprimir() {
  const mes  = document.getElementById('imprimirMes').value;
  const anio = document.getElementById('imprimirAnio').value;
  if (!anio || isNaN(Number(anio))) { alert('Año inválido'); return; }
  cerrarModalImprimir();
  window.open(`/gastos/resumen?mes=${mes}&anio=${anio}`, '_blank');
}

// ── Categorías ──────────────────────────────────────────────────
function abrirModalCategorias() {
  document.getElementById('nuevaCatNombre').value = '';
  document.getElementById('catError').style.display = 'none';
  document.getElementById('modalCategorias').classList.add('open');
  setTimeout(() => document.getElementById('nuevaCatNombre').focus(), 80);
}
function cerrarModalCategorias() {
  document.getElementById('modalCategorias').classList.remove('open');
}

async function guardarCategoria() {
  const errEl  = document.getElementById('catError');
  errEl.style.display = 'none';
  const nombre = document.getElementById('nuevaCatNombre').value.trim();
  const icono  = document.getElementById('nuevaCatIcono').value;
  const color  = document.getElementById('nuevaCatColor').value;
  if (!nombre) { errEl.textContent = 'El nombre es obligatorio'; errEl.style.display='block'; return; }
  try {
    const r = await fetch('/gastos/api/categorias', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nombre, icono, color }),
    });
    if (!r.ok) { const d = await r.json(); errEl.textContent = d.error||'Error'; errEl.style.display='block'; return; }
    cerrarModalCategorias();
    location.reload();
  } catch(e) { errEl.textContent = 'Error de conexión'; errEl.style.display='block'; }
}

async function eliminarCategoria(id) {
  if (!confirm('¿Eliminar esta categoría? Los gastos que la usen quedarán sin categoría.')) return;
  try {
    const r = await fetch(`/gastos/api/categorias/${id}`, { method: 'DELETE' });
    if (!r.ok) { alert('Error al eliminar'); return; }
    const row = document.getElementById(`cat-row-${id}`);
    if (row) row.remove();
  } catch(e) { alert('Error de conexión'); }
}
</script>
