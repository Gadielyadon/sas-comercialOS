<style>
.filtro-rapido {
  padding:4px 12px;border-radius:20px;border:1.5px solid var(--border-color);
  background:var(--bg-surface);color:var(--text-secondary);font-size:11px;
  font-weight:600;cursor:pointer;font-family:var(--font-body);transition:.15s;
}
.filtro-rapido:hover { border-color:var(--color-primary);color:var(--color-primary);background:var(--bg-hover); }
.filtro-rapido.activo { border-color:var(--color-primary);background:var(--color-primary);color:#fff; }
