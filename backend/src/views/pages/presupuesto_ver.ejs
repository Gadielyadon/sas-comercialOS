/* ── IMPRIMIR TÉRMICA ── */
function imprimirTermica() {
  const p   = presupuesto;
  const emp = config.empresa_nombre    || 'Mi Comercio';
  const dir = config.empresa_direccion || '';
  const tel = config.empresa_telefono  || '';

  const itemsHTML = (p.items||[]).map(i => {
    const desc   = Number(i.descuento_item_pct || 0);
    const precio = precioAjustado(i) * (1 - desc/100);
    const sub    = Number(i.cantidad||0) * precio;
    return `<div style="margin-bottom:6px;">
      <div style="font-weight:700;font-size: 15px;text-transform:uppercase;">${i.nombre||''}</div>
      ${i.descripcion ? `<div style="font-size: 14px;color:#111;font-weight:700;">${i.descripcion}</div>` : ''}
      ${desc > 0 ? `<div style="font-size: 13px;color:#111;font-weight:800;">Desc. ${desc}%</div>` : ''}
      <div style="display:flex;justify-content:space-between;font-size: 13.5px;margin-top:2px;">
        <span>${Number(i.cantidad||0).toLocaleString('es-AR')} x ${fmt0(precio)}</span>
        <strong>${fmt0(sub)}</strong>
      </div>
    </div><div style="border-top:1px dashed #ccc;margin:4px 0;"></div>`;
  }).join('');

  const subtotal  = calcularSubtotal(p);
  const descuento = calcularDescuento(p);
  const iva       = calcularIva(p);
  const total     = calcularTotal(p);
  const pctsIva   = [...new Set((p.items||[]).map(i => (i.pct_iva !== null && i.pct_iva !== undefined && i.pct_iva !== '') ? Number(i.pct_iva) : null).filter(x => x !== null))];
  const ivaNota   = pctsIva.length === 1 ? `Estos productos incluyen el ${pctsIva[0]}% de IVA` : (pctsIva.length > 1 ? 'Estos productos incluyen IVA' : '');

  const w = window.open('', '_blank', 'width=380,height=800');
  w.document.write(`<!DOCTYPE html><html><head>
    <meta charset="UTF-8"><title>${p.numero}</title>
    <style>
      *{box-sizing:border-box;margin:0;padding:0;}
      @page{size:80mm auto;margin:3mm 2mm;}
      @media print{html,body{width:80mm;-webkit-print-color-adjust:exact;print-color-adjust:exact;}}
      body{font-family:'Courier New',Courier,monospace;width:76mm;margin:0 auto;padding:4px;color:#000;font-size: 13.5px;}
      .center{text-align:center;}
      .sep{border-top:1px dashed #000;margin:6px 0;}
      .row{display:flex;justify-content:space-between;gap:8px;margin:2px 0;}
      .total-row{display:flex;justify-content:space-between;font-size: 18px;font-weight:900;margin:4px 0;border-top:2px solid #000;border-bottom:2px solid #000;padding:4px 0;}
    </style>
  </head><body>
    <div class="center" style="font-size: 17px;font-weight:900;text-transform:uppercase;">${emp}</div>
    ${dir ? `<div class="center" style="font-size: 11.5px;">${dir}</div>` : ''}
    ${tel ? `<div class="center" style="font-size: 11.5px;">Tel: ${tel}</div>` : ''}
    <div class="sep"></div>
    <div class="center" style="font-weight:700;font-size: 15px;">PRESUPUESTO</div>
    <div class="center" style="font-size: 13.5px;">${p.numero}</div>
    <div class="center" style="font-size: 11.5px;">${new Date(p.created_at).toLocaleDateString('es-AR')}</div>
    <div class="sep"></div>
    <div style="font-size: 12.5px;">
      <div><strong>Cliente:</strong> ${p.cliente_nombre||'Sin nombre'}</div>
      ${p.cliente_direccion ? `<div><strong>Dirección:</strong> ${p.cliente_direccion}</div>` : ''}
      ${p.cliente_localidad ? `<div><strong>Localidad:</strong> ${p.cliente_localidad}</div>` : ''}
      ${p.cliente_cuit  ? `<div><strong>CUIT:</strong> ${p.cliente_cuit}</div>` : ''}
      ${p.cliente_tel   ? `<div><strong>Tel:</strong> ${p.cliente_tel}</div>` : ''}
      <div><strong>Cond. Venta:</strong> ${p.condicion_pago || 'Contado'}</div>
    </div>
    <div class="sep"></div>
    ${itemsHTML}
    <div class="row" style="font-size: 12.5px;"><span>Subtotal</span><strong>${fmt0(subtotal)}</strong></div>
    ${descuento > 0 ? `<div class="row" style="font-size: 12.5px;"><span>Descuento</span><strong>-${fmt0(descuento)}</strong></div>` : ''}
    ${iva > 0 ? `<div class="row" style="font-size: 12.5px;"><span>IVA</span><strong>${fmt0(iva)}</strong></div>` : ''}
    <div class="total-row"><span>TOTAL</span><span>${fmt0(total)}</span></div>
    ${ivaNota ? `<div style="text-align:center;font-size: 13.5px;color:#111;font-weight:700;margin-top:2px;">${ivaNota}</div>` : ''}
    ${p.condicion_pago ? `<div style="margin-top:6px;font-size: 11.5px;"><strong>Pago:</strong> ${p.condicion_pago}</div>` : ''}
    ${p.validez_dias   ? `<div style="font-size: 11.5px;"><strong>Validez:</strong> ${p.validez_dias} día(s)</div>` : ''}
    ${p.notas          ? `<div class="sep"></div><div style="font-size: 11.5px;"><strong>Notas:</strong> ${p.notas}</div>` : ''}
  </body></html>`);
  w.document.close();
  setTimeout(() => { w.focus(); w.print(); }, 500);
}
</script>
