<%- include('../partials/head', { title: presupuesto.numero }) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  .page-body { padding: 24px 32px; max-width: 1080px; }
  .top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
  .top-bar-left  { display: flex; align-items: center; gap: 14px; }
  .top-bar-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

  .badge-estado { display: inline-flex; align-items: center; gap: 5px; padding: 5px 14px; border-radius: 20px; font-size: 14px; font-weight: 700; }
  .badge-Borrador  { background: rgba(107,114,128,.1); color: #6b7280; }
  .badge-Enviado   { background: rgba(59,130,246,.1);  color: #3b82f6; }
  .badge-Aprobado  { background: rgba(16,185,129,.1);  color: #10b981; }
  .badge-Rechazado { background: rgba(239,68,68,.1);   color: #ef4444; }

  .btn-act {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border-radius: var(--radius-sm);
    border: 1.5px solid var(--border-color); background: var(--bg-card);
    color: var(--text-secondary); font-size: 15px; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: all .15s; white-space: nowrap;
  }
  .btn-act:hover { border-color: var(--color-action); color: var(--color-action); background: rgba(0,180,216,.05); }
  .btn-act.primary { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .btn-act.primary:hover { opacity: .88; }
  .btn-act.success { background: #10b981; border-color: #10b981; color: #fff; }
  .btn-act.success:hover { opacity: .88; }

  .doc-wrap { background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.06); }

  .doc-a4 {
    padding: 40px 48px;
    font-family: 'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    color: #111; font-size: 14px; line-height: 1.55;
    background: #fff;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .afip-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    border: 1.5px solid #333;
    margin-bottom: 0;
  }
  .afip-col-empresa { padding: 16px 18px; border-right: 1.5px solid #333; }
  .afip-col-centro {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 10px 20px; border-right: 1.5px solid #333;
    min-width: 130px; text-align: center;
  }
  .afip-col-doc { padding: 16px 18px; text-align: right; }
  .emp-logo { max-height: 56px; max-width: 140px; object-fit: contain; margin-bottom: 6px; display: block; }
  .emp-nombre { font-size: 21.5px; font-weight: 900; color: #111; margin-bottom: 3px; text-transform: uppercase; }
  .emp-tagline { font-size: 15px; color: #111; font-weight: 700; font-style: italic; margin-bottom: 3px; line-height: 1.35; }
  .emp-dato { font-size: 15px; color: #111; font-weight: 700; line-height: 1.7; }
  .fiscal-block { margin-top: 12px; padding-top: 10px; border-top: 1px solid #ddd; }
  .fiscal-line { font-size: 15px; color: #111; font-weight: 700; line-height: 1.75; text-transform: uppercase; }
  .fiscal-line span { color: #111; font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .4px; }
  .tipo-comp { font-size: 36px; font-weight: 900; color: #111; line-height: 1; }
  .tipo-comp-label { font-size: 15px; font-weight: 800; color: #111; margin-top: 4px; text-transform: uppercase; letter-spacing: .4px; }
  .doc-titulo { font-size: 19.5px; font-weight: 700; color: #111; margin-bottom: 6px; }
  .doc-nro { font-size: 22px; font-weight: 900; color: #111; letter-spacing: 1px; }
  .doc-fecha-label { font-size: 13.5px; color: #111; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; margin-top: 8px; }
  .doc-fecha-val   { font-size: 15px; font-weight: 600; color: #111; }

  .afip-cliente-row {
    border: 1.5px solid #333; border-top: none;
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .afip-cliente-main { padding: 12px 18px; border-right: 1.5px solid #333; }
  .afip-cliente-meta { padding: 12px 18px; }
  .cliente-col-grid { display: flex; flex-direction: column; gap: 6px; }
  .cliente-col-grid > div { display: flex; align-items: baseline; gap: 8px; }
  .afip-label { font-size: 13.5px; font-weight: 800; color: #111; text-transform: uppercase; letter-spacing: .5px; width: 118px; flex-shrink: 0; }
  .afip-val   { font-size: 17px; font-weight: 800; color: #111; text-transform: uppercase; }
  .afip-val.lg { font-size: 21.5px; font-weight: 900; }
  .afip-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }

  .tot-iva-nota { padding: 8px 14px; font-size: 15px; color: #111; font-weight: 700; font-style: italic; border-top: 1px solid #e5e7eb; }
  .condiciones-nota { font-size: 13px; color: #111; font-weight: 700; text-align: right; margin-top: 6px; font-style: italic; }

  .afip-tabla { width: 100%; border-collapse: collapse; margin-top: 0; font-size: 15.5px; }
  .afip-tabla thead tr th {
    background: #1a1a1a; color: #fff;
    padding: 11px 10px; font-size: 13.5px; font-weight: 800;
    text-transform: uppercase; letter-spacing: .4px; text-align: right;
    border-right: 1px solid #333;
  }
  .afip-tabla thead tr th:first-child { border-left: 1.5px solid #333; }
  .afip-tabla thead tr th.left { text-align: left; }
  .afip-tabla thead tr th:last-child { border-right: 1.5px solid #333; }
  .afip-tabla tbody td {
    padding: 11px 10px; border-bottom: 1px solid #ccc;
    vertical-align: top; text-align: right; color: #111; font-weight: 700;
    border-right: 1px solid #ccc;
  }
  .afip-tabla tbody td:first-child { border-left: 1.5px solid #e5e7eb; }
  .afip-tabla tbody td.left { text-align: left; }
  .afip-tabla tbody tr:last-child td { border-bottom: 1.5px solid #333; }
  .afip-tabla tbody tr:last-child td:last-child { border-right: 1.5px solid #333; }
  .afip-tabla tbody tr:last-child td:first-child { border-left: 1.5px solid #333; }
  .afip-tabla tbody tr:nth-child(even) td { background: #fafafa; }
  .item-nombre { font-weight: 800; color: #111; font-size: 16.5px; text-transform: uppercase; }

  .item-desc   { font-size: 14px; color: #111; font-weight: 700; margin-top: 2px; }
  .item-sku    { font-size: 13.5px; color: #111; font-weight: 700; font-family: monospace; margin-top: 1px; }
  .precio-tachado { font-size: 13.5px; color: #111; font-weight: 700; text-decoration: line-through; display: block; }
  .desc-pct { font-size: 14px; color: #111; font-weight: 800; }

  .afip-totales-wrap { display: flex; justify-content: flex-end; margin-top: 0; }
  .afip-totales { width: 360px; border: 1.5px solid #333; border-top: none; }
  .tot-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 7px 14px; border-bottom: 1px solid #e5e7eb; font-size: 13.5px;
  }
  .tot-row:last-child { border-bottom: none; }
  .tot-row.final { background: #1a1a1a; padding: 12px 14px; }
  .tot-row.final span:first-child { color: rgba(255,255,255,.8); font-size: 13.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
  .tot-row.final span:last-child  { color: #fff; font-size: 24px; font-weight: 900; }
  .tot-row.desc-row span:first-child { color: #111; font-weight: 700; }
  .tot-row.desc-row span:last-child  { color: #111; font-weight: 800; }

  .afip-footer {
    border: 1.5px solid #333; border-top: 1px solid #e5e7eb;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0; margin-top: 16px;
  }
  .footer-box { padding: 12px 16px; border-right: 1px solid #e5e7eb; font-size: 15px; color: #111; font-weight: 700; line-height: 1.65; }
  .footer-box:last-child { border-right: none; }
  .footer-box-title { font-size: 13.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .6px; color: #111; margin-bottom: 5px; }
  .footer-box-content { white-space: pre-line; }

  @media (max-width: 750px) {
    .page-body { padding: 10px 6px; }
    .doc-a4 { padding: 20px 12px; }
    .afip-header { grid-template-columns: 1fr; }
    .afip-col-empresa, .afip-col-doc { border-right: none; border-bottom: 1.5px solid #333; }
    .afip-col-centro { border-right: none; border-bottom: 1.5px solid #333; }
    .afip-cliente-row { grid-template-columns: 1fr; }
    .afip-cliente-main { border-right: none; border-bottom: 1px solid #e5e7eb; }
    .afip-totales { width: 100%; }
    .afip-totales-wrap { justify-content: stretch; }
    .afip-footer { grid-template-columns: 1fr; }
    .footer-box { border-right: none; border-bottom: 1px solid #e5e7eb; }
  }
</style>

<div class="app-wrapper">
  <%- include('../partials/sidebar', { active: 'presupuestos', user }) %>
  <div class="main-content">
    <%- include('../partials/header', { module: presupuesto.numero, user }) %>
    <div class="page-body">

      <div class="top-bar">
        <div class="top-bar-left">
          <a href="/presupuestos" class="btn-act"><i class="bi bi-arrow-left"></i> Volver</a>
          <span class="badge-estado badge-<%= presupuesto.estado %>"><%= presupuesto.estado %></span>
        </div>
        <div class="top-bar-actions">
          <button class="btn-act" onclick="if(window.opener&&!window.opener.closed){window.close()}else{location.href='/presupuestos'}"><i class="bi bi-arrow-left"></i> Volver</button>
          <% if (presupuesto.estado === 'Borrador') { %>
            <form method="POST" action="/presupuestos/estado/<%= presupuesto.id %>" style="margin:0">
              <input type="hidden" name="estado" value="Enviado">
              <button type="submit" class="btn-act"><i class="bi bi-send"></i> Marcar enviado</button>
            </form>
          <% } %>
          <% if (presupuesto.estado === 'Enviado') { %>
            <form method="POST" action="/presupuestos/estado/<%= presupuesto.id %>" style="margin:0">
              <input type="hidden" name="estado" value="Aprobado">
              <button type="submit" class="btn-act success"><i class="bi bi-check-circle"></i> Aprobar</button>
            </form>
          <% } %>
          <a href="/presupuestos/editar/<%= presupuesto.id %>" class="btn-act"><i class="bi bi-pencil"></i> Editar</a>
          <% if (presupuesto.estado === 'Aprobado') { %>
            <a href="/remitos/desde-presupuesto/<%= presupuesto.id %>" class="btn-act success"><i class="bi bi-truck"></i> Generar remito</a>
          <% } %>
          <button class="btn-act" onclick="imprimirTermica()"><i class="bi bi-receipt"></i> Térmica</button>
          <button class="btn-act primary" onclick="imprimirA4()"><i class="bi bi-printer-fill"></i> Imprimir A4</button>
        </div>
      </div>

      <div class="doc-wrap">
        <div class="doc-a4" id="docA4">
          <%
            // ── Recargo general: se funde en el precio de cada ítem (sin línea aparte) ──
            const factorAjuste = 1 + (Number(presupuesto.ajuste_pct || 0) / 100);

            // ── Datos fiscales del emisor: si AFIP está conectado los toma de AFIP,
            //    si no, de lo cargado en Ajustes ──
            const afipOn        = String(config.facturacion_habilitada) === '1';
            const emisorCuit    = afipOn
              ? (config.afip_cuit || config.empresa_cuit || '')
              : (config.empresa_cuit || config.afip_cuit || '');
            const emisorInicio  = config.empresa_inicio_actividades || '';
            const emisorIibb    = config.empresa_iibb || '';
            const emisorCondIva = config.empresa_cond_iva || '';

            const itemsCalc = (presupuesto.items || []).map(it => {
              const descPct    = Number(it.descuento_item_pct || 0);
              const precioBase = Number(it.precio_unitario || 0) * factorAjuste;
              const precioDesc = precioBase * (1 - descPct / 100);
              const cant       = Number(it.cantidad || 0);
              const subSD      = cant * precioDesc;
              const ivaPct     = (it.pct_iva !== null && it.pct_iva !== undefined && it.pct_iva !== '') ? Number(it.pct_iva) : null;
              const ivaVal     = ivaPct !== null ? subSD * ivaPct / 100 : 0;
              const totalCIva  = subSD + ivaVal;
              return { ...it, descPct, precioBase, precioDesc, cant, subSD, ivaPct, ivaVal, totalCIva };
            });
            const grandSub = itemsCalc.reduce((s, i) => s + i.subSD, 0);
            const grandIva = itemsCalc.reduce((s, i) => s + i.ivaVal, 0);
            const descGral = Number(presupuesto.descuento_monto || 0);
            const grandTot = Math.max(0, grandSub - descGral + grandIva);
          %>

          <div class="afip-header">
            <div class="afip-col-empresa">
              <% if (config.empresa_logo) { %>
                <img src="<%= config.empresa_logo %>" class="emp-logo" alt="Logo">
              <% } %>
              <div class="emp-nombre"><%= config.empresa_nombre || 'Mi Empresa' %></div>
              <% if (config.empresa_tagline) { %>
                <div class="emp-tagline"><%= config.empresa_tagline %></div>
              <% } %>
              <div class="emp-dato" style="margin-top:6px;">
                <% if (config.empresa_direccion) { %><div><%= config.empresa_direccion %></div><% } %>
                <% if (config.empresa_telefono)  { %><div>Tel: <%= config.empresa_telefono %></div><% } %>
                <% if (config.empresa_email)     { %><div><%= config.empresa_email %></div><% } %>
              </div>
            </div>
            <div class="afip-col-centro">
              <div class="tipo-comp">X</div>
              <div class="tipo-comp-label">Presupuesto</div>
            </div>
            <div class="afip-col-doc">
              <div class="doc-titulo">PRESUPUESTO</div>
              <div class="doc-nro"><%= presupuesto.numero %></div>
              <div class="doc-fecha-label">Fecha</div>
              <div class="doc-fecha-val"><%= new Date(presupuesto.created_at).toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }) %></div>
              <% if (emisorCondIva || emisorCuit || emisorInicio || emisorIibb) { %>
                <div class="fiscal-block">
                  <% if (emisorCondIva) { %><div class="fiscal-line"><%= emisorCondIva %></div><% } %>
                  <% if (emisorCuit)    { %><div class="fiscal-line"><span>CUIT</span> <%= emisorCuit %></div><% } %>
                  <% if (emisorInicio)  { %><div class="fiscal-line"><span>Inicio Act.</span> <%= emisorInicio %></div><% } %>
                  <% if (emisorIibb)    { %><div class="fiscal-line"><span>Ing. Brutos</span> <%= emisorIibb %></div><% } %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="afip-cliente-row">
            <div class="afip-cliente-main">
              <div class="cliente-col-grid">
                <div><span class="afip-label">Cliente</span><span class="afip-val lg"><%= (presupuesto.cliente_nombre && presupuesto.cliente_nombre.trim() && presupuesto.cliente_nombre !== 'Sin nombre') ? presupuesto.cliente_nombre : 'Consumidor Final' %></span></div>
                <div><span class="afip-label">Dirección</span><span class="afip-val"><%= presupuesto.cliente_direccion || '—' %></span></div>
                <div><span class="afip-label">Localidad</span><span class="afip-val"><%= presupuesto.cliente_localidad || '—' %></span></div>
                <div><span class="afip-label">I.V.A.</span><span class="afip-val"><%= presupuesto.cliente_cond_iva || 'Consumidor Final' %></span></div>
              </div>
            </div>
            <div class="afip-cliente-meta">
              <div class="cliente-col-grid">
                <div><span class="afip-label">C.U.I.T.</span><span class="afip-val"><%= presupuesto.cliente_cuit || '—' %></span></div>
                <div><span class="afip-label">Condición de Venta</span><span class="afip-val"><%= presupuesto.condicion_pago || 'Contado' %></span></div>
                <div>
                  <span class="afip-label">Fecha de Vto.</span>
                  <span class="afip-val">
                    <% if (presupuesto.validez_dias) {
                         const vto = new Date(presupuesto.created_at);
                         vto.setDate(vto.getDate() + Number(presupuesto.validez_dias));
                    %>
                      <%= vto.toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }) %>
                    <% } else { %>Sin vencimiento<% } %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <%
            const hayCodigo = itemsCalc.some(i => i.sku);
            // Nota de IVA: si todos los ítems con IVA cargado comparten el mismo %,
            // lo mostramos como aviso informativo (ya viene incluido en el precio).
            const pctsIva = [...new Set(itemsCalc.map(i => i.ivaPct).filter(p => p !== null))];
            const ivaUniforme = pctsIva.length === 1 ? pctsIva[0] : null;
          %>

          <table class="afip-tabla">
            <thead>
              <tr>
                <% if (hayCodigo) { %><th style="width:80px;" class="left">Código</th><% } %>
                <th class="left">Descripción</th>
                <th style="width:70px;">Cantidad</th>
                <th style="width:120px;">Precio Unit.</th>
                <th style="width:120px;">Total</th>
              </tr>
            </thead>
            <tbody>
              <% itemsCalc.forEach((item) => { %>
                <tr>
                  <% if (hayCodigo) { %><td class="left" style="color:#111;font-weight:700;font-size: 15px;"><%= item.sku || '—' %></td><% } %>
                  <td class="left">
                    <div class="item-nombre"><%= item.nombre %></div>
                    <% if (item.descripcion) { %><div class="item-desc"><%= item.descripcion %></div><% } %>
                  </td>
                  <td><%= item.cant.toLocaleString('es-AR') %></td>
                  <td>
                    <% if (item.descPct > 0) { %>
                      <span class="precio-tachado">$<%= item.precioBase.toLocaleString('es-AR', {minimumFractionDigits:2}) %></span>
                    <% } %>
                    $<%= item.precioDesc.toLocaleString('es-AR', {minimumFractionDigits:2}) %>
                    <% if (item.descPct > 0) { %><div class="desc-pct"><%= item.descPct %>% desc.</div><% } %>
                  </td>
                  <td style="font-weight:700;">$<%= item.subSD.toLocaleString('es-AR', {minimumFractionDigits:2}) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>

          <div class="afip-totales-wrap">
            <div class="afip-totales">
              <div class="tot-row">
                <span style="color:#111;font-weight:700;">Subtotal</span>
                <strong>$<%= grandSub.toLocaleString('es-AR', {minimumFractionDigits:2}) %></strong>
              </div>
              <% if (descGral > 0) { %>
                <div class="tot-row desc-row">
                  <span>Descuento general</span>
                  <span>-$<%= descGral.toLocaleString('es-AR', {minimumFractionDigits:2}) %></span>
                </div>
              <% } %>
              <% if (grandIva > 0) { %>
                <div class="tot-row">
                  <span style="color:#111;font-weight:700;">IVA</span>
                  <strong>$<%= grandIva.toLocaleString('es-AR', {minimumFractionDigits:2}) %></strong>
                </div>
              <% } %>
              <div class="tot-row final">
                <span>TOTAL</span>
                <span>$<%= grandTot.toLocaleString('es-AR', {minimumFractionDigits:2}) %></span>
              </div>
              <% if (ivaUniforme !== null) { %>
                <div class="tot-iva-nota">Estos productos incluyen el <%= ivaUniforme %>% de IVA</div>
              <% } else if (pctsIva.length > 1) { %>
                <div class="tot-iva-nota">Estos productos incluyen IVA (porcentajes variables según ítem)</div>
              <% } %>
            </div>
          </div>

          <div class="condiciones-nota">Precios sujetos a variación sin previo aviso.</div>

          <% const hayFooter = presupuesto.condicion_pago || presupuesto.condicion_pago_obs || presupuesto.notas || presupuesto.validez_dias; %>
          <% if (hayFooter) { %>
            <div class="afip-footer">
              <% if (presupuesto.condicion_pago || presupuesto.condicion_pago_obs) { %>
                <div class="footer-box">
                  <div class="footer-box-title">Condición de pago</div>
                  <div class="footer-box-content">
                    <% if (presupuesto.condicion_pago) { %><strong><%= presupuesto.condicion_pago %></strong><% } %>
                    <% if (presupuesto.condicion_pago_obs) { %><div style="margin-top:3px;"><%= presupuesto.condicion_pago_obs %></div><% } %>
                  </div>
                </div>
              <% } %>
              <% if (presupuesto.validez_dias) { %>
                <div class="footer-box">
                  <div class="footer-box-title">Validez del presupuesto</div>
                  <div class="footer-box-content">Este presupuesto tiene una validez de <strong><%= presupuesto.validez_dias %> día<%= Number(presupuesto.validez_dias) !== 1 ? 's' : '' %></strong> desde su emisión.</div>
                </div>
              <% } %>
              <% if (presupuesto.notas) { %>
                <div class="footer-box">
                  <div class="footer-box-title">Notas / Aclaraciones</div>
                  <div class="footer-box-content"><%= presupuesto.notas %></div>
                </div>
              <% } %>
            </div>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>
<script>
const presupuesto = <%- JSON.stringify(presupuesto) %>;
const config      = <%- JSON.stringify(config) %>;

const fmt  = n => '$' + (Number(n)||0).toLocaleString('es-AR', { minimumFractionDigits: 2 });
const fmt0 = n => '$' + (Number(n)||0).toLocaleString('es-AR', { minimumFractionDigits: 0 });

// Recargo general fundido en el precio de cada ítem
const factorAjuste = 1 + (Number(presupuesto.ajuste_pct || 0) / 100);
const precioAjustado = i => Number(i.precio_unitario || 0) * factorAjuste;

function calcItemSub(i) {
  const desc = Number(i.descuento_item_pct || 0);
  return Number(i.cantidad || 0) * precioAjustado(i) * (1 - desc / 100);
}
function calcItemIva(i) {
  const pct = (i.pct_iva !== null && i.pct_iva !== undefined && i.pct_iva !== '') ? Number(i.pct_iva) : 0;
  return calcItemSub(i) * pct / 100;
}
function calcularSubtotal(p) { return (p.items||[]).reduce((s,i) => s + calcItemSub(i), 0); }
function calcularIva(p)      { return (p.items||[]).reduce((s,i) => s + calcItemIva(i), 0); }
function calcularDescuento(p){ return Number(p.descuento_monto || 0); }
function calcularTotal(p)    { return Math.max(0, calcularSubtotal(p) - calcularDescuento(p) + calcularIva(p)); }

