                </div>
                <input type="file" id="f_portada_file" accept="image/*" style="display:none;">
              </div>
            </div>
          </div>
        </div>
        </div>

        <button class="btn-guardar" onclick="guardar()"><i class="bi bi-check-lg"></i> Guardar cambios</button>

        <!-- ── Banners promocionales (imágenes sueltas, sin producto) ── -->
        <div class="cat-section" style="margin-top:24px;">
          <div class="cat-section-header">
            <div class="cat-section-icon" style="background:linear-gradient(135deg,#ef4444,#b91c1c);"><i class="bi bi-images"></i></div>
            <div class="cat-section-title">Banner de promociones</div>
          </div>
          <div class="cat-section-body">
            <p style="font-size:12.5px;color:var(--text-secondary);margin-bottom:14px;">Imágenes sueltas que aparecen en un carrusel debajo de la portada, para promos o novedades. No están atadas a ningún producto.</p>
            <div class="prod-toolbar">
              <button class="btn-nuevo-prod" onclick="document.getElementById('banner_file').click()"><i class="bi bi-plus-lg"></i> Agregar imagen</button>
              <input type="file" id="banner_file" accept="image/*" style="display:none;">
