            <div class="prod-grid" id="bannerGrid"></div>
            <div class="prod-empty" id="bannerEmpty" style="display:none;">Todavía no agregaste ninguna imagen promocional.</div>
          </div>
        </div>

        <!-- ── Productos del catálogo propio (solo si origen = propio) ── -->
        <div class="cat-section" id="seccionProductosPropios" style="margin-top:24px;">
          <div class="cat-section-header">
            <div class="cat-section-icon" style="background:linear-gradient(135deg,#0EA5E9,#0369A1);"><i class="bi bi-grid-3x3-gap"></i></div>
            <div class="cat-section-title">Productos del catálogo</div>
          </div>
          <div class="cat-section-body">
            <div class="prod-toolbar">
              <button class="btn-nuevo-prod" onclick="abrirModalProducto()"><i class="bi bi-plus-lg"></i> Nuevo producto</button>
            </div>
            <div class="prod-grid" id="prodGrid"></div>
            <div class="prod-empty" id="prodEmpty" style="display:none;">Todavía no cargaste ningún producto. Tocá "Nuevo producto" para empezar.</div>
          </div>
        </div>

      <% } %>

    </div>
  </div>
</div>

<div class="toast-ok" id="toastOk">Guardado ✓</div>

<!-- Modal alta/edición de producto -->
<div class="pmodal-overlay" id="pmodalOverlay" onclick="if(event.target===this) cerrarModalProducto()">
  <div class="pmodal">
    <div class="pmodal-head"><h3 id="pmodalTitulo">Nuevo producto</h3><button onclick="cerrarModalProducto()"><i class="bi bi-x-lg"></i></button></div>
    <div class="pmodal-body">
      <input type="hidden" id="p_id">
      <div class="cat-field">
        <label>Nombre</label>
        <input type="text" id="p_nombre" placeholder="Ej: Coca Cola 2L">
      </div>
      <div class="cat-field">
        <label>Categoría</label>
        <input type="text" id="p_categoria" list="catList" placeholder="Ej: Bebidas">
        <datalist id="catList"></datalist>
      </div>
      <div class="cat-field">
        <label>Precio</label>
        <input type="number" id="p_precio" placeholder="0" min="0" step="0.01">
      </div>
      <div class="cat-field">
        <label>Descripción</label>
        <textarea id="p_descripcion" placeholder="Detalle del producto: medidas, colores, usos..." style="min-height:70px;"></textarea>
      </div>
      <div class="cat-row-toggle" style="padding-top:0;">
        <div><div class="lbl">En promoción</div><div class="desc">Muestra precio tachado + oferta</div></div>
        <label class="cat-switch"><input type="checkbox" id="p_en_promo" onchange="togglePromoField()"><span class="slider"></span></label>
      </div>
      <div class="cat-field" id="campoPrecioPromo" style="display:none;">
        <label>Precio de promoción</label>
        <input type="number" id="p_precio_promo" placeholder="0" min="0" step="0.01">
      </div>
      <div class="cat-field">
        <label>Foto principal</label>
        <div class="cat-logo-zone small" id="prodLogoZone">
          <img id="prodImgPreview" style="display:none;">
          <div id="prodLogoZoneTxt"><i class="bi bi-camera" style="font-size:20px;opacity:.5;"></i><div style="margin-top:5px;font-size:12.5px;color:var(--text-secondary);">Click para elegir foto</div></div>
        </div>
        <input type="file" id="p_imagen_file" accept="image/*" style="display:none;">
      </div>
      <div class="cat-field">
        <label>Fotos adicionales (hasta 5)</label>
        <div id="galeriaGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:8px;"></div>
        <button type="button" onclick="document.getElementById('p_galeria_file').click()" style="width:100%;border:1.5px dashed var(--border-color);background:var(--bg-surface-2);color:var(--text-secondary);border-radius:9px;padding:10px;font-size:12.5px;cursor:pointer;"><i class="bi bi-plus-lg"></i> Agregar foto a la galería</button>
        <input type="file" id="p_galeria_file" accept="image/*" style="display:none;">
      </div>
    </div>
    <div class="pmodal-foot"><button onclick="guardarProductoPropio()">Guardar producto</button></div>
  </div>
</div>

<script>
document.getElementById('urlCatalogo') && (document.getElementById('urlCatalogo').value = window.location.origin + '/vidriera');

function copiarUrl(){
  const el = document.getElementById('urlCatalogo');
  el.select(); el.setSelectionRange(0, 99999);
  navigator.clipboard.writeText(el.value).then(()=>{
    mostrarToast('Link copiado ✓');
  });
}

function mostrarToast(msg){
  const t = document.getElementById('toastOk'); t.textContent = msg || 'Guardado ✓'; t.style.display='block';
  setTimeout(()=>{ t.style.display='none'; }, 1800);
}

async function activar(){
  const clave = document.getElementById('claveInput').value.trim();
  if (!clave) return;
  try {
    const r = await fetch('/catalogo/activar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ clave }) });
    const data = await r.json();
    if (data.ok) { window.location.reload(); }
    else { document.getElementById('lockErr').style.display = 'block'; }
  } catch(e) { document.getElementById('lockErr').style.display = 'block'; }
}

// ── Origen ──────────────────────────────────────────
function elegirOrigen(origen){
  document.getElementById('f_origen').value = origen;
  document.getElementById('origenPropioCard').classList.toggle('selected', origen === 'propio');
  document.getElementById('origenInventarioCard').classList.toggle('selected', origen === 'inventario');
  document.getElementById('origenAmbosCard').classList.toggle('selected', origen === 'ambos');
  const seccionProd = document.getElementById('seccionProductosPropios');
  if (seccionProd) seccionProd.style.display = (origen === 'propio' || origen === 'ambos') ? '' : 'none';
}
elegirOrigen(document.getElementById('f_origen')?.value || 'propio');

// ── Foto de portada ─────────────────────────────────
let portadaBase64 = null;
const logoZone = document.getElementById('logoZone');
function redimensionarImagen(file, maxSize, cb){
  const reader = new FileReader();
  reader.onload = (ev) => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height;
      if (w > maxSize || h > maxSize) { if (w > h) { h = Math.round(h*maxSize/w); w = maxSize; } else { w = Math.round(w*maxSize/h); h = maxSize; } }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      cb(canvas.toDataURL('image/jpeg', 0.8));
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}
if (logoZone) {
  logoZone.addEventListener('click', () => document.getElementById('f_portada_file').click());
  document.getElementById('f_portada_file').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    redimensionarImagen(file, 1000, (dataUrl) => {
      portadaBase64 = dataUrl;
      document.getElementById('portadaPreview').src = dataUrl;
      document.getElementById('portadaPreview').style.display = 'block';
      document.getElementById('logoZoneTxt').style.display = 'none';
    });
  });
}

async function guardar(){
  const body = {
    vidriera_activa: document.getElementById('f_activa').checked ? '1' : '0',
    vidriera_mostrar_precios: document.getElementById('f_precios').checked ? '1' : '0',
    vidriera_whatsapp: document.getElementById('f_whatsapp').value.trim(),
    vidriera_mensaje: document.getElementById('f_mensaje').value.trim(),
    vidriera_color_acento: document.getElementById('f_color').value,
    vidriera_color_fondo: document.getElementById('f_color_fondo').value,
    vidriera_origen: document.getElementById('f_origen').value,
  };
  if (portadaBase64) body.vidriera_portada = portadaBase64;
  try {
    const r = await fetch('/catalogo/api/guardar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await r.json();
    if (!data.ok) { alert('Error: ' + (data.error || 'no se pudo guardar')); return; }
    mostrarToast('Guardado ✓');
  } catch(e) { alert('Error de red: ' + e.message); }
}

// ── Productos del catálogo propio (ABM) ─────────────
let _productosPropios = [];
let _prodImagenBase64 = null;

async function cargarProductosPropios(){
  const grid = document.getElementById('prodGrid');
  if (!grid) return;
  try {
    const r = await fetch('/catalogo/api/productos');
    if (!r.ok) return;
    _productosPropios = await r.json();
    renderProductosPropios();
  } catch(e) { /* silencioso */ }
}

function renderProductosPropios(){
  const grid = document.getElementById('prodGrid');
  const empty = document.getElementById('prodEmpty');
  if (!_productosPropios.length) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  grid.innerHTML = _productosPropios.map(p => `
    <div class="prod-card-admin">
      <div class="pimg">${p.imagen ? `<img src="${p.imagen}">` : '<i class="bi bi-box"></i>'}</div>
      <div class="pbody">
        <div class="pnombre">${p.nombre}</div>
        <div class="pcat">${p.categoria || 'Sin categoría'}</div>
        ${p.en_promo && p.precio_promo ? `<div class="pprecio tachado">$${Number(p.precio).toLocaleString('es-AR')}</div><div class="pprecio">$${Number(p.precio_promo).toLocaleString('es-AR')}</div>` : `<div class="pprecio">$${Number(p.precio || 0).toLocaleString('es-AR')}</div>`}
        <div class="pacciones">
          <button onclick="editarProductoPropio(${p.id})"><i class="bi bi-pencil"></i> Editar</button>
          <button class="del" onclick="borrarProductoPropio(${p.id})"><i class="bi bi-trash3"></i></button>
        </div>
      </div>
    </div>
  `).join('');
}

async function cargarCategoriasDatalist(){
  try {
    const r = await fetch('/catalogo/api/categorias');
    if (!r.ok) return;
    const cats = await r.json();
    document.getElementById('catList').innerHTML = cats.map(c => `<option value="${c}">`).join('');
  } catch(e) { /* silencioso */ }
}

function togglePromoField(){
  document.getElementById('campoPrecioPromo').style.display = document.getElementById('p_en_promo').checked ? 'block' : 'none';
}

function abrirModalProducto(){
  document.getElementById('pmodalTitulo').textContent = 'Nuevo producto';
  document.getElementById('p_id').value = '';
  document.getElementById('p_nombre').value = '';
  document.getElementById('p_categoria').value = '';
  document.getElementById('p_precio').value = '';
  document.getElementById('p_descripcion').value = '';
  document.getElementById('p_en_promo').checked = false;
  document.getElementById('p_precio_promo').value = '';
  document.getElementById('prodImgPreview').style.display = 'none';
  document.getElementById('prodLogoZoneTxt').style.display = 'block';
  _prodImagenBase64 = null;
  _galeriaImagenes = [];
  renderGaleria();
  togglePromoField();
  cargarCategoriasDatalist();
  document.getElementById('pmodalOverlay').classList.add('show');
}

function editarProductoPropio(id){
  const p = _productosPropios.find(x => x.id === id);
  if (!p) return;
  document.getElementById('pmodalTitulo').textContent = 'Editar producto';
  document.getElementById('p_id').value = p.id;
  document.getElementById('p_nombre').value = p.nombre || '';
  document.getElementById('p_categoria').value = p.categoria || '';
  document.getElementById('p_precio').value = p.precio || '';
  document.getElementById('p_descripcion').value = p.descripcion || '';
  document.getElementById('p_en_promo').checked = !!p.en_promo;
  document.getElementById('p_precio_promo').value = p.precio_promo || '';
  if (p.imagen) { document.getElementById('prodImgPreview').src = p.imagen; document.getElementById('prodImgPreview').style.display = 'block'; document.getElementById('prodLogoZoneTxt').style.display = 'none'; }
  else { document.getElementById('prodImgPreview').style.display = 'none'; document.getElementById('prodLogoZoneTxt').style.display = 'block'; }
  _prodImagenBase64 = null;
  _galeriaImagenes = Array.isArray(p.imagenes) ? [...p.imagenes] : [];
  renderGaleria();
  togglePromoField();
  cargarCategoriasDatalist();
  document.getElementById('pmodalOverlay').classList.add('show');
}

// ── Galería de fotos adicionales por producto ───────
let _galeriaImagenes = [];

function renderGaleria(){
  const grid = document.getElementById('galeriaGrid');
  if (!grid) return;
  grid.innerHTML = _galeriaImagenes.map((img, i) => `
    <div style="position:relative;aspect-ratio:1/1;border-radius:8px;overflow:hidden;border:1px solid var(--border-color);">
      <img src="${img}" style="width:100%;height:100%;object-fit:cover;">
      <button type="button" onclick="quitarFotoGaleria(${i})" style="position:absolute;top:2px;right:2px;width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,.6);color:#fff;border:none;font-size:11px;cursor:pointer;line-height:1;">✕</button>
    </div>
  `).join('');
}

function quitarFotoGaleria(i){ _galeriaImagenes.splice(i, 1); renderGaleria(); }

document.getElementById('p_galeria_file')?.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  if (_galeriaImagenes.length >= 5) { alert('Máximo 5 fotos adicionales.'); e.target.value = ''; return; }
  redimensionarImagen(file, 900, (dataUrl) => {
    _galeriaImagenes.push(dataUrl);
    renderGaleria();
    e.target.value = '';
  });
});

function cerrarModalProducto(){ document.getElementById('pmodalOverlay').classList.remove('show'); }

document.getElementById('prodLogoZone')?.addEventListener('click', () => document.getElementById('p_imagen_file').click());
document.getElementById('p_imagen_file')?.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  redimensionarImagen(file, 800, (dataUrl) => {
    _prodImagenBase64 = dataUrl;
    document.getElementById('prodImgPreview').src = dataUrl;
    document.getElementById('prodImgPreview').style.display = 'block';
    document.getElementById('prodLogoZoneTxt').style.display = 'none';
  });
});

async function guardarProductoPropio(){
  const id = document.getElementById('p_id').value;
  const nombre = document.getElementById('p_nombre').value.trim();
  if (!nombre) { alert('El nombre es obligatorio.'); return; }
  const body = {
    nombre,
    categoria: document.getElementById('p_categoria').value.trim() || null,
    precio: parseFloat(document.getElementById('p_precio').value) || 0,
    descripcion: document.getElementById('p_descripcion').value.trim() || null,
    en_promo: document.getElementById('p_en_promo').checked ? 1 : 0,
    precio_promo: document.getElementById('p_en_promo').checked ? (parseFloat(document.getElementById('p_precio_promo').value) || null) : null,
    imagenes: _galeriaImagenes,
  };
  if (_prodImagenBase64) body.imagen = _prodImagenBase64;
  try {
    let r;
    if (id) r = await fetch('/catalogo/api/productos/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    else    r = await fetch('/catalogo/api/productos', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (!r.ok) { const e = await r.json().catch(()=>({})); alert('Error: ' + (e.error || r.status)); return; }
    cerrarModalProducto();
    await cargarProductosPropios();
    mostrarToast('Producto guardado ✓');
  } catch(e) { alert('Error de red: ' + e.message); }
}

async function borrarProductoPropio(id){
  if (!confirm('¿Eliminar este producto del catálogo?')) return;
  try {
    const r = await fetch('/catalogo/api/productos/' + id, { method:'DELETE' });
    if (!r.ok) { alert('No se pudo eliminar.'); return; }
    await cargarProductosPropios();
    mostrarToast('Producto eliminado');
  } catch(e) { alert('Error de red: ' + e.message); }
}

cargarProductosPropios();

// ── Banners promocionales ───────────────────────────
let _banners = [];

async function cargarBanners(){
  const grid = document.getElementById('bannerGrid');
  if (!grid) return;
  try {
    const r = await fetch('/catalogo/api/banners');
    if (!r.ok) return;
    _banners = await r.json();
    renderBanners();
  } catch(e) { /* silencioso */ }
}

function renderBanners(){
  const grid = document.getElementById('bannerGrid');
  const empty = document.getElementById('bannerEmpty');
  if (!_banners.length) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  grid.innerHTML = _banners.map(b => `
    <div class="prod-card-admin">
      <div class="pimg"><img src="${b.imagen}"></div>
      <div class="pbody">
        <div class="pacciones"><button class="del" onclick="borrarBanner(${b.id})" style="flex:1;"><i class="bi bi-trash3"></i> Eliminar</button></div>
      </div>
    </div>
  `).join('');
}

document.getElementById('banner_file')?.addEventListener('change', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  if (_banners.length >= 6) { alert('Máximo 6 imágenes en el banner.'); e.target.value = ''; return; }
  redimensionarImagen(file, 1200, async (dataUrl) => {
    try {
      const r = await fetch('/catalogo/api/banners', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ imagen: dataUrl }) });
      if (!r.ok) { alert('No se pudo guardar la imagen.'); return; }
      await cargarBanners();
      mostrarToast('Imagen agregada ✓');
    } catch(err) { alert('Error de red: ' + err.message); }
    e.target.value = '';
  });
});

async function borrarBanner(id){
  if (!confirm('¿Eliminar esta imagen del banner?')) return;
  try {
    const r = await fetch('/catalogo/api/banners/' + id, { method:'DELETE' });
    if (!r.ok) { alert('No se pudo eliminar.'); return; }
    await cargarBanners();
    mostrarToast('Imagen eliminada');
  } catch(e) { alert('Error de red: ' + e.message); }
}

cargarBanners();
</script>
