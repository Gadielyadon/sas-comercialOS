<%- include('../partials/head', { title: 'Catálogo' }) %>

<style>
  .main-content { min-height: 100vh; display: flex; flex-direction: column; padding-top: var(--header-height); background: var(--bg-surface-2); }
  .page-body { flex: 1; padding: 24px 28px; width: 100%; max-width: 1400px; margin: 0 auto; }
  .cat-sections-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
  @media (max-width: 1024px) { .cat-sections-grid { grid-template-columns: 1fr; } }

  /* ── Pantalla bloqueada ── */
  .lock-wrap { display: flex; align-items: center; justify-content: center; min-height: 60vh; }
  .lock-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg);
    padding: 40px 32px; text-align: center; max-width: 400px; box-shadow: var(--shadow-sm); }
  .lock-icon { width: 62px; height: 62px; border-radius: 16px; background: linear-gradient(135deg,#8b5cf6,#6d28d9);
    display: flex; align-items: center; justify-content: center; font-size: 28px; color: #fff; margin: 0 auto 18px; }
  .lock-card h2 { font-size: 17px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px; }
  .lock-card p { font-size: 13.5px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 22px; }
  .lock-card input { width: 100%; text-align: center; letter-spacing: 2px; font-weight: 700; padding: 12px;
    border-radius: 10px; border: 1.5px solid var(--border-color); background: var(--bg-surface-2); color: var(--text-primary);
    font-size: 15px; margin-bottom: 12px; }
  .lock-card button { width: 100%; background: var(--color-primary); color: #fff; border: none; border-radius: 10px;
    padding: 12px; font-size: 14px; font-weight: 700; cursor: pointer; }
  .lock-err { color: #ef4444; font-size: 13px; font-weight: 600; margin-top: 10px; display: none; }

  /* ── Panel de administración (ya activado) ── */
  .cat-section { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg);
    overflow: hidden; margin-bottom: 20px; box-shadow: var(--shadow-sm); }
  .cat-section-header { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border-color); background: var(--bg-surface-2); }
  .cat-section-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #fff; flex-shrink: 0; background: linear-gradient(135deg,#25D366,#0F6E56); }
  .cat-section-title { font-size: 15.5px; font-weight: 700; color: var(--text-primary); flex: 1; }
  .cat-section-body { padding: 20px; }

  .cat-row-toggle { display: flex; align-items: center; justify-content: space-between; padding: 13px 0; border-bottom: 1px solid var(--border-color); }
  .cat-row-toggle:last-child { border-bottom: none; }
  .cat-row-toggle .lbl { font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .cat-row-toggle .desc { font-size: 12.5px; color: var(--text-secondary); margin-top: 2px; }
  .cat-switch { position: relative; width: 42px; height: 23px; flex-shrink: 0; }
  .cat-switch input { opacity: 0; width: 0; height: 0; }
  .cat-switch .slider { position: absolute; inset: 0; background: var(--border-color); border-radius: 12px; cursor: pointer; transition: .2s; }
  .cat-switch .slider::before { content: ''; position: absolute; width: 17px; height: 17px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
  .cat-switch input:checked + .slider { background: #25D366; }
  .cat-switch input:checked + .slider::before { transform: translateX(19px); }

  .cat-field { margin-bottom: 16px; }
  .cat-field label { display: block; font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); margin-bottom: 6px; }
  .cat-field input, .cat-field textarea { width: 100%; padding: 10px 12px; border-radius: 9px; border: 1.5px solid var(--border-color);
    background: var(--bg-surface-2); color: var(--text-primary); font-size: 14px; font-family: inherit; }
  .cat-field textarea { resize: vertical; min-height: 60px; }

  .cat-logo-zone { border: 2px dashed var(--border-color); border-radius: 12px; padding: 18px; text-align: center; cursor: pointer; }
  .cat-logo-zone img { max-height: 130px; border-radius: 8px; margin-bottom: 8px; }
  .cat-logo-zone.small { padding: 10px; }
  .cat-logo-zone.small img { max-height: 90px; }

  .cat-url-box { display: flex; align-items: center; gap: 8px; background: var(--bg-surface-2); border: 1.5px solid var(--border-color);
    border-radius: 10px; padding: 10px 14px; font-size: 13.5px; color: var(--text-primary); font-weight: 600; }
  .cat-url-box input { flex: 1; border: none; background: transparent; color: var(--text-primary); font-size: 13.5px; font-weight: 600; }
  .cat-url-box button { background: var(--color-primary); color: #fff; border: none; border-radius: 8px; padding: 7px 12px; font-size: 12.5px; font-weight: 700; cursor: pointer; flex-shrink: 0; }

  .btn-guardar { background: var(--color-primary); color: #fff; border: none; border-radius: 10px; padding: 12px 22px;
    font-size: 14px; font-weight: 700; cursor: pointer; }
  .toast-ok { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #0F6E56; color: #fff;
    padding: 10px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 700; display: none; z-index: 999; }

  /* Origen: 2 tarjetas elegibles */
  .origen-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  @media (max-width: 900px) { .origen-grid { grid-template-columns: 1fr; } }
  .origen-card { border: 2px solid var(--border-color); border-radius: 12px; padding: 14px; cursor: pointer; transition: all .15s; }
  .origen-card.selected { border-color: var(--color-primary); background: rgba(27,79,216,.06); }
  .origen-card .oc-title { font-size: 13.5px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 7px; margin-bottom: 4px; }
  .origen-card .oc-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.4; }

  /* Productos del catálogo propio */
  .prod-toolbar { display: flex; justify-content: flex-end; margin-bottom: 14px; }
  .btn-nuevo-prod { background: var(--color-primary); color: #fff; border: none; border-radius: 9px; padding: 9px 16px; font-size: 13.5px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .prod-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .prod-card-admin { background: var(--bg-surface-2); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; }
  .prod-card-admin .pimg { width: 100%; aspect-ratio: 1.4/1; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .prod-card-admin .pimg img { width: 100%; height: 100%; object-fit: cover; }
  .prod-card-admin .pimg i { font-size: 24px; opacity: .3; }
  .prod-card-admin .pbody { padding: 10px 12px; }
  .prod-card-admin .pnombre { font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .prod-card-admin .pcat { font-size: 11.5px; color: var(--text-secondary); margin-bottom: 6px; }
  .prod-card-admin .pprecio { font-size: 14px; font-weight: 800; color: var(--color-primary); }
  .prod-card-admin .pprecio.tachado { text-decoration: line-through; color: var(--text-secondary); font-size: 12px; font-weight: 600; }
  .prod-card-admin .pacciones { display: flex; gap: 6px; margin-top: 8px; }
  .prod-card-admin .pacciones button { flex: 1; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-primary); border-radius: 7px; padding: 6px; font-size: 12px; cursor: pointer; }
  .prod-card-admin .pacciones button.del { color: #ef4444; }
  .prod-empty { text-align: center; padding: 40px 20px; color: var(--text-secondary); font-size: 13.5px; }

  /* Modal producto */
  .pmodal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 200; display: none; align-items: center; justify-content: center; padding: 16px; }
  .pmodal-overlay.show { display: flex; }
  .pmodal { background: var(--bg-surface); border-radius: 16px; width: 100%; max-width: 440px; max-height: 88vh; overflow-y: auto; border: 1px solid var(--border-color); }
  .pmodal-head { padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; }
  .pmodal-head h3 { font-size: 15.5px; font-weight: 800; color: var(--text-primary); }
  .pmodal-head button { background: none; border: none; color: var(--text-secondary); font-size: 20px; cursor: pointer; }
  .pmodal-body { padding: 18px 20px; }
  .pmodal-foot { padding: 14px 20px 20px; }
  .pmodal-foot button { width: 100%; background: var(--color-primary); color: #fff; border: none; border-radius: 10px; padding: 12px; font-size: 14px; font-weight: 700; cursor: pointer; }
</style>

<div class="app-wrapper">
  <%- include('../partials/sidebar', { active: 'catalogo', user }) %>
  <div class="main-content">
    <%- include('../partials/header', { module: 'Catálogo', user }) %>
    <div class="page-body">

      <% if (!activada) { %>
        <div class="lock-wrap">
          <div class="lock-card">
            <div class="lock-icon"><i class="bi bi-shop-window"></i></div>
            <h2>Esta opción no está disponible</h2>
            <p>El catálogo digital es una función adicional. Contactate con tu operador para activarla, o ingresá la clave de activación si ya la tenés.</p>
            <input type="text" id="claveInput" placeholder="Clave de activación">
            <button onclick="activar()">Activar</button>
            <div class="lock-err" id="lockErr">Clave incorrecta.</div>
          </div>
        </div>
      <% } else { %>

