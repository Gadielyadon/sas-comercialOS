<%- include('../partials/head', { title }) %>

<style>
  .rem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 900px) { .rem-grid { grid-template-columns: 1fr; } }

  .rem-field label { font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); display: block; margin-bottom: 5px; }
  .rem-field input, .rem-field textarea { width: 100%; }

  .item-row { display: grid; grid-template-columns: 1fr 90px 110px 36px; gap: 8px; align-items: center; margin-bottom: 8px; }
  .item-row input { padding: 8px 10px; font-size: 15px; }
  .item-row .btn-quitar { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 18px; }
  .item-row .btn-quitar:hover { color: #ef4444; }

  .buscador-prod { position: relative; margin-bottom: 10px; }
  .buscador-prod input { width: 100%; padding: 10px 14px 10px 36px; }
  .buscador-prod i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
  .resultados-prod { position: absolute; z-index: 20; width: 100%; max-height: 260px; overflow-y: auto; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: 0 12px 30px rgba(0,0,0,.2); margin-top: 4px; display: none; }
  .resultados-prod.open { display: block; }
  .resultado-item { padding: 9px 14px; cursor: pointer; font-size: 15px; display: flex; justify-content: space-between; }
  .resultado-item:hover { background: var(--bg-hover); }
  .resultado-item span { color: var(--text-muted); font-size: 13px; }

  .btn-cancel { padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: transparent; color: var(--text-secondary); font-size: 15.5px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
  .btn-save   { padding: 10px 24px; border-radius: var(--radius-sm); border: none; background: var(--color-primary); color: #fff; font-size: 15.5px; font-weight: 700; cursor: pointer; }
</style>

<div class="app-wrapper">
  <%- include('../partials/sidebar', { active: 'remitos', user }) %>
  <div class="main-content">
    <%- include('../partials/header', { module: 'Remitos', user }) %>
    <div class="page-body">

      <% if (datosIniciales) { %>
      <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:rgba(27,79,216,.06);border:1px solid rgba(27,79,216,.2);border-radius:10px;margin-bottom:16px;">
        <i class="bi bi-info-circle" style="color:var(--color-primary);font-size: 20.5px;"></i>
        <div style="font-size: 15px;color:var(--text-secondary);">
          Este remito se generó a partir del presupuesto <strong style="color:var(--color-primary)"><%= datosIniciales.presupuesto_numero %></strong> — revisá los datos y las cantidades antes de guardar.
        </div>
      </div>
      <% } %>

      <form method="POST" action="/remitos/crear" id="formRemito">
        <input type="hidden" name="presupuesto_id" value="<%= datosIniciales?.presupuesto_id || '' %>">
        <input type="hidden" name="items_json" id="items_json">

        <div class="ax-card" style="padding:20px;margin-bottom:16px;">
          <div style="font-size: 17px;font-weight:700;color:var(--text-primary);margin-bottom:14px;"><i class="bi bi-person" style="margin-right:6px;color:var(--color-primary);"></i>Datos del cliente</div>
          <div class="rem-grid">
            <div class="rem-field">
              <label>Nombre / Razón social</label>
              <input type="text" name="cliente_nombre" id="cliente_nombre" placeholder="Nombre del cliente" value="<%= datosIniciales?.cliente_nombre || '' %>" required>
            </div>
            <div class="rem-field">
              <label>CUIT / DNI</label>
              <input type="text" name="cliente_cuit" placeholder="20-12345678-9" value="<%= datosIniciales?.cliente_cuit || '' %>">
            </div>
            <div class="rem-field">
              <label>Dirección de entrega</label>
              <input type="text" name="cliente_direccion" placeholder="Calle y número" value="<%= datosIniciales?.cliente_direccion || '' %>">
            </div>
            <div class="rem-field">
              <label>Barrio</label>
              <input type="text" name="cliente_barrio" placeholder="Opcional" value="<%= datosIniciales?.cliente_barrio || '' %>">
            </div>
            <div class="rem-field">
              <label>Localidad</label>
              <input type="text" name="cliente_localidad" placeholder="Ej: San Fernando del Valle" value="<%= datosIniciales?.cliente_localidad || '' %>">
            </div>
            <div class="rem-field">
              <label>Teléfono</label>
              <input type="text" name="cliente_tel" placeholder="Opcional" value="<%= datosIniciales?.cliente_tel || '' %>">
            </div>
            <div class="rem-field">
              <label>I.V.A.</label>
              <% const _condCli = datosIniciales?.cliente_cond_iva || 'Consumidor Final'; %>
              <select name="cliente_cond_iva">
                <% ['Consumidor Final','Responsable Inscripto','Monotributista','Exento','No Responsable'].forEach(c => { %>
                <option value="<%= c %>" <%= _condCli === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
            <div class="rem-field">
              <label>Condición de venta</label>
              <% const _condVenta = datosIniciales?.condicion_venta || 'Contado'; %>
              <select name="condicion_venta">
                <% ['Contado','Cuenta corriente','Transferencia','Tarjeta','Cheque'].forEach(c => { %>
                <option value="<%= c %>" <%= _condVenta === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
            <div class="rem-field">
              <label>Vendedor</label>
              <input type="text" name="vendedor" placeholder="Opcional" value="<%= datosIniciales?.vendedor || (user?.name || '') %>">
            </div>
            <div class="rem-field">
              <label>Validez (días)</label>
              <input type="number" name="validez_dias" min="1" placeholder="Ej: 1" value="<%= datosIniciales?.validez_dias || '' %>">
            </div>
          </div>
        </div>

        <div class="ax-card" style="padding:20px;margin-bottom:16px;">
          <div style="font-size: 17px;font-weight:700;color:var(--text-primary);margin-bottom:14px;"><i class="bi bi-box-seam" style="margin-right:6px;color:var(--color-primary);"></i>Mercadería a entregar</div>

          <div class="buscador-prod">
            <i class="bi bi-search"></i>
            <input type="text" id="buscarProducto" placeholder="Buscar producto por nombre o SKU para agregarlo..." autocomplete="off">
            <div class="resultados-prod" id="resultadosProd"></div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 90px 110px 36px;gap:8px;padding:0 0 6px;font-size: 12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);">
            <span>Descripción</span><span>Cantidad</span><span>Unidad</span><span></span>
          </div>
          <div id="itemsWrap"></div>

          <button type="button" onclick="agregarItemManual()" style="margin-top:8px;display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px dashed var(--border-color);background:transparent;color:var(--text-secondary);font-size: 14px;font-weight:600;cursor:pointer;">
            <i class="bi bi-plus-lg"></i> Agregar ítem libre (sin buscar del inventario)
          </button>
        </div>

        <div class="ax-card" style="padding:20px;margin-bottom:20px;">
          <div class="rem-field">
            <label>Notas / observaciones (opcional)</label>
            <textarea name="notas" rows="3" placeholder="Ej: entregar en horario de mañana, dejar en depósito, etc."></textarea>
          </div>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;">
          <a href="/remitos" class="btn-cancel">Cancelar</a>
          <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Generar remito</button>
        </div>
      </form>

    </div>
  </div>
</div>

<%- include('../partials/scripts') %>
<script>
const PRODUCTOS = <%- JSON.stringify((productos || []).map(p => ({ sku: p.sku, name: p.name }))) %>;
let itemSeq = 0;

function filaItem(nombre = '', descripcion = '', cantidad = 1, unidad = 'unidad', sku = '') {
  itemSeq++;
  const div = document.createElement('div');
  div.className = 'item-row';
  div.dataset.id = itemSeq;
  div.innerHTML = `
    <input type="text" class="it-nombre" placeholder="Descripción del producto" value="${nombre.replace(/"/g,'&quot;')}">
    <input type="number" class="it-cantidad" min="0.01" step="0.01" value="${cantidad}">
    <input type="text" class="it-unidad" placeholder="unidad" value="${unidad}">
    <button type="button" class="btn-quitar" onclick="this.closest('.item-row').remove()"><i class="bi bi-trash"></i></button>
  `;
  div.dataset.sku = sku;
  return div;
}

function agregarItemManual() {
  document.getElementById('itemsWrap').appendChild(filaItem());
}

function agregarProducto(p) {
  document.getElementById('itemsWrap').appendChild(filaItem(p.name, '', 1, 'unidad', p.sku));
  document.getElementById('buscarProducto').value = '';
  document.getElementById('resultadosProd').classList.remove('open');
}

document.getElementById('buscarProducto').addEventListener('input', function() {
  const q = this.value.trim().toLowerCase();
  const cont = document.getElementById('resultadosProd');
  if (!q) { cont.classList.remove('open'); cont.innerHTML = ''; return; }
  const matches = PRODUCTOS.filter(p => p.name.toLowerCase().includes(q) || (p.sku||'').toLowerCase().includes(q)).slice(0, 12);
  if (!matches.length) { cont.innerHTML = '<div class="resultado-item" style="color:var(--text-muted);">Sin resultados</div>'; cont.classList.add('open'); return; }
  cont.innerHTML = matches.map(p => `<div class="resultado-item" onclick='agregarProducto(${JSON.stringify(p)})'><span>${p.name}</span><span>${p.sku||''}</span></div>`).join('');
  cont.classList.add('open');
});

document.addEventListener('click', e => {
  if (!e.target.closest('.buscador-prod')) document.getElementById('resultadosProd').classList.remove('open');
});

document.getElementById('formRemito').addEventListener('submit', function(e) {
  const filas = [...document.querySelectorAll('#itemsWrap .item-row')];
  const items = filas.map(f => ({
    sku: f.dataset.sku || null,
    nombre: f.querySelector('.it-nombre').value.trim(),
    cantidad: parseFloat(f.querySelector('.it-cantidad').value) || 1,
    unidad: f.querySelector('.it-unidad').value.trim() || 'unidad',
  })).filter(it => it.nombre);

  if (!items.length) {
    e.preventDefault();
    alert('Agregá al menos un ítem para el remito.');
    return;
  }
  document.getElementById('items_json').value = JSON.stringify(items);
});

// Prellenar ítems si viene de un presupuesto
<% if (datosIniciales && datosIniciales.items && datosIniciales.items.length) { %>
  const itemsIniciales = <%- JSON.stringify(datosIniciales.items) %>;
  itemsIniciales.forEach(it => {
    document.getElementById('itemsWrap').appendChild(filaItem(it.nombre, it.descripcion || '', it.cantidad || 1, it.unidad || 'unidad', it.sku || ''));
  });
<% } else { %>
  agregarItemManual();
<% } %>
</script>
