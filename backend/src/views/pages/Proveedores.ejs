// CONTROL DE PAGOS POR PROVEEDOR
// ══════════════════════════════════════════════════════════════
let _pagoCtrlId     = null;
let _pagoCtrlSaldo  = 0;
const fmtCtrl = n => '$' + Number(n||0).toLocaleString('es-AR',{minimumFractionDigits:2});

async function verPagosProveedor(id, nombre, saldo) {
  _pagoCtrlId   = id;
  _pagoCtrlSaldo = 0; // se recalcula desde movimientos
  document.getElementById('pagosCtrlNombre').textContent = nombre;
  document.getElementById('pagoCtrlMonto').value  = '';
  document.getElementById('pagoCtrlFecha').value  = window.hoyLocal();
  document.getElementById('pagoCtrlDesc').value   = '';
  document.getElementById('pagoCtrlError').style.display = 'none';
  const metodoEl = document.getElementById('pagoCtrlMetodo');
  if (metodoEl) metodoEl.value = '';
  document.getElementById('pagosCtrlHistorial').innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:20px;">Cargando…</p>';
  document.getElementById('modalPagosCtrl').classList.add('open');
  try {
    const r    = await fetch(`/proveedores/api/${id}/movs`);
    const movs = await r.json();
    const facturado = movs.filter(m=>m.tipo==='factura').reduce((s,m)=>s+Number(m.monto),0);
    const pagado    = movs.filter(m=>m.tipo==='pago').   reduce((s,m)=>s+Number(m.monto),0);
    const deudaReal = Math.max(0, facturado - pagado);
    _pagoCtrlSaldo  = deudaReal;
    document.getElementById('pagosCtrlDeuda').textContent     = fmtCtrl(deudaReal);
    document.getElementById('pagosCtrlFacturado').textContent = fmtCtrl(facturado);
    document.getElementById('pagosCtrlPagado').textContent    = fmtCtrl(pagado);
    if (!movs.length) {
      document.getElementById('pagosCtrlHistorial').innerHTML =
        '<div style="text-align:center;padding:24px;color:var(--text-secondary);">Sin movimientos. Cargá una factura primero.</div>';
      return;
    }
    document.getElementById('pagosCtrlHistorial').innerHTML = movs.map(m => {
      const esFact = m.tipo === 'factura';
      const color  = esFact ? '#dc2626' : '#059669';
      const bg     = esFact ? 'rgba(239,68,68,.06)' : 'rgba(16,185,129,.06)';
      const borde  = esFact ? 'rgba(239,68,68,.15)' : 'rgba(16,185,129,.15)';
      const signo  = esFact ? '+' : '−';
      const icono  = esFact ? 'bi-receipt' : 'bi-cash-stack';
      const fecha  = (m.created_at||'').slice(0,10).split('-').reverse().join('/');
      const saldoPost = Math.max(0, Number(m.saldo_post));
      return `<div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:${bg};border-radius:8px;border:1px solid ${borde};">
        <i class="bi ${icono}" style="font-size: 20.5px;color:${color};flex-shrink:0;"></i>
        <div style="flex:1;min-width:0;">
          <div style="font-size: 15px;font-weight:700;color:var(--text-primary);">${m.descripcion||m.tipo}${m.nro_factura?' <span style="font-size: 12px;font-family:var(--font-mono);color:var(--text-secondary);">#'+m.nro_factura+'</span>':''}</div>
          <div style="font-size: 12.5px;color:var(--text-secondary);margin-top:1px;">${fecha} · Saldo: ${fmtCtrl(saldoPost)}</div>
        </div>
        <div style="font-family:var(--font-mono);font-size: 18px;font-weight:900;color:${color};flex-shrink:0;">${signo}${fmtCtrl(m.monto)}</div>
      </div>`;
    }).join('');
  } catch(e) {
    document.getElementById('pagosCtrlHistorial').innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">Error al cargar</p>';
  }
}

function cerrarPagosCtrl() { document.getElementById('modalPagosCtrl').classList.remove('open'); }

function pagarTodoCtrl() {
  document.getElementById('pagoCtrlMonto').value = _pagoCtrlSaldo.toFixed(2).replace('.',',');
}

async function confirmarPagoCtrl() {
  const errEl  = document.getElementById('pagoCtrlError');
  errEl.style.display = 'none';
  const monto  = parseFloat(document.getElementById('pagoCtrlMonto').value.replace(/\./g,'').replace(',','.'));
  const fecha  = document.getElementById('pagoCtrlFecha').value;
  const desc   = document.getElementById('pagoCtrlDesc').value.trim();
  const metodo = document.getElementById('pagoCtrlMetodo') ? document.getElementById('pagoCtrlMetodo').value : '';
  if (!monto || monto <= 0) { errEl.textContent = 'Ingresá un monto válido'; errEl.style.display='block'; return; }
  // No permitir pagar más de la deuda actual
  if (_pagoCtrlSaldo > 0 && monto > _pagoCtrlSaldo) {
    errEl.textContent = `El monto (${fmtCtrl(monto)}) supera la deuda actual (${fmtCtrl(_pagoCtrlSaldo)}). Usá "Todo" para saldar exacto.`;
    errEl.style.display = 'block';
    return;
  }
  const descripcion = [desc, metodo].filter(Boolean).join(' · ') || `Pago ${fecha}`;
  try {
    const r = await fetch(`/proveedores/api/${_pagoCtrlId}/pago`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ monto, descripcion }),
    });
    if (!r.ok) { const e=await r.json().catch(()=>({})); errEl.textContent=e.error||'Error'; errEl.style.display='block'; return; }
    document.getElementById('pagoCtrlMonto').value = '';
    document.getElementById('pagoCtrlDesc').value  = '';
    if (document.getElementById('pagoCtrlMetodo')) document.getElementById('pagoCtrlMetodo').value = '';
    // Recargar historial sin cerrar
    await verPagosProveedor(_pagoCtrlId, document.getElementById('pagosCtrlNombre').textContent, 0);
  } catch(e) { errEl.textContent='Error de conexión'; errEl.style.display='block'; }
}

