// PEDIDOS DEL PROVEEDOR
// ══════════════════════════════════════════════════════════════
let _pedProvId = null;
let _pedActual = null;
const fmtPP = n => '$' + Number(n||0).toLocaleString('es-AR',{minimumFractionDigits:2});

async function verPedidosProveedor(id, nombre) {
  _pedProvId = id;
  document.getElementById('pedProvNombre').textContent = nombre;
  document.getElementById('pedProvListado').innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:32px;">Cargando…</p>';
  document.getElementById('modalPedidosProv').classList.add('open');
  try {
    const r = await fetch(`/pedidos/api?tipo=pedido&proveedor_id=${id}`);
    const todos = await r.json();
    const pedidos = todos.filter(p => p.proveedor_id == id && p.estado_recepcion && p.estado_recepcion !== 'recibido');
    if (!pedidos.length) {
      document.getElementById('pedProvListado').innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-secondary);">Sin pedidos pendientes de recepción.</div>';
      return;
    }
    const pedidosConItems = await Promise.all(pedidos.map(async p => {
      const ri = await fetch(`/pedidos/api/${p.id}/items`);
      return { ...p, items: await ri.json() };
    }));
    renderPedidosProv(pedidosConItems);
  } catch(e) {
    document.getElementById('pedProvListado').innerHTML = '<p style="color:#dc2626;text-align:center;padding:20px;">Error al cargar pedidos.</p>';
  }
}

function renderPedidosProv(pedidos) {
  const html = pedidos.map(p => {
    const badgeTxt = p.estado_recepcion === 'enviado' ? 'Enviado' : 'Parcialmente recibido';
    const totalPed = (p.items||[]).reduce((s,i)=>s+(Number(i.cantidad)*Number(i.precio_costo||0)),0);
    const totalFmt = fmtPP(totalPed);
    const sinCosto = totalPed === 0 && p.items && p.items.length > 0;
    const pid = p.id;
    return `
    <div style="border:1px solid var(--border-color);border-radius:12px;overflow:hidden;margin-bottom:14px;">

      <!-- ── Cabecera del pedido (clickeable: abre/cierra la tabla) ── -->
      <div onclick="togglePedidoProv(${pid})" style="cursor:pointer;user-select:none;display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg-surface-2);flex-wrap:wrap;gap:8px;">
        <div style="display:flex;align-items:center;gap:10px;min-width:0;">
          <span id="pedProvChevron-${pid}" style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;color:var(--text-secondary);transition:transform .18s;flex-shrink:0;"><i class="bi bi-chevron-right"></i></span>
          <div style="min-width:0;">
            <div style="font-weight:800;font-size: 16px;color:var(--text-primary);">${p.titulo}</div>
            <div style="font-size: 12.5px;color:var(--text-secondary);margin-top:2px;">${new Date(p.created_at).toLocaleDateString('es-AR')} · ${p.items.length} producto${p.items.length!==1?'s':''}</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          ${sinCosto
            ? '<span style="font-size: 12.5px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(245,158,11,.12);color:#d97706;display:inline-flex;align-items:center;gap:4px;"><i class=\"bi bi-exclamation-triangle\"></i> Sin precio de costo</span>'
            : '<span style="font-size: 15px;font-weight:800;color:var(--text-primary);font-family:var(--font-mono);">' + totalFmt + '</span>'
          }
          <span style="font-size: 12.5px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(99,102,241,.1);color:#6366f1;">${badgeTxt}</span>
          <button onclick="event.stopPropagation();abrirConfRecepcion(${JSON.stringify(p).replace(/"/g,'&quot;')})"
            style="padding:6px 11px;background:linear-gradient(135deg,#059669,#047857);color:#fff;border:none;border-radius:8px;font-size: 12.5px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
            <i class="bi bi-box-arrow-in-down"></i> Recepcionar
          </button>
        </div>
      </div>

      <!-- ── Tabla de productos (colapsada por defecto) ── -->
      <div id="pedProvItems-${pid}" style="display:none;max-height:340px;overflow-y:auto;">
      <table style="width:100%;border-collapse:collapse;font-size: 14px;">
        <thead><tr style="background:var(--bg-surface-2);border-bottom:1px solid var(--border-color);position:sticky;top:0;">
          <th style="padding:7px 14px;text-align:left;font-size: 12px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);">Producto</th>
          <th style="padding:7px 14px;text-align:center;font-size: 12px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);width:80px;">Pedido</th>
          <th style="padding:7px 14px;text-align:right;font-size: 12px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);width:110px;">P. Costo</th>
          <th style="padding:7px 14px;text-align:center;font-size: 12px;font-weight:700;text-transform:uppercase;color:var(--text-secondary);width:90px;">Estado</th>
        </tr></thead>
        <tbody>${p.items.map(i => `
          <tr style="border-bottom:1px solid var(--border-color);background:var(--bg-surface);">
            <td style="padding:8px 14px;font-weight:600;color:var(--text-primary);">${i.nombre}${i.es_manual?'<span style="font-size: 11.5px;background:rgba(245,158,11,.12);color:#d97706;padding:1px 5px;border-radius:4px;margin-left:6px;">Manual</span>':''}</td>
            <td style="padding:8px 14px;text-align:center;font-family:var(--font-mono);font-weight:700;color:var(--text-primary);">${i.cantidad}</td>
            <td style="padding:8px 14px;text-align:right;font-family:var(--font-mono);color:var(--text-secondary);">${i.precio_costo>0?fmtPP(i.precio_costo):'—'}</td>
            <td style="padding:8px 14px;text-align:center;">${i.recibido
              ?'<span style="font-size: 12.5px;font-weight:700;color:#059669;background:rgba(16,185,129,.1);padding:2px 8px;border-radius:20px;">✓ Recibido</span>'
              :'<span style="font-size: 12.5px;font-weight:700;color:#d97706;background:rgba(245,158,11,.1);padding:2px 8px;border-radius:20px;">Pendiente</span>'}
            </td>
          </tr>`).join('')}
        </tbody>
      </table>
      </div>

    </div>`; // fin tarjeta pedido
  }).join('');
  document.getElementById('pedProvListado').innerHTML = html;
}

function togglePedidoProv(pid) {
  const tabla    = document.getElementById('pedProvItems-' + pid);
  const chevron  = document.getElementById('pedProvChevron-' + pid);
  if (!tabla) return;
  const abierto = tabla.style.display !== 'none';
  tabla.style.display = abierto ? 'none' : 'block';
  if (chevron) chevron.style.transform = abierto ? 'rotate(0deg)' : 'rotate(90deg)';
}

function cerrarPedidosProv() { document.getElementById('modalPedidosProv').classList.remove('open'); }

