          <td style="padding:8px 12px;text-align:right;">
            <input type="number" id="recCosto-${i.id}" value="${i.precio_costo||0}" min="0" step="0.01"
              style="width:88px;padding:5px 7px;border:1.5px solid var(--border-color);border-radius:6px;background:var(--bg-body);color:var(--text-primary);font-family:var(--font-mono);font-size: 15px;text-align:right;outline:none;"
              onfocus="this.style.borderColor='#059669'" onblur="this.style.borderColor='var(--border-color)'">
          </td>
          <td style="padding:8px 12px;text-align:right;">
            <input type="number" id="recVenta-${i.id}" value="${i.precio_venta||i.precio_costo||0}" min="0" step="0.01"
              style="width:88px;padding:5px 7px;border:1.5px solid rgba(99,102,241,.3);border-radius:6px;background:var(--bg-body);color:#6366f1;font-family:var(--font-mono);font-size: 15px;font-weight:700;text-align:right;outline:none;"
              title="Precio de venta al público"
              onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='rgba(99,102,241,.3)'">
          </td>
        </tr>`).join('')}
      </tbody>
    </table></div>`;
  document.getElementById('confRecepItems').innerHTML = html;
  document.getElementById('modalPedidosProv').classList.remove('open');
  document.getElementById('modalConfRecepcion').classList.add('open');
}

function toggleRecItem(itemId) {
  const chk = document.getElementById('chk-'+itemId);
  const row = document.getElementById('recRow-'+itemId);
  if (row) row.style.opacity = chk.checked ? '1' : '.4';
}

function cerrarConfRecepcion() {
  document.getElementById('modalConfRecepcion').classList.remove('open');
  document.getElementById('modalPedidosProv').classList.add('open');
}

async function recibirTodo() {
  const items = _pedActual.items.filter(i => !i.recibido);
  const recepciones = items.map(i => ({
    item_id:           i.id,
    cantidad_recibida: i.cantidad,
    recibido:          true,
    precio_costo:      Number(document.getElementById('recCosto-'+i.id)?.value || i.precio_costo || 0),
    precio_venta:      Number(document.getElementById('recVenta-'+i.id)?.value || i.precio_venta || 0),
    crear_producto:    !i.sku,
    producto_nuevo:    !i.sku ? {
      sku:          document.getElementById('sku-'+i.id)?.value?.trim() || null,
      nombre:       i.nombre,
      precio_venta: Number(document.getElementById('recVenta-'+i.id)?.value || 0),
      precio_costo: Number(document.getElementById('recCosto-'+i.id)?.value || 0),
      categoria:    document.getElementById('cat-'+i.id)?.value?.trim() || '',
    } : null,
  }));
  await enviarRecepcion(recepciones);
}

async function confirmarRecepcionParcial() {
  const items = _pedActual.items.filter(i => !i.recibido);
  const recepciones = items.map(i => {
    const chk = document.getElementById('chk-'+i.id);
    const recibido = chk ? chk.checked : false;
    return {
      item_id:           i.id,
      cantidad_recibida: Number(document.getElementById('recCant-'+i.id)?.value || 0),
      recibido,
      precio_costo:      Number(document.getElementById('recCosto-'+i.id)?.value || i.precio_costo || 0),
      precio_venta:      Number(document.getElementById('recVenta-'+i.id)?.value || i.precio_venta || 0),
      crear_producto:    !i.sku && recibido,
      producto_nuevo:    !i.sku && recibido ? {
        sku:          document.getElementById('sku-'+i.id)?.value?.trim() || null,
        nombre:       i.nombre,
        precio_venta: Number(document.getElementById('recVenta-'+i.id)?.value || 0),
        precio_costo: Number(document.getElementById('recCosto-'+i.id)?.value || 0),
        categoria:    document.getElementById('cat-'+i.id)?.value?.trim() || '',
      } : null,
    };
  });
  await enviarRecepcion(recepciones);
}

async function enviarRecepcion(recepciones) {
  const errEl = document.getElementById('confRecepError');
  errEl.style.display = 'none';
  try {
    const r = await fetch(`/proveedores/api/pedido/${_pedActual.id}/recepcionar`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recepciones }),
    });
    const data = await r.json();
    if (!r.ok) { errEl.textContent = data.error || 'Error'; errEl.style.display='block'; return; }
    document.getElementById('modalConfRecepcion').classList.remove('open');
    location.reload();
  } catch(e) { errEl.textContent = 'Error de conexión'; errEl.style.display='block'; }
}

function exportarCSV(){
  const rows=[...document.querySelectorAll('#tablaProveedores tbody tr')].filter(r=>r.style.display!=='none');
  let csv='\uFEFFNombre;CUIT;Rubro;Teléfono;Saldo\n';
  rows.forEach(r=>{
    const t=r.querySelectorAll('td');
    csv+=[t[0]?.innerText.trim(),t[1]?.innerText,t[2]?.innerText,t[3]?.innerText,t[4]?.innerText.trim()].join(';')+'\n';
  });
  const a=Object.assign(document.createElement('a'),{href:URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'})),download:'proveedores.csv'});
  a.click();
}

document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    cerrarModal();
    cerrarCuenta();
    cerrarRecepcion();
    cerrarPedidosProv();
    cerrarPagosCtrl();
    document.getElementById('modalFactura').classList.remove('open');
    document.getElementById('modalPagoP').classList.remove('open');
  }
});

// ══════════════════════════════════════════════════════════════
// RECEPCIÓN DE MERCADERÍA
// ══════════════════════════════════════════════════════════════
let _recProvId = null;
let _recItems  = [];     // [{ sku, nombre, cantidad, precio_costo, actualizar_costo }]
let _recSearchT = null;  // debounce timer

const fmtRec = n => '$' + Number(n||0).toLocaleString('es-AR', {minimumFractionDigits:2});

function abrirRecepcion(id, nombre) {
  _recProvId = id;
  _recItems  = [];
  document.getElementById('recepProvNombre').textContent = nombre;
  document.getElementById('rec_nro').value   = '';
  document.getElementById('rec_desc').value  = '';
  document.getElementById('recBuscador').value = '';
  document.getElementById('recBuscadorDrop').style.display = 'none';
  document.getElementById('recError').style.display = 'none';
  renderRecItems();
  document.getElementById('modalRecepcion').classList.add('open');
  setTimeout(() => document.getElementById('rec_nro').focus(), 80);
}

function cerrarRecepcion() {
  document.getElementById('modalRecepcion').classList.remove('open');
}

// Buscador con debounce 200ms
function buscarProdRecepcion(q) {
  clearTimeout(_recSearchT);
  const drop = document.getElementById('recBuscadorDrop');
  if (!q || q.trim().length < 1) { drop.style.display = 'none'; return; }
  _recSearchT = setTimeout(async () => {
    try {
      const r = await fetch(`/proveedores/api/productos/buscar?q=${encodeURIComponent(q)}`);
      const data = await r.json();
      if (!data.length) { drop.style.display = 'none'; return; }
      drop.innerHTML = data.map(p => `
        <div onclick='agregarItemRecepcion(${JSON.stringify(p).replace(/'/g,"\\'")})'  
          style="padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--border-color);display:flex;justify-content:space-between;align-items:center;"
          onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
          <div>
            <div style="font-weight:700;font-size: 15px;color:var(--text-primary);">${p.name}</div>
            <div style="font-size: 12.5px;color:var(--text-secondary);">SKU: ${p.sku}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size: 13px;font-family:var(--font-mono);font-weight:700;color:var(--text-primary);">${fmtRec(p.price_cost)}</div>
            <div style="font-size: 12px;color:var(--text-secondary);">Stock: ${p.stock}</div>
          </div>
        </div>`).join('');
      drop.style.display = 'block';
    } catch(e) { console.error(e); }
  }, 200);
}

function agregarItemRecepcion(prod) {
  document.getElementById('recBuscador').value = '';
  document.getElementById('recBuscadorDrop').style.display = 'none';
  const existing = _recItems.find(i => i.sku === prod.sku);
  if (existing) {
    existing.cantidad++;
  } else {
    _recItems.push({
      sku:             prod.sku,
      nombre:          prod.name,
      cantidad:        1,
      precio_costo:    Number(prod.price_cost) || 0,
      actualizar_costo: false,
    });
  }
  renderRecItems();
  document.getElementById('recBuscador').focus();
}

function renderRecItems() {
  const tbody = document.getElementById('recItemsTbody');
  const vacio = document.getElementById('recItemsVacio');
  if (!_recItems.length) {
    tbody.innerHTML = '';
    tbody.appendChild(vacio);
    vacio.style.display = '';
    document.getElementById('recTotal').textContent = '$0,00';
    return;
  }
  vacio.style.display = 'none';
  tbody.innerHTML = _recItems.map((item, idx) => {
    const sub = item.cantidad * item.precio_costo;
    return `
    <tr style="border-bottom:1px solid var(--border-color);">
      <td style="padding:9px 14px;">
        <div style="font-weight:700;font-size: 15px;color:var(--text-primary);">${item.nombre}</div>
        <div style="font-size: 12.5px;color:var(--text-secondary);">SKU: ${item.sku}</div>
      </td>
      <td style="padding:6px 8px;text-align:center;">
        <input type="number" value="${item.cantidad}" min="0.001" step="0.001"
          style="width:76px;padding:6px 8px;border:1.5px solid var(--border-color);border-radius:6px;
                 background:var(--bg-body);color:var(--text-primary);font-family:var(--font-mono);
                 font-size: 15px;font-weight:700;text-align:center;outline:none;"
          oninput="updateRecItem(${idx},'cantidad',this.value)"
          onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='var(--border-color)'">
      </td>
      <td style="padding:6px 8px;">
        <div style="display:flex;align-items:center;justify-content:flex-end;gap:4px;">
          <span style="color:var(--text-secondary);font-size: 15px;">$</span>
          <input type="number" value="${item.precio_costo}" min="0" step="0.01"
            style="width:100px;padding:6px 8px;border:1.5px solid var(--border-color);border-radius:6px;
                   background:var(--bg-body);color:var(--text-primary);font-family:var(--font-mono);
                   font-size: 15px;font-weight:700;text-align:right;outline:none;"
            oninput="updateRecItem(${idx},'precio_costo',this.value)"
            onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='var(--border-color)'">
        </div>
      </td>
      <td style="padding:6px 8px;text-align:center;">
        <label style="display:flex;align-items:center;justify-content:center;gap:5px;cursor:pointer;" title="Actualizar precio de costo en inventario">
          <input type="checkbox" ${item.actualizar_costo?'checked':''}
            onchange="updateRecItem(${idx},'actualizar_costo',this.checked)"
            style="width:16px;height:16px;accent-color:#6366f1;cursor:pointer;">
          <span style="font-size: 12px;color:var(--text-secondary);">Actualizar</span>
        </label>
      </td>
      <td style="padding:9px 14px;text-align:right;font-family:var(--font-mono);font-size: 16px;font-weight:800;color:#6366f1;">
        ${fmtRec(sub)}
      </td>
      <td style="padding:4px 6px;text-align:center;">
        <button onclick="quitarItemRecepcion(${idx})"
          style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size: 19.5px;padding:4px;border-radius:6px;transition:.15s;"
          onmouseover="this.style.color=&quot;#ef4444&quot;" onmouseout="this.style.color=&quot;var(--text-secondary)&quot;">
          <i class="bi bi-x-circle"></i>
        </button>
      </td>
    </tr>`;
  }).join('');
  // Actualizar total
  const total = _recItems.reduce((s, i) => s + i.cantidad * i.precio_costo, 0);
  document.getElementById('recTotal').textContent = fmtRec(total);
}

function updateRecItem(idx, campo, valor) {
  if (campo === 'cantidad')        _recItems[idx].cantidad        = parseFloat(valor) || 0;
  if (campo === 'precio_costo')    _recItems[idx].precio_costo    = parseFloat(valor) || 0;
  if (campo === 'actualizar_costo') _recItems[idx].actualizar_costo = !!valor;
  // Recalcular total sin re-renderizar toda la tabla
  const total = _recItems.reduce((s, i) => s + i.cantidad * i.precio_costo, 0);
  document.getElementById('recTotal').textContent = fmtRec(total);
}

function quitarItemRecepcion(idx) {
  _recItems.splice(idx, 1);
  renderRecItems();
}

async function confirmarRecepcion() {
  const errEl = document.getElementById('recError');
  errEl.style.display = 'none';
  const itemsValidos = _recItems.filter(i => i.cantidad > 0);
  if (!itemsValidos.length) {
    errEl.textContent = 'Agregá al menos un producto con cantidad mayor a 0';
    errEl.style.display = 'block';
    return;
  }
  try {
    const r = await fetch(`/proveedores/api/${_recProvId}/recepcion`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        nro_factura:  document.getElementById('rec_nro').value.trim()  || null,
        descripcion:  document.getElementById('rec_desc').value.trim() || null,
        items: itemsValidos,
      }),
    });
    const data = await r.json();
    if (!r.ok) { errEl.textContent = data.error || 'Error al guardar'; errEl.style.display = 'block'; return; }
    cerrarRecepcion();
    location.reload();
  } catch(e) {
    errEl.textContent = 'Error de conexión';
    errEl.style.display = 'block';
  }
}

// Cerrar dropdown buscador al hacer click fuera
document.addEventListener('click', e => {
  if (!e.target.closest('#recBuscador') && !e.target.closest('#recBuscadorDrop')) {
    const drop = document.getElementById('recBuscadorDrop');
    if (drop) drop.style.display = 'none';
  }
});

</script>
