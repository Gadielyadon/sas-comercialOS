<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remito - <%= remito.numero %></title>
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      color: #111;
      font-size: 11.5px;
      line-height: 1.4;
      margin: 0;
      padding: 18px;
      background: #e9e9e9;
    }
    .doc {
      max-width: 760px;
      margin: 0 auto 24px;
      background: #fff;
      padding: 26px 30px;
      border: 1px solid #ddd;
    }

    /* ── Encabezado limpio, sin recuadro ── */
    .top-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
    .top-izq { display: flex; align-items: flex-start; gap: 10px; }
    .emp-logo { max-height: 34px; max-width: 100px; object-fit: contain; display: block; }
    .emp-nombre { font-size: 15px; font-weight: 800; color: #111; }
    .emp-tagline { font-size: 10px; color: #555; font-weight: 600; font-style: italic; }
    .emp-dato-row { font-size: 9.5px; color: #666; font-weight: 600; margin-top: 3px; }
    .top-der { text-align: right; }
    .doc-titulo { font-size: 18px; font-weight: 800; color: #111; margin-bottom: 1px; }
    .doc-nro { font-size: 11px; color: #555; font-weight: 700; }
    .doc-fecha { font-size: 10.5px; color: #555; font-weight: 600; margin-top: 2px; }
    .estado-badge {
      display: inline-block; margin-top: 4px; padding: 1px 8px; border: 1px solid #111;
      font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .3px; color: #111;
    }

    hr.sep { border: none; border-top: 1.5px solid #111; margin: 8px 0 14px; }
    hr.sep-liviano { border: none; border-top: 1px solid #ddd; margin: 14px 0; }

    /* ── Bloque Cliente / Datos, 2 columnas, sin caja ── */
    .info-grid { display: flex; gap: 24px; margin-bottom: 18px; }
    .info-col { flex: 1 1 0; min-width: 0; }
    .info-col h4 { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .4px; color: #111; margin-bottom: 6px; padding-bottom: 3px; border-bottom: 1px solid #111; }
    .info-line { display: flex; gap: 8px; margin-bottom: 3px; font-size: 11px; }
    .info-label { color: #777; font-weight: 700; width: 92px; flex-shrink: 0; }
    .info-val { color: #111; font-weight: 700; }
    .info-val.lg { font-size: 13px; font-weight: 800; }

    /* ── Tabla de items: sin grilla, estilo packing-slip ── */
    table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
    thead th {
      text-align: left; padding: 5px 6px; font-size: 9.5px; text-transform: uppercase; letter-spacing: .3px;
      color: #111; font-weight: 800; border-bottom: 1.5px solid #111;
    }
    th.center, td.center { text-align: center; }
    th.right, td.right { text-align: right; }
    th.desc, td.desc { text-align: center; }
    tbody td { padding: 5px 6px; border-bottom: 1px solid #e5e5e5; font-size: 11px; font-weight: 600; color: #111; }
    tbody tr:last-child td { border-bottom: 1.5px solid #111; }
    .item-desc-extra { font-size: 9.5px; color: #777; font-weight: 500; margin-top: 1px; }

    .notas { font-size: 10.5px; color: #444; font-weight: 600; margin-bottom: 16px; padding-top: 8px; border-top: 1px solid #ddd; }

    /* ── Firmas: en el flujo normal, sin caja, sin posición fija ── */
    .firmas { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 50px; page-break-inside: avoid; break-inside: avoid; }
    .firma-box { text-align: center; }
    .firma-linea { border-top: 1px solid #111; padding-top: 5px; margin-top: 36px; }
    .firma-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .3px; color: #111; }
    .firma-sub { font-size: 9.5px; color: #777; font-weight: 600; margin-top: 2px; }

    .toolbar { max-width: 760px; margin: 0 auto 14px; display: flex; justify-content: flex-end; gap: 10px; }
    .btn-print { padding: 10px 20px; background: #1B4FD8; color: #fff; border: none; border-radius: 4px; font-size: 15px; font-weight: 700; cursor: pointer; }

    tr { page-break-inside: avoid; break-inside: avoid; }
    thead { display: table-header-group; }

    @page { size: A4; margin: 14mm; }
    @media print {
      body { background: #fff; padding: 0; font-size: 10.5px; }
      .doc { border: none; padding: 0; max-width: 100%; }
      .toolbar { display: none; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button class="btn-print" onclick="window.print()">🖨️ Imprimir / Guardar PDF</button>
  </div>

  <div class="doc" id="doc">

    <%
      const afipOn      = String(config && config.facturacion_habilitada) === '1';
      const emisorCuit  = afipOn
        ? ((config && config.afip_cuit)    || (config && config.empresa_cuit) || '')
        : ((config && config.empresa_cuit) || (config && config.afip_cuit)    || '');
      const emisorInicio  = (config && config.empresa_inicio_actividades) || '';
      const emisorIibb    = (config && config.empresa_iibb) || '';
      const emisorCondIva = (config && config.empresa_cond_iva) || '';
    %>

    <div class="top-row">
      <div class="top-izq">
        <% if (config && config.empresa_logo) { %>
          <img src="<%= config.empresa_logo %>" class="emp-logo" alt="Logo">
        <% } %>
        <div>
          <div class="emp-nombre"><%= (config && config.empresa_nombre) || 'Mi Empresa' %></div>
          <% if (config && config.empresa_tagline) { %><div class="emp-tagline"><%= config.empresa_tagline %></div><% } %>
          <div class="emp-dato-row">
            <% const datosEmp = []; %>
            <% if (config && config.empresa_direccion) datosEmp.push(config.empresa_direccion); %>
            <% if (config && config.empresa_telefono) datosEmp.push('Tel: ' + config.empresa_telefono); %>
            <% if (emisorCondIva) datosEmp.push(emisorCondIva); %>
            <% if (emisorCuit) datosEmp.push('CUIT: ' + emisorCuit); %>
            <% if (emisorIibb) datosEmp.push('IIBB: ' + emisorIibb); %>
            <%= datosEmp.join('  ·  ') %>
          </div>
        </div>
      </div>
      <div class="top-der">
        <div class="doc-titulo">Remito <%= remito.numero %></div>
        <div class="doc-fecha">Fecha de emisión: <%= new Date(remito.created_at).toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }) %></div>
        <span class="estado-badge"><%= remito.estado %></span>
      </div>
    </div>
    <hr class="sep">

    <div class="info-grid">
      <div class="info-col">
        <h4>Cliente</h4>
        <div class="info-line"><span class="info-label">Nombre</span><span class="info-val lg"><%= remito.cliente_nombre || 'Consumidor Final' %></span></div>
        <div class="info-line"><span class="info-label">Dirección</span><span class="info-val"><%= remito.cliente_direccion || '—' %></span></div>
        <% if (remito.cliente_barrio) { %><div class="info-line"><span class="info-label">Barrio</span><span class="info-val"><%= remito.cliente_barrio %></span></div><% } %>
        <div class="info-line"><span class="info-label">Localidad</span><span class="info-val"><%= remito.cliente_localidad || '—' %></span></div>
        <% if (remito.cliente_tel) { %><div class="info-line"><span class="info-label">Teléfono</span><span class="info-val"><%= remito.cliente_tel %></span></div><% } %>
      </div>
      <div class="info-col">
        <h4>Datos del remito</h4>
        <div class="info-line"><span class="info-label">I.V.A.</span><span class="info-val"><%= remito.cliente_cond_iva || 'Consumidor Final' %></span></div>
        <div class="info-line"><span class="info-label">Cond. Venta</span><span class="info-val"><%= remito.condicion_venta || 'Contado' %></span></div>
        <% if (remito.validez_dias) {
             const vto = new Date(remito.created_at);
             vto.setDate(vto.getDate() + Number(remito.validez_dias));
        %>
          <div class="info-line"><span class="info-label">Fecha Vto.</span><span class="info-val"><%= vto.toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' }) %></span></div>
        <% } %>
        <% if (remito.vendedor) { %><div class="info-line"><span class="info-label">Vendedor</span><span class="info-val"><%= remito.vendedor %></span></div><% } %>
        <% if (remito.presupuesto) { %><div class="info-line"><span class="info-label">Presupuesto</span><span class="info-val"><%= remito.presupuesto.numero %></span></div><% } %>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th class="center" style="width:70px;">Cant.</th>
          <th class="desc">Descripción</th>
          <th class="right" style="width:110px;">Cód. Artículo</th>
        </tr>
      </thead>
      <tbody>
        <% remito.items.forEach(item => { %>
        <tr>
          <td class="center"><%= item.cantidad %></td>
          <td class="desc">
            <%= item.nombre %>
            <% if (item.descripcion) { %><div class="item-desc-extra"><%= item.descripcion %></div><% } %>
          </td>
          <td class="right"><%= item.sku || '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (remito.notas) { %>
    <div class="notas">📝 <%= remito.notas %></div>
    <% } %>

    <div class="firmas">
      <div class="firma-box">
        <div class="firma-linea">
          <div class="firma-label">Entregué conforme</div>
          <div class="firma-sub">Firma y aclaración</div>
        </div>
      </div>
      <div class="firma-box">
        <div class="firma-linea">
          <div class="firma-label">Recibí conforme</div>
          <div class="firma-sub">Firma, aclaración y DNI</div>
        </div>
      </div>
    </div>

  </div>
</body>
</html>
