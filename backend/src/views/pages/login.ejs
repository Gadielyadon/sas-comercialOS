<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar sesión — AxSoft</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --brand-blue: #1B4FD8;
      --brand-teal: #0F6E56;
      --bg: #0C0E14;
      --card: #12141c;
      --border: rgba(255,255,255,0.08);
      --border-strong: rgba(255,255,255,0.14);
      --text: #f4f4f5;
      --text-sub: #a1a1aa;
      --text-muted: #6b6b74;
      --font: 'Plus Jakarta Sans', system-ui, sans-serif;
      --radius: 12px;
    }
    html, body { height: 100%; font-family: var(--font); background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }

    .login-shell {
      min-height: 100vh;
      display: flex;
    }

    /* ── Panel izquierdo: marca de AxSoft ── */
    .brand-panel {
      flex: 0 0 44%;
      position: relative;
      overflow: hidden;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 48px 44px;
      background: linear-gradient(150deg, var(--brand-blue) 0%, var(--brand-teal) 100%);
    }
    .brand-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.08); pointer-events: none; }
    .brand-orb-1 { width: 320px; height: 320px; top: -120px; right: -100px; }
    .brand-orb-2 { width: 240px; height: 240px; bottom: -100px; left: -60px; background: rgba(255,255,255,.06); }

    .brand-top { position: relative; display: flex; align-items: center; gap: 13px; }
    .brand-icon { width: 46px; height: 46px; border-radius: 12px; overflow: hidden; flex-shrink: 0; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
    .brand-icon img { width: 100%; height: 100%; object-fit: cover; }
    .brand-name { font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -.3px; }
    .brand-sub { font-size: 11.5px; color: rgba(255,255,255,.65); font-weight: 600; letter-spacing: .6px; text-transform: uppercase; }

    .brand-mid { position: relative; }
    .brand-title { font-size: 26px; font-weight: 800; color: #fff; line-height: 1.35; letter-spacing: -.4px; margin-bottom: 26px; max-width: 340px; }
    .brand-features { display: flex; flex-direction: column; gap: 15px; }
    .brand-feature { display: flex; align-items: center; gap: 11px; font-size: 13.5px; font-weight: 600; color: rgba(255,255,255,.88); }
    .brand-feature i { font-size: 16px; width: 20px; text-align: center; color: rgba(255,255,255,.75); }

    .brand-foot { position: relative; font-size: 11px; color: rgba(255,255,255,.5); font-weight: 500; }

    /* ── Panel derecho: fondo con textura sutil + tarjeta flotante ── */
    .form-panel {
      flex: 1;
      position: relative;
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      padding: 40px 24px;
      background: var(--bg);
    }
    .form-panel::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 85% 15%, rgba(15,110,86,.16) 0%, transparent 55%),
        radial-gradient(ellipse 55% 55% at 10% 90%,  rgba(27,79,216,.14) 0%, transparent 55%);
    }
    .form-panel::after {
      content: '';
      position: absolute; inset: 0;
      background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, black 30%, transparent 80%);
    }

    .form-card {
      position: relative; z-index: 1;
      width: 100%; max-width: 380px;
      background: rgba(22,24,32,.92);
      border: 1px solid var(--border-strong);
      border-radius: 20px;
      box-shadow: 0 24px 60px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.03);
      padding: 40px 36px 32px;
      animation: cardIn .4s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes cardIn { from{ opacity:0; transform:translateY(14px); } to{ opacity:1; transform:translateY(0); } }

    .client-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 30px; }
    .client-logo-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: var(--card); border: 1px solid var(--border-strong);
      display: flex; align-items: center; justify-content: center;
      color: var(--brand-blue); font-size: 19px; flex-shrink: 0;
    }
    .client-logo-img { height: 44px; max-width: 110px; object-fit: contain; border-radius: 9px; flex-shrink: 0; background: rgba(255,255,255,.06); padding: 4px; }
    .client-logo-text strong { display: block; font-size: 15px; font-weight: 700; color: #fff; line-height: 1.25; }
    .client-logo-text span { font-size: 10.5px; color: var(--text-muted); font-weight: 500; letter-spacing: .4px; text-transform: uppercase; }

    .login-title { font-size: 23px; font-weight: 800; color: #fff; letter-spacing: -.4px; margin-bottom: 6px; }
    .login-subtitle { font-size: 13.5px; color: var(--text-sub); margin-bottom: 28px; font-weight: 500; }

    .field { margin-bottom: 17px; }
    .field label { display: block; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-sub); margin-bottom: 7px; }
    .field-wrap { position: relative; }
    .field-wrap .field-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 15px; pointer-events: none; transition: color .18s; }
    .field-wrap:focus-within .field-icon { color: var(--brand-blue); }
    .field-wrap input {
      width: 100%; padding: 13px 14px 13px 42px;
      border-radius: var(--radius);
      border: 1.5px solid var(--border-strong);
      background: var(--card);
      color: var(--text); font-size: 14.5px; font-family: var(--font); font-weight: 500;
      outline: none; transition: border-color .18s, box-shadow .18s;
    }
    .field-wrap input::placeholder { color: var(--text-muted); }
    .field-wrap input:focus { border-color: var(--brand-blue); box-shadow: 0 0 0 3px rgba(27,79,216,.16); }
    .field-wrap input.is-error { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.12); }

    .toggle-pass { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 16px; padding: 3px; line-height: 1; transition: color .15s; }
    .toggle-pass:hover { color: var(--brand-blue); }

    .error-banner {
      display: flex; align-items: center; gap: 9px;
      background: rgba(239,68,68,.08); border: 1px solid rgba(239,68,68,.25);
      border-radius: 10px; padding: 11px 14px;
      font-size: 13px; font-weight: 600; color: #f87171;
      margin-bottom: 20px; animation: shake .35s ease;
    }
    @keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }

    .btn-login {
      width: 100%; margin-top: 10px; padding: 14px;
      border: none; border-radius: var(--radius);
      background: linear-gradient(135deg, var(--brand-blue) 0%, var(--brand-teal) 100%);
      color: #fff; font-size: 14.5px; font-weight: 700; font-family: var(--font);
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: opacity .15s, transform .12s, box-shadow .2s;
      box-shadow: 0 8px 22px rgba(27,79,216,.30);
    }
    .btn-login:hover:not(:disabled) { opacity: .93; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(27,79,216,.4); }
    .btn-login:active:not(:disabled) { transform: translateY(0); }
    .btn-login:disabled { opacity: .55; cursor: not-allowed; }

    .login-footer { margin-top: 26px; text-align: center; font-size: 11px; color: var(--text-muted); font-weight: 500; }

    @keyframes spin { to{ transform:rotate(360deg); } }
    .spinner { width:16px; height:16px; border:2.5px solid rgba(255,255,255,.3); border-top-color:#fff; border-radius:50%; display:inline-block; animation:spin .7s linear infinite; }

    @media (max-width: 860px) {
      .login-shell { flex-direction: column; }
      .brand-panel { flex: 0 0 auto; padding: 32px 28px; }
      .brand-title { font-size: 20px; margin-bottom: 18px; }
      .brand-features { display: none; }
      .form-panel { padding: 36px 24px; }
    }
  </style>
</head>
<body>

  <div class="login-shell">

    <div class="brand-panel">
      <div class="brand-orb brand-orb-1"></div>
      <div class="brand-orb brand-orb-2"></div>

      <div class="brand-top">
        <div class="brand-icon"><img src="/img/axsoft-icon.png" alt="AxSoft"></div>
        <div>
          <div class="brand-name">AxSoft</div>
          <div class="brand-sub">Solutions</div>
        </div>
      </div>

      <div class="brand-mid">
        <div class="brand-title">Todo tu negocio, en un solo lugar</div>
        <div class="brand-features">
          <div class="brand-feature"><i class="bi bi-cart-check-fill"></i> Punto de venta</div>
          <div class="brand-feature"><i class="bi bi-box-seam-fill"></i> Inventario</div>
          <div class="brand-feature"><i class="bi bi-receipt"></i> Facturación AFIP / ARCA</div>
          <div class="brand-feature"><i class="bi bi-graph-up-arrow"></i> Reportes y estadísticas</div>
        </div>
      </div>

      <div class="brand-foot">© 2026 AxSoft Solutions</div>
    </div>

      <div class="form-panel">
      <div class="form-card">

        <div class="client-logo">
          <% if (empresa_logo) { %>
            <img src="<%= empresa_logo %>" alt="Logo" class="client-logo-img">
          <% } else { %>
            <div class="client-logo-icon"><i class="bi bi-shop"></i></div>
          <% } %>
          <div class="client-logo-text">
            <strong><%= empresa_nombre || 'Mi Comercio' %></strong>
            <span>Sistema de gestión</span>
          </div>
        </div>

        <h1 class="login-title">Bienvenido</h1>
        <p class="login-subtitle">Ingresá tus credenciales para continuar</p>

        <% if (error) { %>
          <div class="error-banner">
            <i class="bi bi-exclamation-circle-fill"></i>
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/login" id="loginForm">
          <div class="field">
            <label>Usuario</label>
            <div class="field-wrap">
              <i class="bi bi-person field-icon"></i>
              <input type="text" name="username" id="inp_user"
                value="<%= username %>"
                placeholder="Tu nombre de usuario"
                autocomplete="username"
                autofocus
                class="<%= error ? 'is-error' : '' %>">
            </div>
          </div>

          <div class="field">
            <label>Contraseña</label>
            <div class="field-wrap">
              <i class="bi bi-lock field-icon"></i>
              <input type="password" name="password" id="inp_pass"
                placeholder="••••••••"
                autocomplete="current-password"
                class="<%= error ? 'is-error' : '' %>">
              <button type="button" class="toggle-pass" onclick="togglePass()" tabindex="-1">
                <i class="bi bi-eye" id="passEyeIcon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btnLogin">
            <i class="bi bi-box-arrow-in-right"></i>
            Ingresar
          </button>
        </form>

        <div class="login-footer">© 2026 <%= empresa_nombre || 'AxSoft' %> · v1.0</div>
      </div>
    </div>

  </div>

  <script>
    function togglePass() {
      const input = document.getElementById('inp_pass');
      const icon  = document.getElementById('passEyeIcon');
      if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
      else { input.type = 'password'; icon.className = 'bi bi-eye'; }
    }
    document.getElementById('loginForm').addEventListener('submit', function () {
      const btn = document.getElementById('btnLogin');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Ingresando…';
    });
  </script>
</body>
</html>
