            <p>Tocá un producto<br>para agregarlo al carrito</p>
          </div>
          <div class="cart-items-grid" id="cartItemsGrid"></div>
        </div>

        <!-- ── FOOTER ── -->
        <div class="cart-footer">

          <!-- Descuento -->
          <div class="cart-disc-row">
            <span class="cart-disc-lbl"><i class="bi bi-percent" style="color:var(--color-alert);"></i> Descuento</span>
            <div class="disc-bar">
              <button class="disc-type-btn on" id="btnPct" onclick="setDiscType('pct')">%</button>
