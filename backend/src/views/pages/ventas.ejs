async function mostrarSaldoClientePos(id){
  if(!id || id===1){ _clienteSaldo=0; renderSaldoBadge(); return; }
  try{
    const r=await fetch('/api/clientes/'+id);
    _clienteSaldo = r.ok ? Number((await r.json()).saldo || 0) : 0;
  }catch(e){ _clienteSaldo=0; }
  renderSaldoBadge();
}
function renderSaldoBadge(){
  const box=document.getElementById('posClienteSaldo');
  if(!box) return;
  const esCC = /cuenta\s*corriente/i.test(payMethod||'') || payTipo==='cuenta_corriente' || payTipo==='fiado';
  if(_clienteSaldo < 0){
    const aFavor=Math.abs(_clienteSaldo);
    let html='<i class="bi bi-wallet2"></i> Saldo a favor: <b>$'+aFavor.toLocaleString('es-AR')+'</b>';
    let total=0; try{ total = getBaseTotal().total||0; }catch(e){}
    if(esCC && total>0){
      const queda=aFavor-total;
      if(queda>=0) html+=' · esta venta $'+total.toLocaleString('es-AR')+' → quedará <b>$'+queda.toLocaleString('es-AR')+'</b> a favor';
      else html+=' · esta venta $'+total.toLocaleString('es-AR')+' → supera el saldo, pasa a deber <b>$'+Math.abs(queda).toLocaleString('es-AR')+'</b>';
    } else if(!esCC){
      html+=' · para descontar, cobrá como <b>Cuenta corriente</b>';
    }
    box.style.background='rgba(16,185,129,.12)'; box.style.color='#059669';
    box.innerHTML=html; box.style.display='block';
  } else if(_clienteSaldo > 0){
    box.style.background='rgba(239,68,68,.12)'; box.style.color='#dc2626';
    box.innerHTML='<i class="bi bi-exclamation-circle"></i> Este cliente debe: <b>$'+_clienteSaldo.toLocaleString('es-AR')+'</b>';
    box.style.display='block';
  } else {
    box.style.display='none';
  }
}
