  setComprobante('venta');
}

/* ══════════════════════════════════════════════════════
   DEPARTAMENTOS DE PRECIO MANUAL
══════════════════════════════════════════════════════ */

let _deptoActual = null;

function _getDeptos() {
  try {
    const saved = localStorage.getItem('pos_deptos');
    if (saved !== null) return JSON.parse(saved);
    const defaults = [
      { id:'d1', nombre:'Mantenimiento', icono:'🔧', color:'#3b82f6' },
      { id:'d2', nombre:'Mano de obra',  icono:'👷', color:'#10b981' },
      { id:'d3', nombre:'Materiales',    icono:'🪵', color:'#f59e0b' },
      { id:'d4', nombre:'Traslado',      icono:'🚚', color:'#8b5cf6' },
      { id:'d5', nombre:'Servicio',      icono:'⚙️', color:'#ef4444' },
    ];
    localStorage.setItem('pos_deptos', JSON.stringify(defaults));
    return defaults;
  } catch(e){ return []; }
}
function _saveDeptos(arr) {
  localStorage.setItem('pos_deptos', JSON.stringify(arr));
}

function toggleDeptosChip(btn) {
  const bar  = document.getElementById('deptosBar');
  const isOpen = btn.classList.toggle('active');
  const scroll = document.querySelector('.products-scroll');
  if (isOpen) {
    bar.style.display  = 'block';
    if(scroll) scroll.style.display = 'none';
    renderDeptosGrid();
  } else {
    bar.style.display  = 'none';
    if(scroll) scroll.style.display = '';
  }
}

function renderDeptosGrid() {
  const deptos = _getDeptos();
  const container = document.getElementById('deptosGrid');
  if (!container) return;

  if (!deptos.length) {
    container.innerHTML = `
      <div style="grid-column:1/-1;text-align:center;padding:24px;color:var(--text-secondary);">
        <div style="font-size:32px;margin-bottom:8px;">🏪</div>
        <div style="font-size: 15px;font-weight:600;">Sin departamentos</div>
        <div style="font-size: 13.5px;margin-top:4px;opacity:.7;">Agregá uno con el botón +</div>
        <button onclick="abrirGestorDeptos()" style="margin-top:12px;padding:7px 16px;border-radius:8px;border:1.5px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);font-size: 13.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);">
          + Agregar departamento
        </button>
      </div>`;
    return;
  }

  container.innerHTML = deptos.map((d, i) => {
    const fkey = i < 11 ? 'F'+(i+1) : '';
    return `
    <button class="depto-btn" onclick="abrirDeptoPrecio('${d.id}','${escapeHtml(d.nombre)}','${d.icono||'🏷️'}')" title="${fkey ? fkey+' — ' : ''}${escapeHtml(d.nombre)}">
      ${fkey ? `<kbd style="position:absolute;top:4px;left:5px;font-size: 9px;font-weight:800;background:rgba(27,79,216,.15);color:var(--color-primary);border:1px solid rgba(27,79,216,.25);border-radius:3px;padding:1px 4px;line-height:1.4;">${fkey}</kbd>` : ''}
      <span class="depto-btn-icon" style="margin-top:${fkey?'6px':'0'}">${d.icono || '🏷️'}</span>
      <span class="depto-btn-label">${escapeHtml(d.nombre)}</span>
      <button class="depto-btn-edit" onclick="event.stopPropagation();eliminarDepto('${d.id}')" title="Eliminar" style="position:absolute;top:4px;right:4px;width:18px;height:18px;border-radius:50%;border:none;background:rgba(239,68,68,.15);color:#ef4444;font-size: 11.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>
    </button>`;
  }).join('') + `
    <button class="depto-btn" onclick="abrirGestorDeptos()" style="border-style:dashed;opacity:.6;">
      <span class="depto-btn-icon">➕</span>
      <span class="depto-btn-label">Agregar</span>
    </button>`;
}

function abrirDeptoPrecio(id, nombre, icono) {
  // Cerrar el panel de departamentos automáticamente al seleccionar uno
  const chip = document.getElementById('chipDeptos');
  const bar  = document.getElementById('deptosBar');
  const scroll = document.querySelector('.products-scroll');
  if (chip && chip.classList.contains('active')) {
    chip.classList.remove('active');
    if (bar) bar.style.display = 'none';
    if (scroll) scroll.style.display = '';
  }
  _deptoActual = { id, nombre, icono };
  const overlay = document.getElementById('deptoPriceOverlay');
  if (!overlay) return;
  const header = overlay.querySelector('.depto-price-header');
  if (header) header.innerHTML = `<span>${icono} ${nombre}</span>`;
  const priceInp = document.getElementById('deptoPriceInput');
  const qtyInp   = document.getElementById('deptoQtyInput');
  const addBtn   = document.getElementById('btnDeptoAdd');
  if (priceInp) { priceInp.value = ''; }
  if (qtyInp)   { qtyInp.value  = '1'; }
  if (addBtn)   { addBtn.disabled = true; }
  overlay.style.display = 'flex';
  setTimeout(() => { if (priceInp) priceInp.focus(); }, 80);
}

function cerrarDeptoPrecio() {
  const overlay = document.getElementById('deptoPriceOverlay');
  if (overlay) overlay.style.display = 'none';
  _deptoActual = null;
}

function actualizarBtnDepto() {
  const priceInp = document.getElementById('deptoPriceInput');
  const addBtn   = document.getElementById('btnDeptoAdd');
  if (!priceInp || !addBtn) return;
  addBtn.disabled = !(parseFloat(priceInp.value) > 0);
}

function agregarDepto() {
  if (!_deptoActual) return;
  const price = parseFloat(document.getElementById('deptoPriceInput')?.value) || 0;
  const qty   = parseInt(document.getElementById('deptoQtyInput')?.value)     || 1;
  if (price <= 0) return;

  const product = {
    sku:     `DEPTO-${_deptoActual.id}-${Date.now()}`,
    name:    _deptoActual.nombre,
    price:   price,
    stock:   9999,
    isDepto: true,
    en_promo: 0,
    price_promo: null,
  };

  for (let i = 0; i < qty; i++) addToCart(product);
  cerrarDeptoPrecio();
  showToast(`${_deptoActual.icono} ${_deptoActual.nombre} — ${fmt(price)} × ${qty}`, 'success');
}

function abrirGestorDeptos() {
  const overlay = document.getElementById('deptosMgrOverlay');
  if (!overlay) return;
  renderDeptosMgrList();
  overlay.classList.add('open');
}

function cerrarGestorDeptos() {
  const overlay = document.getElementById('deptosMgrOverlay');
  if (overlay) overlay.classList.remove('open');
  renderDeptosGrid();
}

function renderDeptosMgrList() {
  const list   = document.getElementById('deptosMgrList');
  const deptos = _getDeptos();
  if (!list) return;
  if (!deptos.length) {
    list.innerHTML = '<p style="font-size: 13.5px;color:var(--text-secondary);text-align:center;">Sin departamentos</p>';
    return;
  }
  list.innerHTML = deptos.map(d => `
    <div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg-body);border-radius:8px;border:1px solid var(--border-color);">
      <span style="font-size: 23px;">${d.icono || '🏷️'}</span>
      <span style="flex:1;font-size: 15px;font-weight:600;color:var(--text-primary);">${escapeHtml(d.nombre)}</span>
      <button onclick="eliminarDepto('${d.id}')" style="padding:3px 8px;border-radius:6px;border:1px solid rgba(239,68,68,.3);background:rgba(239,68,68,.08);color:#ef4444;font-size: 12.5px;cursor:pointer;">Eliminar</button>
    </div>`).join('');
}

function agregarNuevoDepto() {
  const nombreInp = document.getElementById('newDeptoName');
  const iconoInp  = document.getElementById('newDeptoIcon');
  if (!nombreInp) return;
  const nombre = nombreInp.value.trim();
  if (!nombre) return;
  const icono  = iconoInp?.value.trim() || '🏷️';
  const deptos = _getDeptos();
  deptos.push({ id: Date.now().toString(), nombre, icono });
  _saveDeptos(deptos);
  nombreInp.value = '';
  if (iconoInp) iconoInp.value = '';
  renderDeptosMgrList();
  showToast(`Departamento "${nombre}" creado`, 'success');
}

function eliminarDepto(id) {
  const deptos = _getDeptos().filter(d => d.id !== id);
  _saveDeptos(deptos);
  renderDeptosMgrList();
  renderDeptosGrid();
}


function abrirZoom(nombre, imgSrc){
  if(!imgSrc) return;
  document.getElementById('prodZoomImg').src = imgSrc;
  document.getElementById('prodZoomName').textContent = nombre;
  document.getElementById('prodZoomOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

document.addEventListener('click', function(e){
  // Cerrar dropdown lista si click fuera
  const wrap = document.getElementById('listaWrap');
  const drop = document.getElementById('dropLista');
  if (drop && drop.style.display !== 'none' && wrap && !wrap.contains(e.target)) {
    drop.style.display = 'none';
  }

  const thumb = e.target.closest('.prod-thumb');
  if(!thumb) return;
  e.stopPropagation();
  const img  = thumb.dataset.zoomImg;
  const name = thumb.dataset.zoomSku;
  if(img) abrirZoom(name, img);
});

// Cerrar lightbox con Escape
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') cerrarZoom();
});

function cerrarZoom(){
  const overlay = document.getElementById('prodZoomOverlay');
  overlay.classList.remove('open');
  document.body.style.overflow = '';
  // Limpiar src después de la transición para no mostrar imagen vieja al reabrirse
  setTimeout(() => { document.getElementById('prodZoomImg').src = ''; }, 220);
}

/* ── Bloqueo por límite de crédito ── */
function _mostrarBloqueoLimite(check, montoVenta) {
  const fmtN = n => '$' + Number(n).toLocaleString('es-AR', {minimumFractionDigits:2});
  // Crear overlay si no existe
  let ov = document.getElementById('bloqueoLimiteOverlay');
  if (!ov) {
    ov = document.createElement('div');
    ov.id = 'bloqueoLimiteOverlay';
    ov.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);';
    ov.innerHTML = `
      <div style="background:var(--bg-card);border-radius:18px;padding:28px;width:340px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);">
        <div style="width:56px;height:56px;border-radius:50%;background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;font-size:26px;color:#ef4444;margin:0 auto 14px;">
          <i class="bi bi-shield-x"></i>
        </div>
        <div style="font-size: 19.5px;font-weight:800;color:var(--text-primary);margin-bottom:6px;">Límite de crédito superado</div>
        <div style="font-size: 14px;color:var(--text-secondary);margin-bottom:18px;">No se puede registrar esta venta como cuenta corriente.</div>
        <div style="background:var(--bg-body);border:1px solid var(--border-color);border-radius:10px;padding:12px 16px;text-align:left;margin-bottom:18px;display:flex;flex-direction:column;gap:6px;" id="bloqueoLimiteDetalle"></div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <button onclick="document.getElementById('bloqueoLimiteOverlay').remove()"
            style="width:100%;padding:11px;border-radius:9px;border:none;background:#ef4444;color:#fff;font-size: 16px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
            <i class="bi bi-x-circle"></i> Entendido — no procesar
          </button>
          <button onclick="document.getElementById('bloqueoLimiteOverlay').remove();closeCobroModal();"
            style="width:100%;padding:9px;border-radius:9px;border:1.5px solid var(--border-color);background:transparent;color:var(--text-secondary);font-size: 15px;font-weight:600;cursor:pointer;font-family:var(--font-body);">
            Cancelar venta
          </button>
        </div>
      </div>`;
    document.body.appendChild(ov);
  }
  // Llenar detalle
  const det = document.getElementById('bloqueoLimiteDetalle');
  if (det) {
    det.innerHTML = `
      <div style="display:flex;justify-content:space-between;font-size: 13.5px;"><span style="color:var(--text-secondary);">Deuda actual</span><span style="font-family:var(--font-mono);font-weight:700;color:#ef4444;">${fmtN(check.saldo)}</span></div>
      <div style="display:flex;justify-content:space-between;font-size: 13.5px;"><span style="color:var(--text-secondary);">Esta venta</span><span style="font-family:var(--font-mono);font-weight:700;color:var(--text-primary);">+${fmtN(montoVenta)}</span></div>
      <div style="border-top:1px solid var(--border-color);padding-top:6px;display:flex;justify-content:space-between;font-size: 13.5px;"><span style="color:var(--text-secondary);">Límite configurado</span><span style="font-family:var(--font-mono);font-weight:700;color:var(--color-primary);">${fmtN(check.limite)}</span></div>
      <div style="display:flex;justify-content:space-between;font-size: 13.5px;"><span style="color:var(--text-secondary);">Excede en</span><span style="font-family:var(--font-mono);font-weight:800;color:#ef4444;">${fmtN(Math.abs(check.disponible - montoVenta))}</span></div>`;
  }
}

function showToast(msg,type='success'){  const t=document.getElementById('posToast'),
        icons={success:'bi-check-circle-fill',info:'bi-plus-circle-fill',error:'bi-x-circle-fill',warn:'bi-exclamation-triangle-fill'};
  t.className=`pos-toast toast-${type} show`;
  document.getElementById('toastIcon').className=`bi ${icons[type]||icons.success}`;
  document.getElementById('toastMsg').textContent=msg;
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),2200);
}
function focusScanner(){
  document.getElementById('barcodeInput').value='';
  document.getElementById('barcodeInput').focus();
}

function filtrarCards(q){
  if(!q){renderGrid(catActiva?allProducts.filter(p=>p.category===catActiva):allProducts);return;}
  const ql=q.toLowerCase();
  renderGrid(allProducts.filter(p=>
    p.name.toLowerCase().includes(ql)||
    p.sku.toLowerCase().includes(ql)||
    (p.descripcion&&p.descripcion.toLowerCase().includes(ql))||
    (p.barcode&&p.barcode.includes(q))
  ));
}

document.addEventListener('DOMContentLoaded',async()=>{
  await Promise.all([loadCatalog(),loadPaymentMethods(),loadTicketConfig()]);
  limpiarClientePos();
  const input=document.getElementById('barcodeInput'),dot=document.getElementById('scanDot');

  // ── Navegación por teclado en la grilla de productos ──
  let kbCardIdx = -1;

  function getVisibleCards() {
    return [...document.querySelectorAll('#productsGrid .prod-card:not([style*="display:none"]):not(.out-stock)')];
  }

  function kbSelectCard(idx) {
    const cards = getVisibleCards();
    cards.forEach(c => c.classList.remove('kb-selected'));
    if (idx < 0 || idx >= cards.length) { kbCardIdx = -1; return; }
    kbCardIdx = idx;
    cards[idx].classList.add('kb-selected');
    // scroll centrado — 'center' garantiza que el item siempre sea visible
    cards[idx].scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  function kbClearCards() {
    getVisibleCards().forEach(c => c.classList.remove('kb-selected'));
    kbCardIdx = -1;
  }

  input.addEventListener('keydown',async e=>{
    const now=Date.now(),gap=now-lastKeyTime;lastKeyTime=now;
    if(gap<40){keyCount++;if(keyCount>=3){isScanMode=true;dot.classList.add('scanner-mode');}}
    else{isScanMode=false;keyCount=0;dot.classList.remove('scanner-mode');}

    if(e.key==='Escape'){
      if(qtyMultiplier>1){ resetQtyMultiplier(); }
      if(kbCardIdx >= 0){ kbClearCards(); return; }
      input.value='';filtrarCards('');
      return;
    }

    // Navegación con flechas en la grilla de productos
    // Es una tabla vertical — Down/Up mueven de a 1 fila
    const cards = getVisibleCards();

    if(e.key==='ArrowDown'){
      e.preventDefault();
      if(kbCardIdx < 0) kbSelectCard(0);
      else kbSelectCard(Math.min(kbCardIdx + 1, cards.length - 1));
      return;
    }
    if(e.key==='ArrowUp'){
      e.preventDefault();
      if(kbCardIdx < 0) kbSelectCard(cards.length - 1);
      else kbSelectCard(Math.max(kbCardIdx - 1, 0));
      return;
    }
    // Izquierda/derecha: misma fila (no aplica en lista, pero no romper)
    if(e.key==='ArrowRight'){
      e.preventDefault();
      if(kbCardIdx < 0) kbSelectCard(0);
      else kbSelectCard(Math.min(kbCardIdx + 1, cards.length - 1));
      return;
    }
    if(e.key==='ArrowLeft'){
      e.preventDefault();
      if(kbCardIdx < 0) kbSelectCard(0);
      else kbSelectCard(Math.max(kbCardIdx - 1, 0));
      return;
    }

    if(e.key==='Enter'){
      e.preventDefault();
      isScanMode=false;keyCount=0;dot.classList.remove('scanner-mode');

      // Si hay tarjeta seleccionada con teclado → agregarla
      if(kbCardIdx >= 0 && cards[kbCardIdx]){
        cards[kbCardIdx].click();
        kbClearCards();
        return;
      }

      let query=input.value.trim();
      if(!query){if(cart.length)openCobroModal();return;}

      // ── Multiplicador de cantidad: "x3" (Enter) deja ×3 listo; "x3 algo" o "x3<codigo>" lo aplica ──
      let _mm;
      if(_mm=query.match(/^[xX*]\s*(\d{1,3})$/)){
        setQtyMultiplier(_mm[1]); input.value=''; beep('add');
        showToast(`Cantidad ×${qtyMultiplier} lista — escaneá o tocá el producto`,'info');
        return;
      }
      if(_mm=query.match(/^[xX*]\s*(\d{1,3})\s+(.+)$/)){ setQtyMultiplier(_mm[1]); query=_mm[2].trim(); }
      else if(_mm=query.match(/^[xX*](\d)(\d{6,})$/)){ setQtyMultiplier(_mm[1]); query=_mm[2]; }

      // ══════════════════════════════════════════════════
      // ⚖️  DETECCIÓN BALANZA — va ANTES de cualquier
      //     búsqueda normal de SKU o barcode
      // ══════════════════════════════════════════════════
      const balanza = tryDecodeBalanza(query);
      if (balanza) {
        // Buscar el producto por PLU (= SKU en tu sistema)
        let prod = allProducts.find(p =>
          p.sku === balanza.sku ||
          String(p.sku) === String(parseInt(balanza.sku, 10))
        ) || await apiBySku(balanza.sku);

        if (prod) {
          // Clonar para no mutar el catálogo
          prod = { ...prod };

         if (BALANZA_CFG.modo === 'precio' && balanza.precio !== null) {
  prod.price           = balanza.precio;
  prod.precio_efectivo = balanza.precio;
  prod.en_promo        = 0;
  prod.price_promo     = null;
}else if (BALANZA_CFG.modo === 'peso' && balanza.peso !== null) {
  const precioBase = Number(prod.price) || 0;
  const precioCalculado = parseFloat((precioBase * balanza.peso).toFixed(2));
  prod.price          = precioCalculado;
  prod.precio_efectivo = precioCalculado;
  prod.en_promo       = 0;
  prod.price_promo    = null;
  prod.name           = `${prod.name} (${balanza.peso.toFixed(3)} kg)`;
}

          // SKU único por escaneo (evita que se incremente qty de otro escaneo)
          prod.sku = `BAL-${balanza.sku}-${Date.now()}`;

          commitAdd(prod);
          input.value = '';
          filtrarCards('');
          kbClearCards();
        } else {
          beep('error');
          showToast(`⚖️ PLU ${balanza.sku} no encontrado`, 'error');
          input.select();
        }
        return; // ← siempre salir después de intentar balanza
      }
      // ══════════════════════════════════════════════════

      // Si hay exactamente una tarjeta visible → agregarla directo
      if(cards.length===1){
        cards[0].click();
        input.value='';filtrarCards('');kbClearCards();
        return;
      }

      const exacto=allProducts.find(p=>p.sku.toLowerCase()===query.toLowerCase()||(p.barcode&&p.barcode===query));
      if(exacto){commitAdd(exacto);input.value='';filtrarCards('');kbClearCards();return;}
      const vis=allProducts.filter(p=>p.name.toLowerCase().includes(query.toLowerCase())||p.sku.toLowerCase().includes(query.toLowerCase()));
      if(vis.length===1){commitAdd(vis[0]);input.value='';filtrarCards('');kbClearCards();return;}
      const prod=await apiBySku(query);
      if(prod){commitAdd(prod);input.value='';filtrarCards('');kbClearCards();return;}
      beep('error');showToast(`"${query}" no encontrado`,'error');input.select();
    }

    // Al tipear → resetear selección de teclado
    if(e.key.length === 1) kbClearCards();
  });

  input.addEventListener('input',()=>{
    if(isScanMode)return;
    clearTimeout(searchDeb);
    searchDeb=setTimeout(()=>{if(!isScanMode)filtrarCards(input.value.trim());},100);
  });

  document.addEventListener('click',e=>{
    if(!['button','a','select','input','textarea'].some(t=>e.target.closest(t))) input.focus();
  });
});

document.addEventListener('keydown',e=>{
  const overlayOpen = document.getElementById('cobroOverlay').classList.contains('open');

  if(overlayOpen){
    const activeTag = e.target.tagName;
    const activeId = e.target.id || '';
    const activeEl = document.activeElement;
    const inEditable = ['INPUT','TEXTAREA','SELECT'].includes(activeTag);
    const inNumericInputs = ['cashReceived','mixtoMonto1','mixtoMonto2','recargoCustom'].includes(activeId);

    if(!inEditable || !inNumericInputs){
      if(e.key === 'ArrowRight'){
        e.preventDefault();
        movePmFocus(1);
        return;
      }
      if(e.key === 'ArrowLeft'){
        e.preventDefault();
        movePmFocus(-1);
        return;
      }
      if(e.key === 'ArrowDown'){
        if(activeEl && ['cashReceived','mixtoMonto1','mixtoMonto2','recargoCustom'].includes(activeEl.id)) return;
        e.preventDefault();
        if(activeEl && activeEl.id === 'btnCobrar'){ focusMPPointButton(); return; }
        if(activeEl && activeEl.id === 'btnMPPoint'){ return; }
        movePmFocusVertical(1);
        return;
      }
      if(e.key === 'ArrowUp'){
        if(activeEl && ['cashReceived','mixtoMonto1','mixtoMonto2','recargoCustom'].includes(activeEl.id)) return;
        e.preventDefault();
        if(activeEl && activeEl.id === 'btnMPPoint'){ focusCobrarButton(); return; }
        if(activeEl && activeEl.id === 'btnCobrar'){ focusPmButton(pmFocusIdx); return; }
        movePmFocusVertical(-1);
        return;
      }
      if(e.key === 'Enter'){
        if(activeEl && activeEl.classList && activeEl.classList.contains('pm-btn')){
          e.preventDefault();
          activeEl.click();
          return;
        }
      }
    }

    if(e.key==='Escape'){
      e.preventDefault();
      closeCobroModal();
      return;
    }
  }

  const inInput=['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName)&&e.target.id!=='barcodeInput';
  if(inInput)return;

  const _fMatch = e.key.match(/^F(\d+)$/);
  if (_fMatch) {
    const _fi = parseInt(_fMatch[1]) - 1;
    if (_fi >= 0 && _fi <= 10) {
      const _depList = _getDeptos();
      if (_depList[_fi]) {
        e.preventDefault();
        const d = _depList[_fi];
        abrirDeptoPrecio(d.id, d.nombre, d.icono || '🏷️');
        return;
      }
    }
  }
  if(e.key==='F2'){e.preventDefault();focusScanner();showToast('Scanner listo','info');}
  if(e.key==='F10'){e.preventDefault();cart.length?openCobroModal():showToast('Carrito vacío','warn');}
  if(e.key==='F5'){
    e.preventDefault();
    // F5 en modal éxito → imprimir ticket; fuera → departamentos
    if(document.getElementById('exitoOverlay')?.classList.contains('open')){
      imprimirTicket();
    } else {
      const c=document.getElementById('chipDeptos');if(c)toggleDeptosChip(c);
    }
  }
  if(e.key==='F6'){e.preventDefault();ciclarLista();}
  if(e.key==='Enter'){
    if(document.getElementById('exitoOverlay')?.classList.contains('open')){
      e.preventDefault();
      nuevaVenta();
      return;
    }
  }
  if(e.key==='Escape'){
    if(document.getElementById('cobroOverlay').classList.contains('open')){closeCobroModal();return;}
    if(document.getElementById('exitoOverlay').classList.contains('open')){nuevaVenta();return;}
    e.preventDefault();
    clearCart();
    showToast('Venta limpiada','warn');
  }
});

window.addEventListener('load',()=>{
  const bc = document.getElementById('barcodeInput');
  if (bc) { bc.value = ''; setTimeout(()=>{ bc.value=''; bc.focus(); }, 120); }
});

/* ══════════════════════════════════════════════
   NAVEGACIÓN CON FLECHAS EN EL FOOTER DEL POS
   Tab / Enter / Flechas ↑↓ mueven entre:
   [barcode] → [posClienteSearch] → [discInput] → [btnConfirm]
══════════════════════════════════════════════ */
(function () {
  // Orden de foco en el panel derecho
  const FOOTER_FIELDS = ['posClienteSearch', 'discInput', 'btnConfirm'];

  function footerIdx(id) {
    return FOOTER_FIELDS.indexOf(id);
  }

  function moveFocus(fromId, delta) {
    const idx = footerIdx(fromId);
    if (idx === -1) return false;
    const next = idx + delta;
    if (next < 0) {
      // Volver al scanner
      document.getElementById('barcodeInput')?.focus();
      return true;
    }
    if (next >= FOOTER_FIELDS.length) return false;
    const el = document.getElementById(FOOTER_FIELDS[next]);
    if (el) { el.focus(); el.select?.(); }
    return true;
  }

  document.addEventListener('keydown', function (e) {
    const id  = document.activeElement?.id;
    const tag = document.activeElement?.tagName;

    // Dentro de los campos del footer — solo Tab navega entre ellos
    // Las flechas ↑↓ NO se capturan acá para no interferir con la lista de productos
    if (FOOTER_FIELDS.includes(id)) {
      if (e.key === 'Tab' && !e.shiftKey) {
        e.preventDefault();
        moveFocus(id, 1);
        return;
      }
      if (e.key === 'Tab' && e.shiftKey) {
        e.preventDefault();
        moveFocus(id, -1);
        return;
      }
      // Enter en cliente o descuento → siguiente campo
      if (e.key === 'Enter' && id !== 'btnConfirm') {
        e.preventDefault();
        moveFocus(id, 1);
        return;
      }
      // Enter en btnConfirm → abrir cobro
      if (e.key === 'Enter' && id === 'btnConfirm') {
        e.preventDefault();
        if (!document.getElementById('btnConfirm').disabled) openCobroModal();
        return;
      }
    }
  });
})();

</script>

