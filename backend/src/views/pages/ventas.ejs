}

function chgQty(sku,d){
  const item=cart.find(i=>i.sku===sku);
  if(!item)return;
  item.qty+=d;
  if(item.qty<=0){removeItem(sku);return;}
  aplicarPrecioMayorista(item);
  updateCardState(sku);
  renderCartList();
  updateTotals();
}

function editarPrecioItem(sku, precioActual) {
  const item = cart.find(i => i.sku === sku);
  if (!item) return;
  const id = 'ci-' + CSS.escape(sku);
  const el = document.getElementById(id);
  if (!el) return;

  // Buscar el div de precio visible en desktop
  const precioDiv = el.querySelector('.cart-card-price');
  if (!precioDiv) return;

  const inp = document.createElement('input');
  inp.type = 'number';
  inp.min = '0';
  inp.step = '1';
  inp.value = precioActual;
  inp.style.cssText = 'width:90px;padding:2px 6px;border-radius:5px;border:2px solid var(--color-primary);background:var(--bg-surface);color:var(--text-primary);font-size: 16px;font-weight:700;font-family:var(--font-mono);text-align:right;outline:none;';

  // Guardar contenido original
  const contenidoOriginal = precioDiv.innerHTML;
  precioDiv.innerHTML = '';
  precioDiv.appendChild(inp);
  inp.focus();
  inp.select();

  function confirmar() {
    const nuevo = parseFloat(inp.value);
    if (!isNaN(nuevo) && nuevo >= 0) {
      // Guardamos con qué precio venía justo ANTES de tocarlo a mano (una sola vez).
      // Usamos item.price (el precio efectivo: ya incluye escalón/promo) y no price_base,
      // para que el descuento por cantidad no se cuente como descuento manual del cajero.
      if (item.price_original === undefined || item.price_original === null) {
        item.price_original = item.price;
      }
      item.price      = nuevo;
      item.price_base = nuevo;
      item.precioEditado = true;
      renderCartList();
      updateTotals();
    } else {
      precioDiv.innerHTML = contenidoOriginal;
    }
  }

  inp.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); confirmar(); }
    if (e.key === 'Escape') { precioDiv.innerHTML = contenidoOriginal; }
  });
  inp.addEventListener('blur', confirmar);
}

function removeItem(sku){
  cart=cart.filter(i=>i.sku!==sku);
  const el=document.getElementById('ci-'+CSS.escape(sku));
  if(el){
    el.style.cssText='transition:opacity .15s,transform .15s;opacity:0;transform:translateX(10px)';
    setTimeout(()=>{el.remove();renderCartList();},150);
  }
  updateCardState(sku);
  updateTotals();
}

function clearCart(){
  const skus=cart.map(i=>i.sku);
  cart=[];
  skus.forEach(updateCardState);
  renderCartList();
  document.getElementById('discInput').value='';
  limpiarClientePos();
  updateTotals();
  focusScanner();
}

function setDiscType(t){
  discType=t;
  document.getElementById('btnPct').classList.toggle('on',t==='pct');
  document.getElementById('btnFixed').classList.toggle('on',t==='fixed');
  document.getElementById('discSuffix').textContent=t==='pct'?'%':'$';
  document.getElementById('discInput').value='';
  updateTotals();
}
function getDiscount(sub){
  const v=parseFloat(document.getElementById('discInput').value)||0;
  if(v<=0)return 0;
  return discType==='pct'?sub*(Math.min(v,100)/100):Math.min(v,sub);
}
function getBaseTotal(){
  const sub=cart.reduce((s,i)=>s+i.price*i.qty,0),disc=getDiscount(sub);
  return{sub,disc,total:Math.max(0,sub-disc)};
}
/* ── Tipo de comprobante ── */
let _tipoComprobante = 'venta';
function setComprobante(tipo) {
  _tipoComprobante = tipo;
  document.getElementById('compVenta').classList.toggle('active', tipo === 'venta');
  document.getElementById('compFactura').classList.toggle('active', tipo === 'presupuesto');
  // Cambiar texto del botón confirmar
  const btnConfirm = document.getElementById('btnConfirm');
  if (tipo === 'presupuesto') {
    btnConfirm.innerHTML = '<i class="bi bi-file-earmark-text"></i> Generar Presupuesto';
    btnConfirm.onclick = () => generarPresupuestoDesdeCarrito();
  } else {
    btnConfirm.innerHTML = '<i class="bi bi-cash-coin"></i> Finalizar Venta';
    btnConfirm.onclick = () => openCobroModal();
  }
  updateTotals();
}

function updateTotals(){
  const{sub,disc,total}=getBaseTotal();
  document.getElementById('subtotalVal').textContent=fmt(sub);
  document.getElementById('totalVal').textContent=fmt(total);

  const dr=document.getElementById('discRow');
  dr.style.display=disc>0?'flex':'none';
  document.getElementById('discVal').textContent='-'+fmt(disc);

  // Neto e IVA — solo si hay productos con IVA y es factura
  const tieneIva = cart.some(i => {
    const prod = allProducts.find(p => p.sku === i.sku);
    return prod && Number(prod.iva) > 0;
  });
  const mostrarFiscal = _tipoComprobante === 'factura' && tieneIva;
  let netoTotal = 0, ivaTotal = 0;
  if (mostrarFiscal) {
    cart.forEach(i => {
      const prod = allProducts.find(p => p.sku === i.sku);
      const iva  = prod ? Number(prod.iva || 0) : 0;
      const linea = i.price * i.qty;
      if (iva > 0) {
        const neto = linea / (1 + iva / 100);
        netoTotal += neto;
        ivaTotal  += linea - neto;
      } else {
        netoTotal += linea;
      }
    });
    if (disc > 0) { const r = (total / sub); netoTotal *= r; ivaTotal *= r; }
  }
  const netoRow = document.getElementById('netoRow');
  const ivaRow  = document.getElementById('ivaRow');
  if (netoRow) { netoRow.style.display = mostrarFiscal ? 'flex' : 'none'; document.getElementById('netoVal').textContent = fmt(netoTotal); }
  if (ivaRow)  { ivaRow.style.display  = mostrarFiscal ? 'flex' : 'none'; document.getElementById('ivaVal').textContent  = fmt(ivaTotal); }

  const cnt = cart.reduce((s,i)=>s+i.qty,0);
  const badge = document.getElementById('cartCount');
  if (badge) { badge.textContent = cnt; badge.style.display = cnt > 0 ? 'inline-flex' : 'none'; }
  document.getElementById('btnConfirm').disabled=cart.length===0;
  updateCobroTotals();
  if(typeof renderSaldoBadge==='function') renderSaldoBadge();
}

/* Navegación teclado métodos de pago */
function getPmButtons(){ return [...document.querySelectorAll('#pmGrid .pm-btn')]; }
function clearPmFocus(){
  getPmButtons().forEach(b => b.classList.remove('kbd-focus'));
  document.getElementById('btnCobrar')?.classList.remove('kbd-focus');
  document.getElementById('btnMPPoint')?.classList.remove('kbd-focus');
}
function focusPmButton(index){
  const buttons = getPmButtons();
  if(!buttons.length) return;
  if(index < 0) index = 0;
  if(index >= buttons.length) index = buttons.length - 1;
  pmFocusIdx = index;
  clearPmFocus();
  const btn = buttons[pmFocusIdx];
  btn.classList.add('kbd-focus');
  btn.focus({ preventScroll:true });
  btn.scrollIntoView({ block:'nearest', inline:'nearest' });
}
function syncPmFocusWithSelected(){
  const buttons = getPmButtons();
  if(!buttons.length) return;
  const idx = buttons.findIndex(b => b.classList.contains('on'));
  focusPmButton(idx >= 0 ? idx : 0);
}
function movePmFocus(delta){
  const buttons = getPmButtons();
  if(!buttons.length) return;
  let next = pmFocusIdx + delta;
  if(next < 0) next = buttons.length - 1;
  if(next >= buttons.length) next = 0;
  focusPmButton(next);
}
function movePmFocusVertical(deltaRows){
  const buttons = getPmButtons();
  if(!buttons.length) return;
  const cols = 2;
  let next = pmFocusIdx + (deltaRows * cols);
  if(next < 0) next = pmFocusIdx;
  if(next >= buttons.length){
    // Bajando desde la última fila de medios de pago → saltar al botón Cobrar
    if(deltaRows > 0){ focusCobrarButton(); return; }
    next = pmFocusIdx;
  }
  focusPmButton(next);
}
function focusCobrarButton(){
  clearPmFocus();
  const btn = document.getElementById('btnCobrar');
  if(!btn || btn.disabled) return;
  btn.classList.add('kbd-focus');
  btn.focus({ preventScroll:true });
  btn.scrollIntoView({ block:'nearest' });
}
function focusMPPointButton(){
  const mp = document.getElementById('btnMPPoint');
  if(!mp){ focusCobrarButton(); return; } // no está habilitado Point → se queda en Cobrar
  document.getElementById('btnCobrar')?.classList.remove('kbd-focus');
  mp.classList.add('kbd-focus');
  mp.focus({ preventScroll:true });
  mp.scrollIntoView({ block:'nearest' });
}

/* ══════════════════════════════════════════════════════
   GENERAR PRESUPUESTO DESDE PUNTO DE VENTA
══════════════════════════════════════════════════════ */
async function generarPresupuestoDesdeCarrito() {
  if (!cart.length) { showToast('Carrito vac\u00edo', 'warn'); return; }

  const clienteNombre = (document.getElementById('posClienteSearch')?.value || '').trim();
  const items = cart.map(i => ({
    tipo:'producto', sku:i.sku||null, name:i.name, qty:i.qty, price:i.price,
    subtotal:i.price*i.qty, descuento_item_pct:0, pct_iva:null
  }));
  const discType = document.getElementById('btnPct')?.classList.contains('on') ? 'pct' : 'fixed';
  const discVal  = parseFloat(document.getElementById('discInput')?.value || 0);

  const btn = document.getElementById('btnConfirm');
  const btnHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = 'Generando...'; }
  try {
    const r = await fetch('/presupuestos/crear', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({
        json:1,
        cliente_nombre: clienteNombre || 'Sin nombre',
        condicion_pago: 'Contado',
        descuento_pct:   discType==='pct'   ? discVal : 0,
        descuento_monto: discType==='fixed' ? discVal : 0,
        items_json: JSON.stringify(items)
      })
    });
    if (!r.ok) throw new Error('fallo');
    const data = await r.json();
    if (!data.ok || !data.presupuesto) throw new Error('fallo');
    mostrarModalPresupuestoOk(data.presupuesto);
  } catch (e) {
    console.error(e);
    showToast('Error al generar presupuesto', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = btnHtml; }
  }
}

function calcularTotalPres(p) {
  if (p.total != null) return Number(p.total);
  const items = p.items || [];
  let sub = items.reduce((s,i)=> s + Number(i.subtotal != null ? i.subtotal
        : (Number(i.cantidad||i.qty||0) * Number(i.precio_unitario||i.price||0))), 0);
  const dpct = Number(p.descuento_pct||0), dmon = Number(p.descuento_monto||0);
  return Math.max(0, sub - (dpct>0 ? sub*dpct/100 : 0) - dmon);
}

function mostrarModalPresupuestoOk(pres) {
  window.__presOk = pres;
  const total = calcularTotalPres(pres);
  const overlay = document.createElement('div');
  overlay.id = 'modalPresOk';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:99999;display:flex;align-items:center;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:var(--bg-card);border-radius:16px;padding:26px;max-width:360px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);">
      <div style="width:54px;height:54px;border-radius:50%;background:rgba(16,185,129,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;"><i class="bi bi-file-earmark-check" style="font-size:26px;color:#10b981;"></i></div>
      <div style="font-size: 20.5px;font-weight:800;color:var(--text-primary);">Presupuesto generado</div>
      <div style="font-size: 15px;color:var(--text-secondary);margin-top:2px;">${pres.numero || ''} \u00b7 ${escapeHtml(pres.cliente_nombre || 'Sin nombre')}</div>
      <div style="font-size:26px;font-weight:900;color:var(--color-action);margin:10px 0 18px;">${fmt(total)}</div>
      <div style="display:flex;flex-direction:column;gap:9px;">
        <button onclick="imprimirPresupuestoTermico()" style="padding:12px;border-radius:9px;background:var(--color-primary);color:#fff;border:none;font-size: 16px;font-weight:700;cursor:pointer;"><i class="bi bi-receipt"></i> Imprimir ticket</button>
        <button onclick="window.open('/presupuestos/ver/${pres.id}','_blank')" style="padding:11px;border-radius:9px;background:var(--bg-surface-2);color:var(--text-primary);border:1px solid var(--border-color);font-size: 15px;font-weight:600;cursor:pointer;"><i class="bi bi-printer"></i> Ver / Imprimir A4</button>
        <button onclick="cerrarModalPresOk(true)" style="padding:11px;border-radius:9px;background:transparent;color:var(--text-secondary);border:none;font-size: 15px;font-weight:600;cursor:pointer;">Seguir vendiendo</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

function cerrarModalPresOk(limpiar) {
  const o = document.getElementById('modalPresOk'); if (o) o.remove();
  if (limpiar) { clearCart(); setComprobante('venta'); }
}

function imprimirPresupuestoTermico() {
  const pres = window.__presOk;
  if (!pres) { showToast('No hay presupuesto para imprimir','warn'); return; }
  const cfg = (typeof ticketConfig !== 'undefined' && ticketConfig) ? ticketConfig
            : { formato:'80mm', nombre:'Mi Comercio', direccion:'', telefono:'' };
  const formato = String(cfg.formato || '80mm').toLowerCase();
  const es58 = formato === '58mm';
  const esA4 = formato === 'a4';
  const paperWidth = es58 ? '58mm' : esA4 ? '210mm' : '80mm';
  const winW = es58 ? 245 : esA4 ? 900 : 345;
  const fsBase = es58 ? '11px' : '12px';
  const fsTitle = es58 ? '14px' : '16px';
  const fsTot = es58 ? '15px' : '17px';
  const fsSmall = es58 ? '9px' : '10px';
  const pageMargin = es58 ? '1mm 2mm' : '2mm 3mm';
  const emp = cfg.nombre || 'Mi Comercio';
  const dir = cfg.direccion || '';
  const tel = cfg.telefono || '';

  let sub = 0;
  const itemsHtml = (pres.items || []).map(i => {
    const qty = Number(i.cantidad != null ? i.cantidad : (i.qty||0));
    const pu  = Number(i.precio_unitario != null ? i.precio_unitario : (i.price||0));
    const dpct = Number(i.descuento_item_pct||0);
    const punit = pu * (1 - dpct/100);
    const lsub = qty * punit; sub += lsub;
    return `<tr>
        <td style="padding:5px 0 3px;border-bottom:1px dotted #bbb;line-height:1.35;">
          <span style="font-weight:900;text-transform:uppercase;">${escapeHtml(i.nombre||i.name||'')}</span><br>
          <span style="font-size:${fsSmall};">${qty} x ${fmt(punit)}</span>
        </td>
        <td style="padding:5px 0 3px;text-align:right;font-weight:900;vertical-align:top;border-bottom:1px dotted #bbb;">${fmt(lsub)}</td>
      </tr>`;
  }).join('');

  const dpct = Number(pres.descuento_pct||0), dmon = Number(pres.descuento_monto||0);
  const descTotal = (dpct>0 ? sub*dpct/100 : 0) + dmon;
  const total = pres.total != null ? Number(pres.total) : Math.max(0, sub - descTotal);

  const w = window.open('', '_blank', `width=${winW},height=800`);
  if (!w) { showToast('Habilit\u00e1 las ventanas emergentes para imprimir','warn'); return; }
  w.document.write(`<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>${pres.numero||'Presupuesto'}</title>
    <style>
      *{box-sizing:border-box;margin:0;padding:0;}
      @page{size:${paperWidth} auto;margin:${pageMargin};}
      @media print{html,body{width:${paperWidth};}}
      body{font-family:'Courier New',Courier,monospace;color:#000;font-size:${fsBase};-webkit-print-color-adjust:exact;print-color-adjust:exact;padding:4px;}
      .c{text-align:center;} .sep{border-top:1px dashed #000;margin:6px 0;}
      table{width:100%;border-collapse:collapse;}
      .tot{display:flex;justify-content:space-between;font-size:${fsTot};font-weight:900;border-top:2px solid #000;border-bottom:2px solid #000;padding:4px 0;margin-top:4px;}
    </style></head><body>
    <div class="c" style="font-size:${fsTitle};font-weight:900;text-transform:uppercase;">${escapeHtml(emp)}</div>
    ${dir?`<div class="c" style="font-size:${fsSmall};">${escapeHtml(dir)}</div>`:''}
    ${tel?`<div class="c" style="font-size:${fsSmall};">Tel: ${escapeHtml(tel)}</div>`:''}
    <div class="sep"></div>
    <div class="c" style="font-weight:700;">PRESUPUESTO</div>
    <div class="c">${pres.numero||''}</div>
    <div class="c" style="font-size:${fsSmall};">${new Date(pres.created_at||Date.now()).toLocaleString('es-AR')}</div>
    <div class="sep"></div>
    <div style="font-size:${es58?'10px':'11px'};"><strong>Cliente:</strong> ${escapeHtml(pres.cliente_nombre||'Sin nombre')}</div>
    <div class="sep"></div>
    <table>${itemsHtml}</table>
    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:${fsSmall};"><span>Subtotal</span><strong>${fmt(sub)}</strong></div>
    ${descTotal>0?`<div style="display:flex;justify-content:space-between;font-size:${fsSmall};"><span>Descuento</span><strong>-${fmt(descTotal)}</strong></div>`:''}
    <div class="tot"><span>TOTAL</span><span>${fmt(total)}</span></div>
    <div class="c" style="margin-top:8px;font-size:${fsSmall};">Presupuesto \u00b7 no v\u00e1lido como factura</div>
  </body></html>`);
  w.document.close();
  setTimeout(()=>{ w.focus(); w.print(); }, 400);
}

async function openCobroModal(){
  if(!cart.length)return;

  // Aviso preventivo si el cliente tiene límite configurado
  if (clienteId && clienteId !== 1) {
    try {
      const {total} = getBaseTotal();
      const r = await fetch(`/api/clientes/${clienteId}/check-limite`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ monto: total })
      });
      if (r.ok) {
        const check = await r.json();
        if (!check.ok) {
          const fmtN = n => '$' + Number(n).toLocaleString('es-AR',{minimumFractionDigits:2});
          showToast(`⚠️ Cliente supera límite — disponible ${fmtN(Math.max(0,check.disponible))}`, 'warn');
        }
      }
    } catch(e) {}
  }

  recargoVal=0;
  mixtoActivo=false;
  resetFacturacionToggle();
  document.getElementById('mixtoRow').classList.remove('visible');
  document.getElementById('btnMixto').innerHTML='<i class="bi bi-plus-circle"></i> Activar';
  document.getElementById('btnMixto').style.borderColor='';
  document.getElementById('btnMixto').style.color='';
  document.getElementById('vueltoDisplay').style.display='none';
  document.getElementById('recargoResult').style.display='none';
  document.querySelectorAll('.recargo-chip').forEach(c=>c.classList.remove('on'));
  document.getElementById('recargoCustom').value='';
  document.getElementById('cashReceived').value='';
  document.getElementById('mixtoMonto1').value='';
  document.getElementById('mixtoMonto2').value='';
  document.getElementById('mixtoResto').textContent='';
  updateCobroTotals();
  document.getElementById('cobroOverlay').classList.add('open');
  setTimeout(()=>syncPmFocusWithSelected(),100);
}

function closeCobroModal(){
  document.getElementById('cobroOverlay').classList.remove('open');
  focusScanner();
}

function toggleMixto(){
  mixtoActivo=!mixtoActivo;
  const row=document.getElementById('mixtoRow');
  const btn=document.getElementById('btnMixto');
  row.classList.toggle('visible',mixtoActivo);
  if(mixtoActivo){
    btn.innerHTML='<i class="bi bi-x-circle"></i> Desactivar';
    btn.style.borderColor='#ef4444';
    btn.style.color='#ef4444';
    const sel=document.getElementById('mixtoMetodo2');
    sel.innerHTML=payMethods
      .filter(m=>m.nombre!==payMethod)
      .map(m=>`<option value="${m.nombre}">${m.nombre}</option>`).join('');
    document.getElementById('mixtoMetodo1Nombre').textContent=payMethod;
    calcMixto();
  } else {
    btn.innerHTML='<i class="bi bi-plus-circle"></i> Activar';
    btn.style.borderColor='';
    btn.style.color='';
    document.getElementById('mixtoMonto1').value='';
    document.getElementById('mixtoMonto2').value='';
    document.getElementById('mixtoResto').textContent='';
    document.getElementById('mixtoMonto2').disabled=true;
    document.getElementById('mixtoMonto2').style.opacity='.65';
  }
}

function _getRecargoMixto2() {
  // Obtener el recargo del segundo método en pago mixto
  const sel = document.getElementById('mixtoMetodo2');
  if (!sel) return recargoVal;
  const nombreM2 = sel.value;
  const metodo2 = payMethods.find(m => m.nombre === nombreM2);
  // Si el método principal tiene recargo, usarlo; si no, usar el del segundo método
  if (recargoVal > 0) return recargoVal;
  return metodo2 ? (metodo2.recargo_cliente_pct || 0) : 0;
}

function fmtMixtoInput(inp){
  let raw = inp.value.replace(/\./g,'').replace(/[^0-9]/g,'');
  if(!raw){ inp.value=''; return; }
  inp.value = Number(raw).toLocaleString('es-AR');
  inp._rawVal = raw;
}
function getMixtoVal(inp){
  if(!inp) return 0;
  const raw = (inp._rawVal || inp.value.replace(/\./g,'').replace(/,/g,'.')).replace(/[^0-9.]/g,'');
  return parseFloat(raw)||0;
}

function calcMixto(){
  const {total}=getBaseTotal();
  const m1=getMixtoVal(document.getElementById('mixtoMonto1'));
  const rcMixto = _getRecargoMixto2();
  // El recargo se aplica solo al monto que paga con el segundo medio
  const saldoSinRecargo = total - m1;
  const m2ConRecargo = saldoSinRecargo > 0 ? parseFloat((saldoSinRecargo * (1 + rcMixto/100)).toFixed(2)) : 0;
  const restoEl=document.getElementById('mixtoResto');
  const m2Input=document.getElementById('mixtoMonto2');
  m2Input.value=m2ConRecargo>0?m2ConRecargo.toFixed(2):'0.00';
  m2Input.disabled=false;
  m2Input.style.opacity='1';
  if(saldoSinRecargo<-0.01){
    restoEl.textContent=`Exceso: ${fmt(Math.abs(saldoSinRecargo))}`;
    restoEl.className='mixto-resto negativo';
  } else if(Math.abs(saldoSinRecargo)<0.01){
    restoEl.textContent='✓ Total cubierto';
    restoEl.className='mixto-resto';
  } else {
    const recargoAplicado = m2ConRecargo - saldoSinRecargo;
    restoEl.textContent=`${fmt(saldoSinRecargo)}${rcMixto>0?' + recargo '+fmt(recargoAplicado)+' = '+fmt(m2ConRecargo):''}`;
    restoEl.className='mixto-resto';
  }
  updateCobroTotals();
}

function updateCobroTotals(){
  const{total,disc}=getBaseTotal();
  let totalMostrar, infoText = [];
  if(disc>0) infoText.push(`Descuento: -${fmt(disc)}`);
  if(mixtoActivo){
    const rcM = typeof _getRecargoMixto2 === 'function' ? _getRecargoMixto2() : recargoVal;
    const m1=getMixtoVal(document.getElementById('mixtoMonto1'));
    const saldoTarjeta=Math.max(0,total-m1);
    const recargoSoloTarjeta=saldoTarjeta*rcM/100;
    totalMostrar=m1+(saldoTarjeta*(1+rcM/100));
    if(rcM>0&&saldoTarjeta>0) infoText.push(`Recargo ${rcM}% sobre 2° medio: +${fmt(recargoSoloTarjeta)}`);
  } else {
    totalMostrar=total*(1+recargoVal/100);
    if(recargoVal>0) infoText.push(`Recargo ${recargoVal}%: +${fmt(total*recargoVal/100)}`);
  }
  document.getElementById('cobroTotalAmt').textContent=fmt(totalMostrar);
  const di=document.getElementById('cobroDiscInfo');
  if(infoText.length>0){
    di.style.display='block';
    di.textContent=infoText.join(' · ');
  }else di.style.display='none';
  document.getElementById('btnCobrarTxt').textContent=`Cobrar ${fmt(totalMostrar)}`;
  calcVuelto();
}
function setRecargo(pct,btn){
  recargoVal=pct;
  document.querySelectorAll('.recargo-chip').forEach(c=>c.classList.remove('on'));
  if(btn)btn.classList.add('on');
  document.getElementById('recargoCustom').value='';
  const res=document.getElementById('recargoResult'),{total}=getBaseTotal();
  if(pct>0){
    res.style.display='block';
    res.textContent=`Total: ${fmt(total*(1+pct/100))}`;
  }else res.style.display='none';
  updateCobroTotals();
}
function setRecargoCustom(){
  const v=parseFloat(document.getElementById('recargoCustom').value)||0;
  recargoVal=v;
  document.querySelectorAll('.recargo-chip').forEach(c=>c.classList.remove('on'));
  const res=document.getElementById('recargoResult'),{total}=getBaseTotal();
  if(v>0){
    res.style.display='block';
    res.textContent=`Total: ${fmt(total*(1+v/100))}`;
  }else res.style.display='none';
  updateCobroTotals();
}
function calcVuelto(){
  const{total}=getBaseTotal(),conRecargo=total*(1+recargoVal/100);
  const recibido=parseFloat(document.getElementById('cashReceived').value)||0;
  const display=document.getElementById('vueltoDisplay'),
        isEfectivo=payMethod.toLowerCase()==='efectivo';
  if(!isEfectivo||recibido<=0){display.style.display='none';return;}
  display.style.display='flex';
  const vuelto=recibido-conRecargo,amt=document.getElementById('vueltoAmt');
  if(vuelto>=0){
    amt.textContent=fmt(vuelto);
    display.style.background='rgba(16,185,129,.08)';
    amt.style.color='#059669';
    display.querySelector('span').style.color='#059669';
  }else{
    amt.textContent=`Faltan ${fmt(Math.abs(vuelto))}`;
    display.style.background='rgba(239,68,68,.08)';
    amt.style.color='#ef4444';
    display.querySelector('span').style.color='#ef4444';
  }
}

async function loadPaymentMethods(){
  const fb=[
    {nombre:'Efectivo',icono:'bi-cash-stack',tipo:'efectivo',recargo_cliente_pct:0},
    {nombre:'Débito',icono:'bi-credit-card',tipo:'otro',recargo_cliente_pct:0},
    {nombre:'Crédito',icono:'bi-credit-card-2-front',tipo:'otro',recargo_cliente_pct:0},
    {nombre:'Transferencia',icono:'bi-phone',tipo:'otro',recargo_cliente_pct:0}
  ];
  payMethods=fb;
  try{
    const r=await fetch('/api/payment-methods');
    if(r.ok){
      const d=await r.json();
      if(Array.isArray(d)&&d.length)payMethods=d.map(m=>({
        nombre:m.nombre||m.name||'Pago',
        icono:m.icono||m.icon||'bi-wallet2',
        tipo:m.tipo||'otro',
        recargo_cliente_pct:m.recargo_cliente_pct||0
      }));
    }
  }catch(e){}

  // Garantizar el método "Cuenta corriente": descuenta del saldo a favor del
  // cliente (o lo fía si no tiene). El backend ya respeta el límite de crédito.
  if(!payMethods.some(m => /cuenta\s*corriente/i.test(m.nombre || ''))){
    payMethods.push({ nombre:'Cuenta corriente', icono:'bi-wallet2', tipo:'cuenta_corriente', recargo_cliente_pct:0 });
  }

  const grid=document.getElementById('pmGrid');
  grid.innerHTML=payMethods.map((m,i)=>`<button type="button" class="pm-btn ${i===0?'on':''}" tabindex="-1" data-pm-idx="${i}" data-method="${m.nombre}" data-tipo="${m.tipo}" data-recargo="${m.recargo_cliente_pct}" onclick="selectPayMethod(this)"><i class="bi ${m.icono}"></i><span>${m.nombre}</span>${m.recargo_cliente_pct>0?`<small>+${m.recargo_cliente_pct}%</small>`:''}</button>`).join('');
  payMethod=payMethods[0].nombre;
  recargoVal=payMethods[0].recargo_cliente_pct||0;
  const isEfectivo=payMethods[0].tipo==='efectivo'||payMethods[0].nombre.toLowerCase()==='efectivo';
  document.getElementById('efectivoRow').classList.toggle('visible',isEfectivo);
  if(recargoVal>0)updateCobroTotals();
  pmFocusIdx = 0;
}

function selectPayMethod(btn){
  document.querySelectorAll('#pmGrid .pm-btn').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  payMethod=btn.dataset.method;
  payTipo=btn.dataset.tipo||'';
  if(typeof renderSaldoBadge==='function') renderSaldoBadge();
  pmFocusIdx = Number(btn.dataset.pmIdx || 0);

  const tipo=payTipo,
        rc=parseFloat(btn.dataset.recargo)||0;
  const isEfectivo=tipo==='efectivo'||payMethod.toLowerCase()==='efectivo';
  const isCuentaCorriente=tipo==='cuenta_corriente'||tipo==='fiado';
  const isCard=!isEfectivo&&!isCuentaCorriente;

  if(isCuentaCorriente && (!clienteId || clienteId===1)){
    showToast('Seleccioná un cliente para usar Cuenta Corriente','warn');
    const inp=document.getElementById('cartClienteInp');
    if(inp){ inp.focus(); inp.style.borderColor='#f59e0b'; setTimeout(()=>inp.style.borderColor='',2500); }
  }

  const banner=document.getElementById('recargoInfoBanner');

  if(rc>0){
    recargoVal=rc;
    document.getElementById('recargoRow').classList.remove('visible');
    const{total}=getBaseTotal();
    banner.innerHTML=`<i class="bi bi-info-circle" style="color:#d97706;flex-shrink:0"></i> Recargo <strong>${rc}%</strong> → <strong>${fmt(total*(1+rc/100))}</strong>`;
    banner.classList.add('visible');
  }else{
    recargoVal=0;
    document.getElementById('recargoRow').classList.toggle('visible',isCard);
    banner.classList.remove('visible');
    document.querySelectorAll('.recargo-chip').forEach(c=>c.classList.remove('on'));
    document.getElementById('recargoCustom').value='';
    document.getElementById('recargoResult').style.display='none';
  }

  document.getElementById('efectivoRow').classList.toggle('visible',isEfectivo);
  updateCobroTotals();
  calcVuelto();
  if(isEfectivo){
    // Efectivo: mantenemos el foco en el medio de pago y saltamos al monto recibido
    focusPmButton(pmFocusIdx);
    setTimeout(()=>document.getElementById('cashReceived')?.focus(), 80);
  } else {
    // Cualquier otro medio: saltar directo al botón Cobrar
    focusCobrarButton();
  }

  if(mixtoActivo){
    document.getElementById('mixtoMetodo1Nombre').textContent = payMethod;
    const sel=document.getElementById('mixtoMetodo2');
    sel.innerHTML=payMethods
      .filter(m=>m.nombre!==payMethod)
      .map(m=>`<option value="${m.nombre}">${m.nombre}</option>`).join('');
    calcMixto();
  }
}

function renderClienteDrop(list, query){
  const drop=document.getElementById('posClienteResultados');
  const q = query || document.getElementById('posClienteSearch').value.trim();
  if(!list||!list.length){
    // Sin resultados — mostrar botón crear cliente
    if (q && q.length > 0) {
      drop.innerHTML = `<div style="padding:10px 12px;">
        <div style="font-size: 13px;color:var(--text-secondary);margin-bottom:8px;">Sin resultados para "<strong>${q}</strong>"</div>
        <button onmousedown="abrirCrearClienteRapido('${q.replace(/'/g,"\\'")}');"
          style="width:100%;padding:8px 12px;background:rgba(27,79,216,.1);color:var(--color-primary);border:1.5px solid rgba(27,79,216,.3);border-radius:8px;font-size: 14px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:6px;">
          <i class="bi bi-person-plus-fill"></i> Crear cliente "${q}"
        </button>
      </div>`;
      drop.classList.add('visible');
    } else {
      drop.classList.remove('visible');
    }
    return;
  }
  drop.innerHTML=list.map(c=>{
    const nom=c.nombre||'',tel=c.telefono||'',saldo=Number(c.saldo||0);
    const sTag=saldo>0?`<span style="font-size: 11.5px;font-weight:700;color:#dc2626;background:rgba(239,68,68,.1);padding:1px 5px;border-radius:8px">Debe ${fmt(saldo)}</span>`:'';
    const dTag=c.id===1?`<span style="font-size: 11.5px;font-weight:700;color:var(--color-action);background:rgba(0,180,216,.1);padding:1px 5px;border-radius:8px;margin-left:4px">Default</span>`:'';
    return `<div style="padding:7px 11px;cursor:pointer;border-bottom:1px solid var(--border-color);font-size: 14px;display:flex;align-items:center;justify-content:space-between;gap:8px;transition:background .1s" onmouseenter="this.style.background='rgba(0,180,216,.06)'" onmouseleave="this.style.background=''" onmousedown="selClientePos(${c.id},'${nom.replace(/'/g,"\\'")}','${tel.replace(/'/g,"\\'")}')"><div><strong>${nom}</strong>${dTag}${tel?`<span style="color:var(--text-secondary);font-size: 12px;margin-left:5px">${tel}</span>`:''}</div>${sTag}</div>`;
  }).join('');
  // Agregar opción de crear nuevo al final si hay búsqueda activa
  if (q && q.length > 1) {
    drop.innerHTML += `<div style="padding:7px 11px;border-top:1px solid var(--border-color);">
      <button onmousedown="abrirCrearClienteRapido('${q.replace(/'/g,"\\'")}');"
        style="width:100%;padding:6px 10px;background:transparent;color:var(--color-primary);border:1px dashed rgba(27,79,216,.4);border-radius:6px;font-size: 13px;font-weight:600;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:5px;">
        <i class="bi bi-person-plus"></i> Crear nuevo cliente
      </button>
    </div>`;
  }
  drop.classList.add('visible');
}
async function mostrarTodosClientes(){try{const r=await fetch('/api/clientes');if(!r.ok)return;renderClienteDrop(await r.json());}catch(e){}}
function buscarClientePos(q){
  clearTimeout(posClienteDebounce);
  if(!q||q.trim().length<1){mostrarTodosClientes();return;}
  posClienteDebounce=setTimeout(async()=>{
    try{
      const r=await fetch('/api/clientes?q='+encodeURIComponent(q));
      if(!r.ok)return;
      renderClienteDrop(await r.json(), q);
    }catch(e){}
  },200);
}

/* ════════════════════════════════════
