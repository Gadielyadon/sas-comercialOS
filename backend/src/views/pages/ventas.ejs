  .cart-card-price{ font-size:23px;font-weight:800;color:var(--color-primary);letter-spacing:-.3px;min-width:78px;text-align:right; }
  .qty-ctrl{ display:inline-flex;align-items:center;border:1px solid var(--border-color);border-radius:5px;overflow:hidden;background:var(--bg-body); }
  .qty-btn{ width:19px;height:19px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:var(--text-secondary);font-size: 12.5px;cursor:pointer;font-weight:700; }
  .qty-btn:hover{ background:rgba(27,79,216,.1);color:var(--color-primary); }
  .qty-val{ min-width:19px;text-align:center;font-family:var(--font-body);font-size: 12.5px;font-weight:700;color:var(--text-primary);border-left:1px solid var(--border-color);border-right:1px solid var(--border-color);height:19px;line-height:19px; }
  .btn-del{ width:17px;height:17px;border:none;background:transparent;color:var(--text-muted);border-radius:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size: 12.5px;flex-shrink:0; }
  .btn-del:hover{ background:rgba(239,68,68,.1);color:#ef4444; }
  .cart-promo-tag{ position:absolute;top:2px;right:28px;font-size: 8px;font-weight:800;background:#f59e0b;color:#fff;padding:1px 4px;border-radius:4px;text-transform:uppercase; }

  /* Footer */
  .cart-footer{ flex-shrink:0;border-top:1px solid var(--border-color);background:transparent;padding:8px 10px;display:flex;flex-direction:column;gap:5px; }

  /* Descuento */
  .cart-disc-row{ display:flex;align-items:center;justify-content:space-between;gap:8px; }
  .cart-disc-lbl{ font-size: 12px;font-weight:700;color:var(--text-secondary);display:flex;align-items:center;gap:4px;white-space:nowrap; }
  .disc-bar{ display:flex;gap:4px;align-items:center; }
  .disc-type-btn{ padding:2px 7px;border-radius:5px;border:1.5px solid var(--border-color);background:var(--bg-body);font-size: 12.5px;font-weight:700;color:var(--text-secondary);cursor:pointer;transition:all .1s; }
  .disc-type-btn.on{ border-color:var(--color-primary);background:rgba(27,79,216,.08);color:var(--color-primary); }
  .disc-input{ width:50px;border:1.5px solid var(--border-color);background:var(--bg-body);border-radius:5px;padding:2px 5px;font-family:var(--font-mono);font-size: 13.5px;font-weight:600;color:var(--text-primary);outline:none;text-align:right; }
  .disc-input:focus{ border-color:var(--color-primary); }
  .disc-suffix{ font-size: 12.5px;font-weight:700;color:var(--text-secondary);flex-shrink:0; }

  /* Resumen numérico */
  .cart-resumen{ background:var(--bg-body);border:1px solid var(--border-color);border-radius:9px;overflow:hidden; }
  .res-row{ display:flex;justify-content:space-between;align-items:center;padding:5px 11px;font-size: 13.5px;border-bottom:1px solid var(--border-color); }
  .res-row span:first-child{ color:var(--text-secondary);font-weight:500; }
  .res-row span:last-child{ font-family:var(--font-body);font-weight:700;color:var(--text-primary); }
  .res-total{ display:flex;justify-content:space-between;align-items:center;padding:9px 11px;background:var(--color-primary); }
  #subtotalVal{ font-size: 21.5px !important; font-weight:800 !important; }
  .res-row:has(#subtotalVal){ padding-top:8px; padding-bottom:8px; }
  .res-total span:first-child{ font-size: 12.5px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:rgba(255,255,255,.85); }
  .res-total span:last-child{ font-family:var(--font-body);font-size:24px;font-weight:900;color:#fff;letter-spacing:-.5px; }

  /* Botón */
  .btn-confirm{ width:100%;padding:11px;border-radius:9px;border:none;background:var(--color-primary);color:#fff;font-family:var(--font-body);font-size: 16px;font-weight:700;cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 3px 12px rgba(27,79,216,.3); }
  .btn-confirm:hover:not(:disabled){ transform:translateY(-1px);box-shadow:0 5px 18px rgba(27,79,216,.45); }
  .btn-confirm:disabled{ opacity:.35;cursor:not-allowed;box-shadow:none;transform:none; }
  .kbd-hint{ font-size: 11.5px;opacity:.75;background:rgba(255,255,255,.2);border-radius:4px;padding:1px 5px;font-family:var(--font-mono); }

  }

  /* Bloque total */
  .totals-block{
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 14px 30px rgba(22,163,74,.22);
    background:linear-gradient(135deg,#169c45 0%, #22c55e 100%);
  }
  .tot-row{
    padding:11px 16px;
    background:rgba(0,0,0,.10);
    font-size: 16px;
  }
  .tot-row span:first-child{
    color:rgba(255,255,255,.86);
    font-weight:700;
  }
  .tot-row span:last-child{
    color:#fff;
    font-size: 17px;
    font-weight:800;
  }
  .total-highlight{
    padding:16px;
    align-items:flex-end;
  }
  .total-highlight-label{
    font-size: 16px;
    font-weight:900;
    letter-spacing:1px;
  }
  .total-highlight-value{
    font-size:42px;
    font-weight:900;
    letter-spacing:-2px;
  }

  .btn-confirm{
    min-height:54px;
    border-radius:16px;
    background:var(--color-primary);
    box-shadow:0 10px 24px rgba(27,79,216,.25);
    font-size: 18px;
    font-weight:800;
  }
  .btn-confirm:hover:not(:disabled){
    box-shadow:0 14px 30px rgba(27,79,216,.35);
  }
  .btn-confirm:disabled{
    background:linear-gradient(135deg,#fecaca,#fca5a5);
    opacity:.9;
  }
  /* Cobro modal */
  .cobro-modal{
    border-radius:24px;
    background:var(--bg-card);
  }
  .cobro-header{
    background:var(--bg-card);
    border-bottom:1px solid var(--border-color);
  }
  .cobro-title{
    font-size: 21.5px;
    font-weight:900;
    color:var(--text-primary);
  }
  .cobro-left{
    background:var(--bg-body);
  }
  .cobro-right{
    background:var(--bg-card);
  }
  .cobro-total-box{
    background:#1fa24f;
    border:none;
    box-shadow:0 4px 16px rgba(0,0,0,.25);
  }
  .cobro-total-lbl{
    color:rgba(255,255,255,.65);
  }
  .cobro-total-amt{
    color:#ffffff;
  }
  .cobro-section{
    background:var(--bg-card);
    border:1px solid var(--border-color);
    box-shadow:none;
  }
  .pm-btn{
    min-height:110px;
    border-radius:16px;
    background:var(--bg-card);
    border:1.5px solid var(--border-color);
    box-shadow:none;
  }
  .pm-btn i { color:var(--text-secondary); }
  .pm-btn span { color:var(--text-secondary); }
  .pm-btn:hover{
    background:var(--bg-hover);
    border-color:var(--color-primary);
  }
  .pm-btn.on{
    background:rgba(27,79,216,.1);
    border-color:var(--color-primary);
    box-shadow:0 0 0 3px rgba(27,79,216,.12);
  }
  .pm-btn.on i,.pm-btn.on span{ color:var(--color-primary); }
  .btn-cobrar{
    border-radius:16px;
    box-shadow:0 8px 20px rgba(15,110,86,.2);
  }

  /* Modal éxito */
  .exito-modal{
    width:340px;
    border-radius:24px;
    box-shadow:0 24px 64px rgba(15,23,42,.18);
  }
  .exito-total{
    font-size:34px;
    font-weight:900;
    color:var(--color-primary);
  }

  /* Modal AFIP */
  .afip-modal{
    border-radius:22px;
    box-shadow:0 24px 64px rgba(15,23,42,.18);
  }
  .afip-tipo-btn{
    border-radius:14px;
  }

  /* ── Lightbox zoom imagen producto ── */
  .prod-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
  }
  .prod-zoom-overlay.open {
    opacity: 1;
    pointer-events: all;
  }
  .prod-zoom-box {
    position: relative;
    background: var(--bg-surface);
    border-radius: 18px;
    padding: 12px;
    box-shadow: 0 32px 80px rgba(0,0,0,.45);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 90vw;
    max-height: 90vh;
    transform: scale(.93);
    transition: transform .2s ease;
  }
  .prod-zoom-overlay.open .prod-zoom-box {
    transform: scale(1);
  }
  #prodZoomImg {
    max-width: min(520px, 85vw);
    max-height: 65vh;
    object-fit: contain;
    border-radius: 10px;
    display: block;
  }
  .prod-zoom-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
    max-width: 500px;
  }
  .prod-zoom-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #ef4444;
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 4px 12px rgba(0,0,0,.25);
    transition: background .15s, transform .15s;
  }
  .prod-zoom-close:hover { background: #dc2626; transform: scale(1.1); }

  /* Responsivo */
  @media (max-width: 1100px){
    .pos-wrapper{
      gap:12px;
      padding:12px;
    }
    .pos-left{ width:60%; }
    .pos-right{ width:40%; }
    /* En tablet ocultar columna de descripción */
    .prod-desc { display:none; }
  }
  @media (max-width: 860px){
    body{ overflow:auto; }
    .main-content{
      height:auto;
      min-height:100vh;
      overflow:visible;
    }
    .pos-wrapper{
      padding:8px;
      gap:8px;
      /* En mobile: apilar paneles y ocultar uno */
      flex-direction: column;
    }
    .pos-left,
    .pos-right{
      width:100%;
      border-radius:18px;
    }
    /* Mobile: un panel a la vez */
    .pos-left  { display: flex; }
    .pos-right { display: none; }
    .pos-left.panel-hidden  { display: none; }
    .pos-right.panel-visible { display: flex; }

    .pos-topbar{
      flex-wrap:wrap;
      gap:8px;
    }
    .sc-chips{
      width:100%;
      flex-wrap:wrap;
    }
    .sc-chip{
      flex:1;
      justify-content:center;
      min-width:90px;
      font-size: 13.5px;
    }
    /* Ocultar columnas no críticas */
    .prod-desc { display:none; }
    .prod-price-old { display:none; }
    .prod-th.th-stock { display:none; }
    .prod-td:nth-child(3) { display:none; }

    /* FAB — botón flotante para alternar carrito/catálogo */
    .fab-cart {
      display: flex !important;
    }
  }
  @media (max-width: 520px){
    .prod-td-img { display:none; }
    .prod-th.th-img { display:none; }
    .total-highlight-value{ font-size:30px; }
    .sc-chip kbd { display:none; }
    .pos-wrapper { padding:6px; gap:6px; }
  }

  /* FAB flotante — siempre oculto en desktop */
  .fab-cart {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 16px;
    z-index: 300;
    align-items: center;
    gap: 0;
    flex-direction: column;
  }
  .fab-btn {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: none;
    background: var(--color-primary);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(27,79,216,.5);
    transition: transform .15s, box-shadow .15s;
    position: relative;
  }
  .fab-btn:active { transform: scale(.93); }
  .fab-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ef4444;
    color: #fff;
    font-size: 12.5px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
  }
  .fab-label {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-secondary);
    margin-top: 4px;
    text-align: center;
    letter-spacing: .3px;
  }

  /* Oscuro refinado */
  [data-theme="dark"] .pos-wrapper,
  [data-theme="dark"] .main-content{
    background:#0f1319;
  }
  [data-theme="dark"] .pos-left{
    background:#171b22;
  }
  [data-theme="dark"] .pos-right{
    background:#12171d;
  }
  [data-theme="dark"] .pos-topbar,
  [data-theme="dark"] .cart-header,
  [data-theme="dark"] .cobro-header{
    background:#171b22;
    border-color:rgba(255,255,255,.08);
  }
  [data-theme="dark"] .products-scroll{
    background:#11161c;
  }
  [data-theme="dark"] .prod-card{
    background:#171b22;
  }
  [data-theme="dark"] .prod-card:hover{
    background:#1e2640;
  }
  [data-theme="dark"] .prod-card.in-cart{
    background:#1e2a4a;
  }
  [data-theme="dark"] .prod-thumb-empty{
    background:#1b222c;
    border-color:rgba(255,255,255,.08);
  }
  [data-theme="dark"] .prod-table-head{
    background:#1e3a8a;
  }

  /* ── Dark mode carrito ── */
  [data-theme="dark"] .cart-list { background:transparent; }
  [data-theme="dark"] .cart-header,
  [data-theme="dark"] .cart-cliente-bloque,
  [data-theme="dark"] .cart-footer { background:transparent; border-color:rgba(255,255,255,.07) !important; }
  [data-theme="dark"] .pos-right { background:#12171d; }
  [data-theme="dark"] .pos-left { background:#171b22; }
  [data-theme="dark"] .cart-empty-state { background:#161b24; border-color:rgba(255,255,255,.08); }
  [data-theme="dark"] .cart-card { background:#161b24; border-color:rgba(255,255,255,.08); }
  [data-theme="dark"] .cart-card:hover { background:#1a2133; }
  [data-theme="dark"] .cart-card-name { color:#e2e8f0; }
  [data-theme="dark"] .cart-card-price { color:#60a5fa; }
  [data-theme="dark"] .qty-ctrl { background:#0f1319; border-color:rgba(255,255,255,.1); }
  [data-theme="dark"] .qty-val { color:#e2e8f0; border-color:rgba(255,255,255,.08); }
  [data-theme="dark"] .qty-btn { color:#94a3b8; }
  [data-theme="dark"] .qty-btn:hover { background:rgba(96,165,250,.12); color:#60a5fa; }
  [data-theme="dark"] .comp-btn { background:#161b24; border-color:rgba(255,255,255,.1); color:#94a3b8; }
  [data-theme="dark"] .cart-cliente-inp,
  [data-theme="dark"] .disc-input { background:#0f1319; border-color:rgba(255,255,255,.1); color:#e2e8f0; }
  [data-theme="dark"] .disc-type-btn { background:#161b24; border-color:rgba(255,255,255,.1); color:#94a3b8; }
  [data-theme="dark"] .disc-type-btn.on { background:rgba(96,165,250,.15); border-color:rgba(96,165,250,.4); color:#60a5fa; }
  [data-theme="dark"] .cart-resumen { background:#0f1319; border-color:rgba(255,255,255,.08); }
  [data-theme="dark"] .res-row { border-color:rgba(255,255,255,.06); }
  [data-theme="dark"] .res-row span:first-child { color:#94a3b8; }
  [data-theme="dark"] .res-row span:last-child { color:#e2e8f0; }

  /* ── Modal teclado numérico ── */
  .numpad-overlay { position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:500;display:none;align-items:flex-end;justify-content:center;padding:0 0 0 var(--sidebar-width); }
  .numpad-overlay.open { display:flex; }
  .numpad-modal { background:var(--bg-card);border-radius:20px 20px 0 0;width:100%;max-width:320px;overflow:hidden;box-shadow:0 -8px 32px rgba(0,0,0,.25);animation:numpadIn .2s ease; }
  @keyframes numpadIn { from{transform:translateY(100%)} to{transform:translateY(0)} }
  .numpad-header { padding:12px 16px 8px;border-bottom:1px solid var(--border-color); }
  .numpad-product { font-size: 13.5px;color:var(--text-secondary);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px; }
  .numpad-display { font-size:36px;font-weight:900;color:var(--text-primary);font-family:var(--font-mono);text-align:right;letter-spacing:-1px;min-height:44px;line-height:44px; }
  .numpad-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-color); }
  .numpad-key { padding:16px 8px;border:none;background:var(--bg-card);color:var(--text-primary);font-size: 23px;font-weight:700;cursor:pointer;font-family:var(--font-mono);transition:background .1s;text-align:center; }
  .numpad-key:hover { background:var(--bg-hover); }
  .numpad-key:active { background:rgba(27,79,216,.12); }
  .numpad-key.key-del { font-size: 16px;font-weight:800;color:var(--text-secondary); }
  .numpad-key.key-ok { background:var(--color-primary);color:#fff;font-size: 18px; }
  .numpad-key.key-ok:hover { background:#1540b8; }
  @media (max-width:860px) { .numpad-overlay { padding:0; } }

  /* ── Modo ventana (opcional, desde Ajustes → Apariencia) ── */
  .main-content.pos-modo-ventana {
    background: var(--bg-body);
    padding: 22px;
    position: relative;
  }
  .main-content.pos-modo-ventana .pos-wrapper {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    overflow: hidden;
    height: 100%;
  }
  .pos-modo-ventana-logo {
    position: absolute; bottom: 16px; right: 22px;
    max-height: 40px; max-width: 130px; object-fit: contain;
    opacity: .5; pointer-events: none;
  }
  @media (max-width:860px) {
    .main-content.pos-modo-ventana { padding: 0; }
    .main-content.pos-modo-ventana .pos-wrapper { max-width: 100%; border-radius: 0; border: none; }
    .pos-modo-ventana-logo { display: none; }
  }
</style>


<div class="app-wrapper">
  <%- include('../partials/sidebar', { active: 'ventas', user }) %>
  <script>
    // En Ventas el menú lateral siempre arranca escondido (más lugar para
    // el POS) — sin pisar la preferencia general guardada en localStorage,
    // así el resto de las pantallas no se ve afectado.
    if (window.innerWidth > 768) { document.body.classList.add('sidebar-collapsed'); }
  </script>
  <% const modoVentanaPos = true; %>
  <div class="main-content<%= modoVentanaPos ? ' pos-modo-ventana' : '' %>">
    <%- include('../partials/header', { module: 'Punto de Venta', user }) %>
    <% if (modoVentanaPos && config && config.empresa_logo) { %>
      <img src="<%= config.empresa_logo %>" class="pos-modo-ventana-logo" alt="">
    <% } %>
    <div class="pos-wrapper">

      <!-- IZQUIERDA -->
      <div class="pos-left">
        <div class="pos-topbar">
          
          <div class="scan-zone" id="scanZone">
            <span class="scan-dot" id="scanDot"></span>
            <i class="bi bi-upc-scan scan-icon"></i>
            <input type="text" id="barcodeInput" name="ax-scan-<%= Date.now() %>" placeholder="Escaneá código o buscá por nombre…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other" autofocus>
            <span id="qtyMultBadge" style="display:none;align-items:center;justify-content:center;background:var(--color-primary);color:#fff;font-weight:800;font-size: 15px;border-radius:7px;padding:3px 9px;margin-left:6px;white-space:nowrap;">×1</span>
          </div>
          <div class="sc-chips">
            <div class="sc-chip chip-cobrar" onclick="cart.length?openCobroModal():showToast('Carrito vacío','warn')" title="Enter (con el buscador vacío) o F10 — Cobrar"><kbd>Enter</kbd> Cobrar</div>
            <div class="sc-chip chip-deptos" id="chipDeptos" onclick="toggleDeptosChip(this)" title="F5 — Departamentos">
              <kbd>F5</kbd> Departamentos
            </div>
            <% if (typeof sucursal !== 'undefined' && sucursal && sucursal.nombre && sucursal.nombre !== 'Casa Central') { %>
            <div style="display:inline-flex;align-items:center;gap:5px;font-size: 12.5px;font-weight:700;
              color:var(--color-primary);background:rgba(27,79,216,.08);border:1.5px solid rgba(27,79,216,.25);
              border-radius:8px;padding:5px 10px;white-space:nowrap;flex-shrink:0;">
              <i class="bi bi-shop"></i> <%- sucursal.nombre %>
            </div>
            <% } %>
            <!-- Vendedor activo — clic para cambiar con PIN, sin cerrar sesión -->
            <div id="chipVendedor" onclick="abrirSelectorVendedor()" title="Cambiar quién está atendiendo"
              style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:var(--radius-sm);border:1.5px solid rgba(168,85,247,.35);background:rgba(168,85,247,.07);color:#a855f7;font-size: 14px;font-weight:700;cursor:pointer;font-family:var(--font-body);white-space:nowrap;flex-shrink:0;">
              <i class="bi bi-person-badge"></i> <span id="vendedorActivoNombre">…</span>
            </div>

            <div class="afip-overlay" id="vendedorOverlay" onclick="if(event.target===this)cerrarSelectorVendedor()">
              <div style="width:100%;max-width:340px;background:var(--bg-surface);border:1px solid var(--border-color);border-radius:var(--radius-lg);box-shadow:0 20px 60px rgba(0,0,0,.35);overflow:hidden;">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border-color);">
                  <div style="font-size: 16.5px;font-weight:700;color:var(--text-primary);"><i class="bi bi-person-badge" style="color:#a855f7;margin-right:6px;"></i>¿Quién está atendiendo?</div>
                  <button onclick="cerrarSelectorVendedor()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size: 19.5px;"><i class="bi bi-x-lg"></i></button>
                </div>

                <div id="vendedorListaWrap" style="padding:14px 16px;display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;">
                  <div style="text-align:center;padding:20px;color:var(--text-muted);font-size: 14px;">Cargando...</div>
                </div>

                <div id="vendedorPinWrap" style="display:none;padding:18px 20px;">
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                    <button onclick="volverListaVendedores()" style="background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size: 18px;padding:2px;"><i class="bi bi-arrow-left"></i></button>
                    <span style="font-size: 15.5px;font-weight:700;color:var(--text-primary);" id="vendedorPinNombre">—</span>
                  </div>
                  <input type="text" id="vendedorPinInput" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="PIN"
                    autocomplete="new-password" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-form-type="other"
                    style="width:100%;padding:14px;border-radius:10px;font-size:22px;text-align:center;letter-spacing:6px;-webkit-text-security:disc;text-security:disc;">
                  <div id="vendedorPinError" style="display:none;margin-top:8px;padding:8px 12px;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.2);border-radius:8px;color:#dc2626;font-size: 14px;text-align:center;"></div>
                  <button onclick="confirmarPinVendedor()" style="width:100%;margin-top:12px;padding:12px;border:none;border-radius:10px;background:#a855f7;color:#fff;font-size: 16px;font-weight:700;cursor:pointer;">Confirmar</button>
                </div>
              </div>
            </div>

            <script>
              let _vendedorSeleccionado = null;

              async function cargarVendedorActivo() {
                try {
                  const r = await fetch('/api/vendedor-activo');
                  if (r.ok) {
                    const v = await r.json();
                    const el = document.getElementById('vendedorActivoNombre');
                    if (el) el.textContent = v.nombre || '—';
                  }
                } catch(e) {}
              }

              async function abrirSelectorVendedor() {
                const overlay = document.getElementById('vendedorOverlay');
                const wrap = document.getElementById('vendedorListaWrap');
                document.getElementById('vendedorPinWrap').style.display = 'none';
                wrap.style.display = 'flex';
                overlay.classList.add('open');
                wrap.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size: 14px;">Cargando...</div>';
                try {
                  const r = await fetch('/api/empleados-activos');
                  const empleados = r.ok ? await r.json() : [];
                  if (!empleados.length) {
                    wrap.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size: 14px;">No hay empleados cargados en Ajustes.</div>';
                    return;
                  }
                  wrap.innerHTML = '';
                  empleados.forEach(emp => {
                    const btn = document.createElement('button');
                    btn.style.cssText = 'display:flex;align-items:center;justify-content:space-between;width:100%;padding:12px 14px;border-radius:10px;border:1.5px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-primary);font-size: 15.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);text-align:left;';
                    btn.innerHTML = `<span>${emp.nombre}</span>` + (emp.tiene_pin ? '' : '<span style="font-size: 12.5px;color:var(--text-muted);font-weight:500;">sin PIN</span>');
                    btn.disabled = !emp.tiene_pin;
                    if (!emp.tiene_pin) btn.style.opacity = '.5';
                    btn.onclick = () => elegirVendedor(emp);
                    wrap.appendChild(btn);
                  });
                } catch(e) {
                  wrap.innerHTML = '<div style="text-align:center;padding:20px;color:#dc2626;font-size: 14px;">Error al cargar empleados.</div>';
                }
              }

              function elegirVendedor(emp) {
                _vendedorSeleccionado = emp;
                document.getElementById('vendedorListaWrap').style.display = 'none';
                document.getElementById('vendedorPinWrap').style.display = 'block';
                document.getElementById('vendedorPinNombre').textContent = emp.nombre;
                document.getElementById('vendedorPinError').style.display = 'none';
                const inp = document.getElementById('vendedorPinInput');
                inp.value = '';
                setTimeout(() => inp.focus(), 60);
              }

              function volverListaVendedores() {
                document.getElementById('vendedorPinWrap').style.display = 'none';
                document.getElementById('vendedorListaWrap').style.display = 'flex';
              }

              async function confirmarPinVendedor() {
                if (!_vendedorSeleccionado) return;
                const pin = document.getElementById('vendedorPinInput').value.trim();
                const errEl = document.getElementById('vendedorPinError');
                errEl.style.display = 'none';
                if (!pin) return;
                try {
                  const r = await fetch('/api/vendedor-activo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ user_id: _vendedorSeleccionado.id, pin }),
                  });
                  const data = await r.json();
                  if (!r.ok) {
                    errEl.textContent = data.error || 'PIN incorrecto';
                    errEl.style.display = 'block';
                    document.getElementById('vendedorPinInput').value = '';
                    return;
                  }
                  document.getElementById('vendedorActivoNombre').textContent = data.nombre;
                  cerrarSelectorVendedor();
                  if (typeof showToast === 'function') showToast(`Atendiendo: ${data.nombre}`, 'success');
                } catch(e) {
                  errEl.textContent = 'Error de conexión';
                  errEl.style.display = 'block';
                }
              }

              function cerrarSelectorVendedor() {
                document.getElementById('vendedorOverlay').classList.remove('open');
                _vendedorSeleccionado = null;
              }

              document.getElementById('vendedorPinInput')?.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); confirmarPinVendedor(); }
              });

              cargarVendedorActivo();
            </script>

            <!-- Selector lista de precio — desplegable simple -->
            <div style="position:relative;flex-shrink:0;" id="listaWrap">
              <button id="btnLista" onclick="toggleDropLista()" title="F6 — Lista de precio"
                style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:var(--radius-sm);border:1.5px solid rgba(16,185,129,.35);background:rgba(16,185,129,.06);color:#059669;font-size: 14px;font-weight:700;cursor:pointer;font-family:var(--font-body);transition:all .15s;white-space:nowrap;">
                <kbd style="background:#10b981;color:#fff;font-size: 10.5px;font-weight:800;padding:1px 5px;border-radius:4px;letter-spacing:.3px;">F6</kbd>
                <i class="bi bi-tags" id="listaIcon"></i>
                <span id="listaNombre">Minorista</span>
                <i class="bi bi-chevron-down" style="font-size: 11.5px;opacity:.7;"></i>
              </button>
              <div id="dropLista"
                style="display:none;position:absolute;top:calc(100% + 5px);right:0;min-width:160px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:200;overflow:hidden;">
                <div style="padding:5px;">
                  <button onclick="selLista(0)" id="listaOpt0"
                    style="width:100%;padding:8px 12px;border:none;background:transparent;text-align:left;font-size: 15px;font-weight:600;cursor:pointer;border-radius:7px;display:flex;align-items:center;gap:8px;font-family:var(--font-body);color:var(--text-primary);transition:background .1s;"
                    onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                    <i class="bi bi-person" style="color:#10b981;width:14px;"></i> Minorista
                  </button>
                  <button onclick="selLista(1)" id="listaOpt1"
                    style="width:100%;padding:8px 12px;border:none;background:transparent;text-align:left;font-size: 15px;font-weight:600;cursor:pointer;border-radius:7px;display:flex;align-items:center;gap:8px;font-family:var(--font-body);color:var(--text-primary);transition:background .1s;"
                    onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                    <i class="bi bi-building" style="color:#6366f1;width:14px;"></i> Mayorista
                  </button>
                  <button onclick="selLista(2)" id="listaOpt2"
                    style="width:100%;padding:8px 12px;border:none;background:transparent;text-align:left;font-size: 15px;font-weight:600;cursor:pointer;border-radius:7px;display:flex;align-items:center;gap:8px;font-family:var(--font-body);color:var(--text-primary);transition:background .1s;"
                    onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                    <i class="bi bi-credit-card" style="color:#f59e0b;width:14px;"></i> Tarjeta
