// cat-bar eliminada
function buildCatBar(){ /* eliminado */ }

function filterCat(cat,btn){
  catActiva=cat;
  document.getElementById('barcodeInput').value='';
  renderGrid(cat?allProducts.filter(p=>p.category===cat):allProducts);
}
// ── Renderizado virtualizado — solo muestra los productos visibles ──
const CHUNK_SIZE = 40; // productos por lote
let _renderTimer = null;
let _lastRenderedProducts = [];

function renderGrid(products){
  const grid = document.getElementById('productsGrid');
  if (!products.length) {
    grid.innerHTML = '<div class="products-empty"><i class="bi bi-box-seam"></i><p>Sin productos</p></div>';
    return;
  }
  _lastRenderedProducts = products;
  // Limpiar timer anterior si hay uno pendiente
  if (_renderTimer) { clearTimeout(_renderTimer); _renderTimer = null; }

  const header = `<div class="prod-table-head">
    <div class="prod-th th-img"></div>
    <div class="prod-th">Producto</div>
    <div class="prod-th th-stock" style="text-align:center;">Stock</div>
    <div class="prod-th th-price" style="text-align:right;">Precio</div>
  </div>`;

  grid.innerHTML = header;

  // Renderizar en chunks para no bloquear el hilo principal
  let idx = 0;
  function renderChunk() {
    const fragment = document.createDocumentFragment();
    const end = Math.min(idx + CHUNK_SIZE, products.length);
    for (let i = idx; i < end; i++) {
      const el = document.createElement('div');
      el.innerHTML = buildProductCard(products[i]);
      fragment.appendChild(el.firstChild);
    }
    grid.appendChild(fragment);
    idx = end;
    if (idx < products.length) {
      _renderTimer = setTimeout(renderChunk, 0);
    }
  }
  renderChunk();
}

function buildProductCard(p) {
  const ep = getPrecioLista(p);
  const esPromo = p.en_promo && p.price_promo && _listaIdx === 0;
  const lista   = LISTAS[_listaIdx];
  const precioBase = Number(p.price);
  const tienePrecioEspecial = lista.campo !== 'price' && p[lista.campo] && Number(p[lista.campo]) > 0;
  const promoOld = esPromo
    ? `<span class="prod-price-old">${fmt(p.price)}</span>`
    : tienePrecioEspecial
      ? `<span class="prod-price-old" style="font-size: 10.5px;">${fmt(precioBase)}</span>`
      : '';
  const promoBadge = esPromo
    ? '<span class="prod-badge-promo">Promo</span>'
    : tienePrecioEspecial
      ? `<span class="prod-badge-promo" style="background:${_listaIdx===1?'#6366f1':'#f59e0b'};font-size: 9px;">${lista.label}</span>`
      : '';
  const stock = Number(p.stock ?? 0);
  const esLibre = p.pesable || p.venta_sin_stock;
  const hayDisponible = (p.hay == null || p.hay == 1);
  const sinStock = esLibre ? !hayDisponible : stock <= 0;
  const inCart = cart.find(i => i.sku === p.sku);
  const stockCls = esLibre ? (hayDisponible ? 'ok' : 'zero') : (stock <= 0 ? 'zero' : stock <= 5 ? 'low' : 'ok');
  const stockTxt = esLibre ? (hayDisponible ? 'Hay' : 'No hay') : (stock <= 0 ? '0' : String(stock));
  const skuSafe = p.sku.replace(/'/g, "\\'");
  const nameSafe = p.name.replace(/"/g, '&quot;');
  const imgSafe = p.imagen ? p.imagen.replace(/"/g, '&quot;') : '';
  const inCartBadge = inCart ? `<span class="prod-badge-qty">${inCart.qty}</span>` : '';
  const descHTML = p.descripcion ? `<div class="prod-desc">${p.descripcion}</div>` : '';
  const sinStockBadge = sinStock ? '<span class="prod-sin-stock">Sin stock</span>' : '';
  const _tiersGrid = _parseTiers(p.price_tiers);
  let mayorHint = '';
  if (_listaIdx === 0 && _tiersGrid && _tiersGrid.length) {
    const txt = _tiersGrid.map(t => `≥${t.min}u ${fmt(t.price)}`).join(' · ');
    mayorHint = `<div class="prod-mayor-hint" style="font-size: 11.5px;color:#0f766e;font-weight:700;margin-top:2px;line-height:1.3;">${txt}</div>`;
  } else {
    const tieneMayor = _listaIdx === 0 && p.price_mayorista && Number(p.price_mayorista) > 0 && p.qty_mayorista && Number(p.qty_mayorista) > 1;
    mayorHint = tieneMayor
      ? `<div class="prod-mayor-hint" style="font-size: 11.5px;color:#6366f1;font-weight:700;margin-top:2px;white-space:nowrap;">≥${Number(p.qty_mayorista)}u · ${fmt(Number(p.price_mayorista))} c/u</div>`
      : '';
  }
  const thumbCell = p.imagen
    ? `<div class="prod-td-img"><div class="prod-thumb" onclick="event.stopPropagation();abrirZoom('${nameSafe}','${imgSafe}')" title="Ver imagen"><img src="${imgSafe}" alt="" loading="lazy"></div></div>`
    : `<div class="prod-td-img"><div class="prod-thumb-empty"><i class="bi bi-box-seam"></i></div></div>`;
  return `<div class="prod-card ${sinStock ? 'out-stock' : ''} ${inCart ? 'in-cart' : ''}" id="pcard-${CSS.escape(p.sku)}" onclick="${sinStock ? '' : `addBySku('${skuSafe}',this)`}">
    ${thumbCell}
    <div class="prod-td">
      ${sinStockBadge}
      <div class="prod-name">${p.name}${inCartBadge}${promoBadge}</div>
      ${descHTML}
    </div>
    <div class="prod-td" style="text-align:center;"><span class="prod-stock-badge ${stockCls}">${stockTxt}</span></div>
    <div class="prod-td" style="text-align:right;">${promoOld}<div class="prod-price">${fmt(ep)}</div>${mayorHint}</div>
  </div>`;
}

function updateCardState(sku){
  const card = document.getElementById('pcard-' + CSS.escape(sku));
  if (!card) return;
  const item = cart.find(i => i.sku === sku);
  card.classList.toggle('in-cart', !!item);
  // Actualizar solo el badge de qty en la card — sin re-renderizar todo el grid
  const nameDiv = card.querySelector('.prod-name');
  if (nameDiv) {
    // Remover badge viejo
    const oldBadge = nameDiv.querySelector('.prod-badge-qty');
    if (oldBadge) oldBadge.remove();
    // Agregar badge nuevo si está en carrito
    if (item) {
      const badge = document.createElement('span');
      badge.className = 'prod-badge-qty';
      badge.textContent = item.qty;
      nameDiv.appendChild(badge);
    }
  }
}

// ── Multiplicador de cantidad (tecla x + número) ──
let qtyMultiplier = 1;
function setQtyMultiplier(n){ qtyMultiplier = Math.min(999, Math.max(1, parseInt(n,10)||1)); renderMultBadge(); }
function resetQtyMultiplier(){ qtyMultiplier = 1; renderMultBadge(); }
function renderMultBadge(){
  const b=document.getElementById('qtyMultBadge'); if(!b) return;
  if(qtyMultiplier>1){ b.textContent='×'+qtyMultiplier; b.style.display='inline-flex'; }
  else { b.style.display='none'; }
}
// Agrega aplicando el multiplicador y lo resetea (solo en acciones del usuario)
function commitAdd(product){ const q=qtyMultiplier; addToCart(product, q); if(q>1) resetQtyMultiplier(); }

function addBySku(sku,el){
  if(el){el.style.transform='scale(.95)';setTimeout(()=>el.style.transform='',130);}
  const p=allProducts.find(x=>x.sku===sku);
  if(p)commitAdd(p);
}

function _parseTiers(raw) {
  let t = raw;
  if (typeof t === 'string') { try { t = JSON.parse(t); } catch (_) { return null; } }
  if (!Array.isArray(t) || !t.length) return null;
  return t.map(x => ({ min: Number(x.min ?? x.cantidad), price: Number(x.price ?? x.precio) }))
          .filter(x => x.min > 0 && x.price > 0)
          .sort((a, b) => a.min - b.min);
}

function aplicarPrecioMayorista(item) {
  // 0) Si el cajero fijó el precio a mano, mandamos ese precio: no lo pisamos
  //    al cambiar la cantidad (y así tampoco falseamos la auditoría).
  if (item.precioEditado) return;

  // 1) Escalones por cantidad (tienen prioridad sobre el mayorista simple)
  const tiers = _parseTiers(item.price_tiers);
  if (tiers) {
    const aplicables = tiers.filter(t => item.qty >= t.min);
    const tier = aplicables.length ? aplicables[aplicables.length - 1] : null; // el de mayor "min" que aplique
    const nuevoPrecio = tier ? tier.price : item.price_base;
    // Un escalón por cantidad NO es mayorista: se marca aparte
    item.isMayorista = false;
    item.isTier = !!tier;
    if (Number(item.price) !== Number(nuevoPrecio)) {
      item.price = nuevoPrecio;
      if (tier) showToast(`📦 ${item.name} — ${tier.min}+ u · ${fmt(nuevoPrecio)} c/u`, 'info');
      else      showToast(`${item.name} — precio unitario`, 'info');
    }
    return;
  }

  // 2) Fallback: mayorista simple (un solo escalón)
  if (!item.price_mayorista || !item.qty_mayorista) return;
  const esMayorista = item.qty >= item.qty_mayorista;
  if (esMayorista && !item.isMayorista) {
    item.price     = item.price_mayorista;
    item.isMayorista = true;
    item.isTier      = false;
    showToast(`🏪 ${item.name} — precio mayorista aplicado`, 'info');
  } else if (!esMayorista && item.isMayorista) {
    item.price     = item.price_base;
    item.isMayorista = false;
    item.isTier      = false;
    showToast(`${item.name} — precio minorista`, 'info');
  }
}

function addToCart(product, qty){
  qty = Math.max(1, parseInt(qty, 10) || 1);
  const ep = getPrecioLista(product);
  const existing=cart.find(i=>i.sku===product.sku);
  if(existing){
    existing.qty += qty;
    aplicarPrecioMayorista(existing);
    showToast(`${existing.name} — x${existing.qty}`,'info');
  } else {
    cart.push({
      sku: product.sku,
      name: product.name,
      price: ep,
      price_base: ep,
      price_mayorista: product.price_mayorista ? Number(product.price_mayorista) : null,
      qty_mayorista: product.qty_mayorista ? Number(product.qty_mayorista) : null,
      price_tiers: product.price_tiers || null,
      isMayorista: false,
      isTier: false,
      descripcion: product.descripcion || null,
      isPromo: !!(product.en_promo && product.price_promo),
      qty: qty
    });
    aplicarPrecioMayorista(cart[cart.length - 1]);
    showToast(`${product.name}${product.en_promo?' 🏷️':''} agregado`,'success');
  }
  beep('add');
  updateCardState(product.sku);
  renderCartList();
  updateTotals();
  // En mobile: al agregar el primer item, mostrar el FAB animado
  if (window.innerWidth <= 860) {
    const fab = document.getElementById('fabBtn');
    if (fab) { fab.style.transform = 'scale(1.2)'; setTimeout(()=>fab.style.transform='', 200); }
  }
}

// ── Delegación de eventos para botón editar precio ──
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.btn-edit-price');
  if (!btn) return;
  e.stopPropagation();
  const sku   = btn.dataset.sku;
  const price = parseFloat(btn.dataset.price);
  editarPrecioItem(sku, price);
});

function renderCartList(){
  const emptyState = document.getElementById('cartEmptyState');
  const grid       = document.getElementById('cartItemsGrid');
  if (!emptyState || !grid) return;

  if (!cart.length) {
    emptyState.style.display = 'flex';
    grid.innerHTML = '';
    document.getElementById('cartSub').textContent = 'Sin productos';
    return;
  }
  emptyState.style.display = 'none';

  grid.querySelectorAll('.cart-card').forEach(el => {
    if (!cart.find(i => 'ci-' + CSS.escape(i.sku) === el.id)) el.remove();
  });

  cart.forEach(item => {
    const id = 'ci-' + CSS.escape(item.sku);
    let el = document.getElementById(id);
    if (!el) {
      el = document.createElement('div');
      el.id = id; el.className = 'cart-card';
      grid.appendChild(el);
    }
    el.innerHTML = `
      ${item.isPromo ? '<span class="cart-promo-tag">Promo</span>' : ''}
      ${item.isTier ? '<span class="cart-promo-tag" style="background:#0f766e;right:8px;">x Cant.</span>' : (item.isMayorista ? '<span class="cart-promo-tag" style="background:#6366f1;right:8px;">Mayor</span>' : '')}
      <div class="cart-card-top">
        <div class="cart-card-name">${item.name}</div>
        <button class="btn-del" onclick="removeItem('${item.sku}')"><i class="bi bi-trash3"></i></button>
      </div>
      <div class="cart-card-unit">Precio unitario: <span class="cart-price-editable" onclick="editarPrecioItem('${item.sku}', ${item.price})" title="Tocá para modificar el precio" style="cursor:pointer;text-decoration:underline dotted;text-underline-offset:2px;">${fmt(item.price)}${item.isTier ? ' <span style="color:#0f766e;font-size: 11.5px;font-weight:700;">c/u</span> <span style="color:#0f766e;font-size: 10.5px;font-weight:800;">x CANTIDAD</span>' : (item.isMayorista ? ' <span style="color:#6366f1;font-size: 11.5px;font-weight:700;">c/u</span> <span style="color:#6366f1;font-size: 10.5px;font-weight:800;">MAYOR</span>' : '')}${item.precioEditado ? ' <span style="color:#f59e0b;font-size: 10.5px;font-weight:800;" title="Precio modificado manualmente">✎</span>' : ''}</span></div>
      <div class="cart-card-bottom">
        <div class="qty-ctrl">
          <button class="qty-btn" onclick="chgQty('${item.sku}',-1)"><i class="bi bi-dash"></i></button>
          <span class="qty-val" onclick="abrirTecladoCantidad('${item.sku}',${item.qty})" title="Tocá para cambiar cantidad" style="cursor:pointer;background:var(--color-primary);color:#fff;border-radius:4px;padding:0 4px;">${item.qty}</span>
          <button class="qty-btn" onclick="chgQty('${item.sku}',1)"><i class="bi bi-plus"></i></button>
        </div>
        <div class="cart-card-price">${fmt(item.price * item.qty)}${item.precioEditado ? '<span style="color:#f59e0b;font-size: 10.5px;font-weight:800;margin-left:3px;" title="Precio modificado">✎</span>' : ''}</div>
        <button class="btn-edit-price" data-sku="${item.sku.replace(/"/g,'&quot;')}" data-price="${item.price}" title="Editar precio unitario" style="width:20px;height:20px;border:1px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-secondary);border-radius:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size: 12.5px;flex-shrink:0;padding:0;" onmouseover="this.style.borderColor='var(--color-primary)';this.style.color='var(--color-primary)'" onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)'"><i class="bi bi-pencil"></i></button>
      </div>`;
  });

  const total = cart.reduce((s,i) => s+i.qty, 0);
  document.getElementById('cartSub').textContent = `${cart.length} prod. · ${total} ud.`;
  document.getElementById('cartCount').textContent = total;
  // Actualizar badge del FAB
  const badge = document.getElementById('fabBadge');
  if (badge) {
    if (total > 0) { badge.textContent = total > 99 ? '99+' : total; badge.style.display = 'flex'; }
    else { badge.style.display = 'none'; }
