  <div class="line-solid"></div>

  <!-- N° RECIBO + FECHA -->
  ${reciboTxt ? `<div class="recibo-box">N° RECIBO: ${escapeHtml(reciboTxt)}</div>` : ''}
  <div class="meta-row">
    <span>${fechaTxt}</span>
  </div>
  <div class="meta-row">
    <span>Cliente:</span><span class="bold">${escapeHtml(lastSaleData.cliente)}</span>
  </div>
  <div class="meta-row">
    <span>Pago:</span><span class="bold">${escapeHtml(lastSaleData.metodo)}</span>
  </div>
  ${lastSaleData.offline ? `<div class="offline-badge">⚠ MODO OFFLINE</div>` : ''}

  <div class="line-dashed"></div>

  <!-- PRODUCTOS -->
  <table>
    <thead>
      <tr>
        <th>Producto</th>
        <th style="text-align:center;">Cant</th>
        <th style="text-align:right;">Total</th>
      </tr>
    </thead>
    <tbody>
      ${itemsHtml}
    </tbody>
  </table>

  <div class="line-solid"></div>

  <!-- TOTALES -->
  ${lastSaleData.subtotal !== lastSaleData.total || lastSaleData.descuento > 0
    ? `<div class="tot-row"><span>Subtotal</span><span>${fmt(lastSaleData.subtotal)}</span></div>` : ''}
  ${lastSaleData.descuento > 0
    ? `<div class="tot-row"><span>Descuento</span><span>- ${fmt(lastSaleData.descuento)}</span></div>` : ''}

  <div class="tot-row tot-main">
    <span>TOTAL</span>
    <span>${fmt(lastSaleData.total)}</span>
  </div>

  <div class="line-dashed"></div>

  <!-- FOOTER -->
  <div class="footer-txt">${escapeHtml(cfg.footer || '¡Gracias por su compra!')}</div>

</div>
</body>
</html>`;

  const w = window.open('', '_blank', `width=${winWidth},height=900,left=0,top=0`);
  if(!w){
    showToast('Permití ventanas emergentes para imprimir','warn');
    return;
  }
  w.document.open();
  w.document.write(html);
  w.document.close();
  w.focus();
  // Después de imprimir, cerrar la ventana automáticamente
  setTimeout(() => {
    w.print();
    setTimeout(() => {
      w.close();
      mostrarModalCopia();
    }, 800);
  }, 300);
}

function mostrarModalCopia() {
  const modal = document.getElementById('modalCopiaTicket');
  if (modal) {
    modal.style.display = 'flex';
  }
}

function cerrarModalCopia() {
  const modal = document.getElementById('modalCopiaTicket');
  if (modal) modal.style.display = 'none';
}

function imprimirCopiaTicket() {
  cerrarModalCopia();
  if (!lastSaleData) return;

  const cfg = ticketConfig || {
    formato: '80mm', footer: 'Gracias por su compra!',
    nombre: 'Mi Comercio', direccion: '', telefono: '', logo: ''
  };

  const fechaTxt = lastSaleData.fecha.toLocaleString('es-AR', {
    day:'2-digit', month:'2-digit', year:'numeric',
    hour:'2-digit', minute:'2-digit'
  });

  const formato    = String(cfg.formato || '80mm').toLowerCase();
  const es58       = formato === '58mm';
  const es80       = formato === '80mm';
  const fmtA4      = formato === 'a4';
  const paperWidth = es58 ? '58mm' : es80 ? '80mm' : '210mm';
  const winWidth   = es58 ? 245    : es80 ? 345    : 900;

  const fsBase    = fmtA4 ? '13px' : es58 ? '11px' : '12px';
  const fsSmall   = fmtA4 ? '11px' : es58 ? '9px'  : '10px';
  const fsMeta    = fmtA4 ? '12px' : es58 ? '10px' : '11px';
  const fsTitle   = fmtA4 ? '22px' : es58 ? '14px' : '17px';
  const fsItem    = fmtA4 ? '13px' : es58 ? '11px' : '12px';
  const fsTot     = fmtA4 ? '13px' : es58 ? '12px' : '13px';
  const fsTotMain = fmtA4 ? '20px' : es58 ? '16px' : '18px';
  const pageMargin = fmtA4 ? '12mm' : es58 ? '1mm 2mm' : '2mm 3mm';

  const reciboNum = lastSaleData.reciboNum || lastSaleData.recibo || lastSaleData.orden_id || '';
  const reciboTxt = reciboNum ? String(reciboNum).padStart(8,'0') : '';

  const itemsHtml = lastSaleData.items.map(it => `
    <tr>
      <td style="padding:6px 0 4px;line-height:1.4;border-bottom:1px dotted #bbb;">
