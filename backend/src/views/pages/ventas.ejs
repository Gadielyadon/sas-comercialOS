        <div class="mp-amount-lbl">Total a cobrar</div>
        <div class="mp-amount-val" id="mpModalAmt">$0,00</div>
      </div>
      <div class="mp-status-box" id="mpStatusBox">
        <div class="mp-spinner"></div>
        <div class="mp-status-txt" id="mpStatusTxt">Enviando al Point…</div>
        <div class="mp-status-sub" id="mpStatusSub">El monto aparecerá en el dispositivo automáticamente</div>
      </div>
      <button class="mp-btn-cancel" id="mpBtnCancel" onclick="cancelarMPPoint()">
        <i class="bi bi-x-circle"></i> Cancelar
      </button>
    </div>
  </div>
