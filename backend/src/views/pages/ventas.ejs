<script>
'use strict';
// ══════════════════════════════════════════════════════════
// MERCADO PAGO POINT — POS
// ══════════════════════════════════════════════════════════
let _mpIntentId  = null;
let _mpPolling   = null;
let _mpCancelled = false;

async function cobrarConMPPoint() {
  if (!cart.length) return;
  const { total } = getBaseTotal();
  const conRecargo = total * (1 + recargoVal / 100);

  _mpCancelled = false;
  _mpIntentId  = null;
  document.getElementById('mpModalAmt').textContent = fmt(conRecargo);
  _mpSetStatus('spinner', 'Enviando al Point…', 'El monto aparecerá en el dispositivo automáticamente');
  const cancelBtn = document.getElementById('mpBtnCancel');
  if (cancelBtn) { cancelBtn.disabled = false; cancelBtn.textContent = ''; cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cancelar'; }
  document.getElementById('mpOverlay').classList.add('open');

  try {
    const r = await fetch('/api/mp/cobrar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        monto:              conRecargo,
        descripcion:        'Venta ' + cart.map(i=>i.name).join(', ').slice(0,60),
        external_reference: 'axsoft-' + Date.now()
      })
    });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Error al crear intent');

    _mpIntentId = d.intent_id;
    _mpSetStatus('spinner', 'Esperando pago…', 'El cliente debe presentar su tarjeta en el Point');
    _mpStartPolling();
  } catch(e) {
    _mpSetStatus('error', 'Error al conectar', e.message);
    if (cancelBtn) cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar';
  }
}

function _mpSetStatus(type, txt, sub) {
  const box = document.getElementById('mpStatusBox');
  const icons = { ok:'✅', error:'❌', rejected:'🚫', warn:'⚠️' };
  if (type === 'spinner') {
    box.innerHTML = `<div class="mp-spinner"></div><div class="mp-status-txt">${txt}</div><div class="mp-status-sub">${sub||''}</div>`;
  } else {
    box.innerHTML = `<div class="mp-status-icon">${icons[type]||''}</div><div class="mp-status-txt">${txt}</div><div class="mp-status-sub">${sub||''}</div>`;
  }
}

function _mpStartPolling() {
  if (_mpPolling) clearInterval(_mpPolling);
  let attempts = 0;
  let finishedAttempts = 0; // intentos extra tras FINISHED sin approved
  _mpPolling = setInterval(async () => {
    if (_mpCancelled || !_mpIntentId) { clearInterval(_mpPolling); return; }
    if (++attempts > 120) { // 4 minutos máximo
      clearInterval(_mpPolling);
      _mpSetStatus('error', 'Tiempo agotado', 'Si el posnet cobró, la venta se registró en Mercado Pago aunque no figure aquí. Verificá tu cuenta de MP.');
      const btn = document.getElementById('mpBtnCancel');
      if (btn) btn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar';
      return;
    }
    try {
      const r = await fetch(`/api/mp/estado/${_mpIntentId}`);
      const d = await r.json();

      if (d.state === 'FINISHED' && d.status === 'approved') {
        // Pago confirmado — registrar venta
        clearInterval(_mpPolling);
        _mpSetStatus('ok', '¡Pago aprobado!', `Payment ID: ${d.payment_id||'-'}`);
        const btn = document.getElementById('mpBtnCancel');
        if (btn) btn.style.display = 'none';
        payMethod = 'Mercado Pago';
        setTimeout(() => {
          document.getElementById('mpOverlay').classList.remove('open');
          confirmSale();
        }, 1500);

      } else if (d.state === 'FINISHED' && d.status !== 'approved') {
        // FINISHED pero status no llegó todavía — dar hasta 10 intentos más (20 seg)
        finishedAttempts++;
        if (finishedAttempts <= 10) {
          _mpSetStatus('spinner', 'Verificando pago…', 'El posnet procesó el pago, confirmando con Mercado Pago…');
          return; // seguir el intervalo
        }
        // Después de 20 seg extra sin approved — puede que sí cobró
        clearInterval(_mpPolling);
        _mpSetStatus('warn', 'Verificá el pago en MP', `El posnet procesó el cobro pero la confirmación demoró. Revisá tu cuenta de Mercado Pago antes de registrar la venta.`);
        const btn2 = document.getElementById('mpBtnCancel');
        if (btn2) btn2.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar';

      } else if (d.state === 'CANCELED') {
        clearInterval(_mpPolling);
        _mpSetStatus('error', 'Pago cancelado', 'El cobro fue cancelado en el posnet.');
        const btn = document.getElementById('mpBtnCancel');
        if (btn) btn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar';

      } else if (d.state === 'ERROR') {
        clearInterval(_mpPolling);
        _mpSetStatus('error', 'Error en el pago', 'Hubo un error. Si el posnet cobró, verificá tu cuenta de MP.');
        const btn = document.getElementById('mpBtnCancel');
        if (btn) btn.innerHTML = '<i class="bi bi-x-circle"></i> Cerrar';
      }
      // estados ON_TERMINAL, OPEN, etc → seguir esperando
    } catch(e) { /* error de red, seguir intentando */ }
  }, 2000);
}

async function cancelarMPPoint() {
  _mpCancelled = true;
  if (_mpPolling) clearInterval(_mpPolling);
  if (_mpIntentId) {
    try { await fetch(`/api/mp/cancelar/${_mpIntentId}`, { method: 'DELETE' }); } catch(e) {}
    _mpIntentId = null;
  }
  document.getElementById('mpOverlay').classList.remove('open');
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && document.getElementById('mpOverlay')?.classList.contains('open')) {
    cancelarMPPoint();
  }
});

// ── Verificador de precios (F9) ───────────────────────────────
// Listener independiente — siempre activo, sin importar el foco
document.addEventListener('keydown', function(e) {
  if (e.key === 'F9') {
    e.preventDefault();
    e.stopPropagation();
    toggleVerificadorPrecios();
  }
}, true); // capture=true para interceptar antes que cualquier otro listener
(function() {
  // Crear modal
  const overlay = document.createElement('div');
  overlay.id = 'verificadorOverlay';
  overlay.style.cssText = 'display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);align-items:center;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:var(--bg-card);border-radius:16px;width:min(520px,95vw);box-shadow:0 20px 60px rgba(0,0,0,.4);overflow:hidden;">
      <div style="background:linear-gradient(135deg,var(--color-primary),#4f46e5);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:10px;color:#fff;">
          <i class="bi bi-tag-fill" style="font-size: 20.5px;"></i>
          <span style="font-weight:800;font-size: 17px;">Verificador de Precios</span>
          <kbd style="background:rgba(255,255,255,.2);border:none;border-radius:4px;padding:2px 7px;font-size: 11.5px;font-weight:800;color:#fff;">F9</kbd>
        </div>
        <button onclick="cerrarVerificador()" style="background:rgba(255,255,255,.15);border:none;color:#fff;width:28px;height:28px;border-radius:8px;cursor:pointer;font-size: 18px;display:flex;align-items:center;justify-content:center;">&times;</button>
      </div>
      <div style="padding:16px;">
        <input type="text" id="verificadorInput"
          placeholder="Buscá por nombre o SKU..."
          autocomplete="off"
          style="width:100%;padding:10px 14px;border-radius:10px;border:2px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-primary);font-size: 16px;outline:none;box-sizing:border-box;font-family:var(--font-body);"
          oninput="buscarVerificador(this.value)">
      </div>
      <div id="verificadorResultados" style="max-height:340px;overflow-y:auto;padding:0 16px 16px;"></div>
    </div>`;
  document.body.appendChild(overlay);

  overlay.addEventListener('click', e => { if (e.target === overlay) cerrarVerificador(); });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && overlay.style.display === 'flex') {
      e.preventDefault();
      cerrarVerificador();
    }
  });
})();

function toggleVerificadorPrecios() {
  const overlay = document.getElementById('verificadorOverlay');
  if (!overlay) return;
  if (overlay.style.display === 'flex') {
    cerrarVerificador();
  } else {
    overlay.style.display = 'flex';
    const inp = document.getElementById('verificadorInput');
    if (inp) { inp.value = ''; inp.focus(); }
    document.getElementById('verificadorResultados').innerHTML = `
      <div style="text-align:center;padding:24px;color:var(--text-secondary);font-size: 15px;">
        <i class="bi bi-search" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>
        Escribí para buscar un producto
      </div>`;
  }
}

function cerrarVerificador() {
  const overlay = document.getElementById('verificadorOverlay');
  if (overlay) overlay.style.display = 'none';
}

function buscarVerificador(q) {
  const res = document.getElementById('verificadorResultados');
  if (!res) return;
  const term = (q || '').trim().toLowerCase();
  if (!term) {
    res.innerHTML = `<div style="text-align:center;padding:24px;color:var(--text-secondary);font-size: 15px;"><i class="bi bi-search" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>Escribí para buscar un producto</div>`;
    return;
  }
  const productos = (typeof allProducts !== 'undefined' ? allProducts : [])
    .filter(p => (p.name||'').toLowerCase().includes(term) || (p.sku||'').toLowerCase().includes(term))
    .slice(0, 12);

  if (!productos.length) {
    res.innerHTML = `<div style="text-align:center;padding:24px;color:var(--text-secondary);font-size: 15px;">Sin resultados para "<strong>${q}</strong>"</div>`;
    return;
  }

  const fmt = n => Number(n||0).toLocaleString('es-AR',{minimumFractionDigits:2});
  res.innerHTML = productos.map(p => {
    const stockColor = p.stock > 5 ? 'var(--color-success)' : p.stock > 0 ? '#f59e0b' : '#ef4444';
    const stockTxt  = p.stock > 0 ? `${p.stock} en stock` : 'Sin stock';
    return `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-radius:10px;background:var(--bg-surface);margin-bottom:6px;gap:12px;">
      <div style="flex:1;min-width:0;">
        <div style="font-weight:700;font-size: 15px;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${p.name}</div>
        <div style="font-size: 12.5px;color:var(--text-secondary);margin-top:2px;">SKU: ${p.sku||'—'} &nbsp;·&nbsp; <span style="color:${stockColor};font-weight:700;">${stockTxt}</span></div>
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div style="font-size: 19.5px;font-weight:900;color:var(--color-primary);">$${fmt(p.price)}</div>
        ${p.price_tarjeta && p.price_tarjeta !== p.price ? `<div style="font-size: 12.5px;color:var(--text-secondary);">Tarjeta: $${fmt(p.price_tarjeta)}</div>` : ''}
      </div>
    </div>`;
  }).join('');
}

</script>

