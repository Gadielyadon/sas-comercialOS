let _selClienteDebounce = null;

function abrirSelectorClientes(){
  document.getElementById('modalSelectorClientes').classList.add('open');
  const buscar = document.getElementById('selClienteBuscar');
  buscar.value = '';
  setTimeout(() => buscar.focus(), 80);
  cargarClientesSelector('');
}

function cerrarSelectorClientes(){
  document.getElementById('modalSelectorClientes').classList.remove('open');
}

document.addEventListener('keydown', function(e){
  if (e.key === 'Escape' && document.getElementById('modalSelectorClientes')?.classList.contains('open')) {
    cerrarSelectorClientes();
  }
});

function buscarEnSelectorClientes(q){
  clearTimeout(_selClienteDebounce);
  _selClienteDebounce = setTimeout(() => cargarClientesSelector(q), 200);
}

async function cargarClientesSelector(q){
  const cont = document.getElementById('selClienteResultados');
  cont.innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:32px 0;">Buscando…</p>';
  try{
    const query = (q || '').trim();
    const url = query ? '/api/clientes?q=' + encodeURIComponent(query) : '/api/clientes';
    const r = await fetch(url);
    const list = r.ok ? await r.json() : [];
    renderSelectorClientesCards(list, query);
  }catch(e){
    cont.innerHTML = '<p style="color:#ef4444;text-align:center;padding:32px 0;">Error al buscar clientes</p>';
  }
}

function renderSelectorClientesCards(list, q){
  const cont = document.getElementById('selClienteResultados');
  if(!list || !list.length){
    cont.innerHTML = `
      <div style="text-align:center;padding:32px 10px;">
        <i class="bi bi-person-x" style="font-size:38px;opacity:.2;display:block;margin-bottom:10px;"></i>
        <div style="font-size: 15px;font-weight:700;color:var(--text-primary);">Sin resultados${q ? ` para "${q}"` : ''}</div>
        ${q ? `<button onmousedown="abrirCrearClienteRapido('${q.replace(/'/g,"\\'")}');"
          style="margin-top:14px;padding:9px 18px;background:rgba(27,79,216,.1);color:var(--color-primary);border:1.5px solid rgba(27,79,216,.3);border-radius:8px;font-size: 14.5px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:inline-flex;align-items:center;gap:7px;">
          <i class="bi bi-person-plus-fill"></i> Crear cliente "${q}"</button>` : ''}
      </div>`;
    return;
  }
  cont.innerHTML = list.map(c => {
    const nom   = c.nombre || '';
    const tel   = c.telefono || '';
    const saldo = Number(c.saldo || 0);
    let saldoTag = '';
    if (saldo > 0)      saldoTag = `<span class="sel-cliente-saldo" style="background:rgba(239,68,68,.1);color:#dc2626;">Debe ${fmt(saldo)}</span>`;
    else if (saldo < 0) saldoTag = `<span class="sel-cliente-saldo" style="background:rgba(16,185,129,.1);color:#059669;">A favor ${fmt(Math.abs(saldo))}</span>`;
    const catTag = c.categoria ? `<span class="sel-cliente-cat">${c.categoria}</span>` : '';
    const defTag = c.id === 1 ? `<span class="sel-cliente-cat" style="background:rgba(0,180,216,.1);color:var(--color-action);">Default</span>` : '';
    return `<div class="sel-cliente-card" onmousedown="elegirClienteDesdeModal(${c.id}, '${nom.replace(/'/g,"\\'")}', '${tel.replace(/'/g,"\\'")}')">
      <div class="sel-cliente-avatar"><i class="bi bi-person-fill"></i></div>
      <div class="sel-cliente-info">
        <div class="sel-cliente-nombre">${nom}</div>
        <div class="sel-cliente-sub">${tel ? `<i class="bi bi-telephone"></i> ${tel}` : ''}${catTag}${defTag}</div>
      </div>
      ${saldoTag}
    </div>`;
  }).join('');
}

