        <span style="font-size:${fsSmall};font-weight:700;">${fmt(it.price)} c/u</span>
      </td>
      <td style="padding:6px 0 4px;text-align:center;font-size:${fsItem};font-weight:900;vertical-align:top;border-bottom:1px dotted #bbb;">${it.qty}</td>
      <td style="padding:6px 0 4px;text-align:right;font-size:${fsItem};font-weight:900;vertical-align:top;border-bottom:1px dotted #bbb;">${fmt(it.subtotal)}</td>
    </tr>`).join('');

  const html = `<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Copia - Ticket</title>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    @page { size: ${paperWidth} auto; margin: ${pageMargin}; }
    @media print { html, body { width: ${paperWidth}; } }
    body {
      font-family: 'Courier New', Courier, monospace;
      background: #fff; color: #000;
      font-size: ${fsBase};
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .ticket { width:100%; max-width:${fmtA4 ? '200mm' : paperWidth}; margin:0 auto; padding:${fmtA4 ? '10px 14px' : '6px 4px'}; }
    .center { text-align:center; }
    .bold { font-weight:700; }
    .line-solid  { border-top:2px solid #000; margin:7px 0; }
    .line-dashed { border-top:1px dashed #000; margin:6px 0; }
    .copia-badge {
      text-align:center;
      border:2px dashed #000;
      padding:4px 8px;
      font-size:${fsMeta};
      font-weight:900;
      letter-spacing:3px;
      text-transform:uppercase;
      margin-bottom:8px;
    }
    .nombre-negocio { font-size:${fsTitle};font-weight:900;letter-spacing:0.5px;text-transform:uppercase;line-height:1.2;margin-bottom:3px; }
    .meta-row { display:flex;justify-content:space-between;font-size:${fsMeta};margin:2px 0; }
    .recibo-box { text-align:center;font-size:${fsMeta};font-weight:700;letter-spacing:1px;margin:4px 0 2px; }
    table { width:100%;border-collapse:collapse; }
    th { font-size:${fsSmall};font-weight:700;text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid #000;padding:3px 0; }
    th:first-child { text-align:left; } th:nth-child(2) { text-align:center;width:28px; } th:last-child { text-align:right; }
    td:nth-child(2) { width:28px; }
    .tot-row { display:flex;justify-content:space-between;align-items:baseline;font-size:${fsTot};padding:2px 0; }
    .tot-main { font-size:${fsTotMain};font-weight:900;padding:4px 0;border-top:2px solid #000;border-bottom:2px solid #000;margin:4px 0; }
    .footer-txt { text-align:center;font-size:${fsMeta};font-weight:700;letter-spacing:1px;margin-top:8px;text-transform:uppercase; }
  </style>
</head>
<body>
<div class="ticket">

  <!-- BADGE COPIA -->
  <div class="copia-badge">*** COPIA LOCAL ***</div>

  <!-- NOMBRE -->
  <div class="center">
    <div class="nombre-negocio">${escapeHtml(cfg.nombre || 'Mi Comercio')}</div>
    ${cfg.direccion ? `<div style="font-size:${fsMeta};">${escapeHtml(cfg.direccion)}</div>` : ''}
    ${cfg.telefono  ? `<div style="font-size:${fsMeta};">Tel: ${escapeHtml(cfg.telefono)}</div>` : ''}
  </div>

  <div class="line-solid"></div>

  ${reciboTxt ? `<div class="recibo-box">N deg RECIBO: ${escapeHtml(reciboTxt)}</div>` : ''}
  <div class="meta-row"><span>${fechaTxt}</span></div>
  <div class="meta-row"><span>Cliente:</span><span class="bold">${escapeHtml(lastSaleData.cliente)}</span></div>
  <div class="meta-row"><span>Pago:</span><span class="bold">${escapeHtml(lastSaleData.metodo)}</span></div>

  <div class="line-dashed"></div>

  <!-- PRODUCTOS -->
  <table>
    <thead>
      <tr>
        <th>Producto</th>
        <th style="text-align:center;">Cant</th>
        <th style="text-align:right;">Total</th>
      </tr>
    </thead>
    <tbody>${itemsHtml}</tbody>
  </table>

  <div class="line-solid"></div>

  ${lastSaleData.descuento > 0 ? `<div class="tot-row"><span>Subtotal</span><span>${fmt(lastSaleData.subtotal)}</span></div><div class="tot-row"><span>Descuento</span><span>- ${fmt(lastSaleData.descuento)}</span></div>` : ''}

  <div class="tot-row tot-main">
    <span>TOTAL</span>
    <span>${fmt(lastSaleData.total)}</span>
  </div>

  <div class="line-dashed"></div>
  <div class="footer-txt">USO INTERNO</div>

</div>
</body>
</html>`;

  const w = window.open('', '_blank', `width=${winWidth},height=900,left=0,top=0`);
  if (!w) { showToast('Permiti ventanas emergentes para imprimir', 'warn'); return; }
  w.document.open();
  w.document.write(html);
  w.document.close();
  w.focus();
  setTimeout(() => { w.print(); setTimeout(() => w.close(), 800); }, 300);
}

function nuevaVenta(){
  document.getElementById('exitoOverlay').classList.remove('open');
