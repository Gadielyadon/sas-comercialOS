            <button class="recargo-chip" onclick="setRecargo(5,this)">+5%</button>
            <button class="recargo-chip" onclick="setRecargo(10,this)">+10%</button>
            <button class="recargo-chip" onclick="setRecargo(15,this)">+15%</button>
            <button class="recargo-chip" onclick="setRecargo(21,this)">+21%</button>
          </div>
          <div class="recargo-custom">
            <input type="number" id="recargoCustom" placeholder="0" min="0" max="100" oninput="setRecargoCustom()">
            <span>% personalizado</span>
          </div>
          <div class="recargo-result" id="recargoResult" style="display:none"></div>
        </div>

        <div class="efectivo-row" id="efectivoRow">
          <label>Monto recibido</label>
          <input type="number" id="cashReceived" placeholder="0,00" min="0" step="0.01" oninput="calcVuelto()">
          <div class="vuelto-display" id="vueltoDisplay" style="display:none">
            <span>Vuelto</span>
            <span id="vueltoAmt">$0,00</span>
          </div>
        </div>

        <!-- ── FACTURACIÓN AFIP — dentro del cobro ── -->
        <div class="cobro-section" id="facturacionSection" style="margin-bottom:0;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0;">
            <div style="display:flex;align-items:center;gap:8px;">
              <i class="bi bi-file-earmark-text" style="font-size: 17px;color:var(--color-primary);"></i>
              <span class="cobro-stitle" style="margin:0;">Factura electrónica AFIP</span>
            </div>
            <label class="afip-toggle-wrap" style="cursor:pointer;display:flex;align-items:center;gap:8px;">
              <span style="font-size: 13.5px;color:var(--text-secondary);" id="facturaTglLabel">No emitir</span>
              <div class="afip-tgl-switch">
                <input type="checkbox" id="facturaTgl" onchange="toggleFacturacionEnCobro(this.checked)" style="display:none;">
                <div class="afip-tgl-slider" id="facturaTglSlider"></div>
              </div>
            </label>
          </div>

          <!-- Opciones que aparecen al activar -->
          <%
            const condIvaEmisorRaw = String((config && config.empresa_cond_iva) || '').toLowerCase();
            const tiposPermitidosMini = condIvaEmisorRaw.includes('inscripto') ? ['A','B'] : ['C'];
            const tipoDefaultMini = tiposPermitidosMini[0];
            const nombresTipo = { A: 'Resp. Inscripto', B: 'Consumidor Final', C: 'Monotributista' };
          %>
          <div id="facturaOpciones" style="display:none;margin-top:14px;display:none;">
            <!-- Tipo de factura: solo se muestran los tipos que tu condición IVA (Ajustes) te permite emitir -->
            <div style="margin-bottom:12px;">
              <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:8px;">
                Tipo de comprobante
                <% if (tiposPermitidosMini.length === 1) { %>
                  <span style="text-transform:none;font-weight:400;">(según tu condición IVA en Ajustes)</span>
                <% } %>
              </div>
              <div style="display:grid;grid-template-columns:repeat(<%= tiposPermitidosMini.length %>,1fr);gap:8px;">
                <% tiposPermitidosMini.forEach(function(t, i) { %>
                  <button class="afip-tipo-mini <%= i === 0 ? 'on' : '' %>" id="tipoMini<%= t %>" onclick="selTipoMini('<%= t %>')">
                    <div style="font-size:22px;font-weight:900;line-height:1;"><%= t %></div>
                    <div style="font-size: 10.5px;margin-top:2px;opacity:.8;"><%= nombresTipo[t] %></div>
                  </button>
                <% }); %>
              </div>
            </div>

            <!-- CUIT (solo Factura A) -->
            <div id="cuitMiniWrap" style="display:none;margin-bottom:10px;">
              <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:5px;">CUIT del receptor</div>
              <input type="text" id="cuitMiniInp" placeholder="20-12345678-9" maxlength="13"
                style="width:100%;padding:9px 12px;border-radius:8px;font-size: 15px;">
            </div>

            <!-- Nombre receptor -->
            <div style="margin-bottom:12px;">
              <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:5px;">Nombre / Razón social</div>
              <input type="text" id="receptorMiniNombre" placeholder="Consumidor Final"
                style="width:100%;padding:9px 12px;border-radius:8px;font-size: 15px;">
            </div>

            <!-- ¿Es un servicio? (habilita período facturado, como en la web de ARCA) -->
            <div style="margin-bottom:10px;padding-top:10px;border-top:1px dashed var(--border-color, rgba(255,255,255,.1));">
              <label style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                <input type="checkbox" id="servicioMiniChk" onchange="toggleServicioMini(this.checked)">
                <span style="font-size: 13.5px;color:var(--text-secondary);">Es un servicio (habilita período facturado)</span>
              </label>
            </div>

            <div id="servicioMiniWrap" style="display:none;">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
                <div>
                  <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:5px;">Período desde</div>
                  <input type="date" id="servDesdeMini" style="width:100%;padding:9px 12px;border-radius:8px;font-size: 15px;">
                </div>
                <div>
                  <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:5px;">Período hasta</div>
                  <input type="date" id="servHastaMini" style="width:100%;padding:9px 12px;border-radius:8px;font-size: 15px;">
                </div>
              </div>
              <div>
                <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:5px;">Fecha de vto. para el pago (opcional, por defecto hoy)</div>
                <input type="date" id="servVtoPagoMini" style="width:100%;padding:9px 12px;border-radius:8px;font-size: 15px;">
              </div>
            </div>
          </div>
        </div>
        <script>const TIPO_COMPROBANTE_DEFAULT = <%- JSON.stringify(tipoDefaultMini) %>;</script>

        <button class="btn-cobrar" id="btnCobrar" onclick="confirmSale()">
          <i class="bi bi-check-circle-fill"></i>
          <span id="btnCobrarTxt">Cobrar $0,00</span>
        </button>

        <div class="cobro-help">Flechas para moverte entre medios de pago · Enter para elegir uno y saltar a Cobrar · Enter de nuevo para confirmar</div>
      </div>

      <!-- DERECHA -->
      <div class="cobro-right">
        <div class="cobro-section" style="margin-bottom:0;">
          <p class="cobro-stitle">Medios de pago</p>
          <div class="pm-grid" id="pmGrid"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="exito-overlay" id="exitoOverlay">
  <div class="exito-modal">
    <div class="exito-icon"><i class="bi bi-check-lg"></i></div>
    <h3>¡Venta Confirmada!</h3>
    <div class="exito-total" id="exitoTotal">$0,00</div>
    <p id="exitoDetalle">Método: Efectivo</p>
    <p id="exitoVuelto" style="margin-top:4px;font-weight:600;color:#10b981"></p>

    <!-- Estado factura -->
    <div id="exitoFacturaEstado" style="margin-top:10px;text-align:center;"></div>

    <button
      onclick="imprimirTicket()"
      style="width:100%;margin-top:12px;padding:11px;border-radius:var(--radius-sm);border:1.5px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-primary);font-family:var(--font-body);font-size: 15.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;">
      <i class="bi bi-printer"></i> Imprimir ticket
      <kbd style="margin-left:auto;background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:4px;padding:1px 6px;font-size: 10.5px;font-weight:800;color:var(--text-secondary);">F5</kbd>
    </button>

    <!-- Modal copia de ticket -->
    <div id="modalCopiaTicket" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
      <div style="background:var(--bg-surface);border-radius:14px;padding:28px 28px 22px;max-width:340px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.35);text-align:center;">
        <div style="width:52px;height:52px;border-radius:50%;background:rgba(99,102,241,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
          <i class="bi bi-printer" style="font-size:22px;color:#6366f1;"></i>
        </div>
        <div style="font-size: 18px;font-weight:800;color:var(--text-primary);margin-bottom:6px;">Imprimir copia?</div>
        <div style="font-size: 15px;color:var(--text-secondary);margin-bottom:20px;">
          El ticket del cliente ya se envio a imprimir.<br>Queres imprimir tambien la copia local?
        </div>
        <div style="display:flex;gap:10px;">
          <button onclick="imprimirCopiaTicket()" style="flex:1;padding:11px;border-radius:8px;border:none;background:#6366f1;color:#fff;font-size: 15.5px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:7px;">
            <i class="bi bi-files"></i> Si, imprimir copia
          </button>
          <button onclick="cerrarModalCopia()" style="flex:1;padding:11px;border-radius:8px;border:1.5px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-primary);font-size: 15.5px;font-weight:700;cursor:pointer;font-family:var(--font-body);">
            No, gracias
          </button>
        </div>
      </div>
    </div>

    <button
      onclick="abrirPdfFacturaExistente()"
      id="btnVerFacturaAfip"
      style="display:none;width:100%;margin-top:8px;padding:11px;border-radius:var(--radius-sm);border:1.5px solid var(--color-primary);background:rgba(27,79,216,.07);color:var(--color-primary);font-family:var(--font-body);font-size: 15.5px;font-weight:700;cursor:pointer;display:none;align-items:center;justify-content:center;gap:7px;">
      <i class="bi bi-download"></i> Ver factura emitida
    </button>

    <button class="btn-nueva-venta" onclick="nuevaVenta()">
      <i class="bi bi-plus-circle"></i> Nueva Venta
      <kbd style="margin-left:auto;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);border-radius:4px;padding:1px 6px;font-size: 10.5px;font-weight:800;">Enter</kbd>
    </button>

    <!-- ── Envío por email ── -->
    <div id="emailComprobanteWrap" style="margin-top:14px;border-top:1px solid var(--border-color);padding-top:14px;">
      <div style="font-size: 11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:8px;">
        <i class="bi bi-envelope" style="margin-right:4px;"></i>Enviar comprobante por email
      </div>
      <div style="display:flex;gap:8px;">
        <input type="email" id="emailDestinoInput" placeholder="cliente@email.com"
          style="flex:1;padding:9px 12px;border-radius:8px;font-size: 15px;border:1.5px solid var(--border-color);background:var(--bg-surface-2);color:var(--text-primary);outline:none;font-family:var(--font-body);">
        <button onclick="enviarComprobantePorEmail()"
          style="padding:9px 14px;border-radius:8px;border:none;background:var(--color-primary);color:#fff;font-size: 15px;font-weight:700;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;gap:6px;white-space:nowrap;transition:background .15s;">
          <i class="bi bi-send"></i> Enviar
        </button>
      </div>
      <div id="emailEnvioResult" style="font-size: 13.5px;font-weight:600;margin-top:6px;min-height:18px;"></div>
    </div>
  </div>
</div>

