<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vidriera — Admin oculto</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  :root{--brand-blue:#1B4FD8;--bg:#0C0E14;--card:#12141c;--border:rgba(255,255,255,.08);
    --text:#f4f4f5;--text-sub:#a1a1aa;--font:'Plus Jakarta Sans',system-ui,sans-serif;}
  body{background:var(--bg);color:var(--text);font-family:var(--font);padding:28px 18px;}
  .wrap{max-width:480px;margin:0 auto;}
  h1{font-size:19px;font-weight:800;margin-bottom:4px;}
  .sub{color:var(--text-sub);font-size:13px;margin-bottom:24px;}
  .card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:14px;}
  label{display:block;font-size:12.5px;font-weight:700;color:var(--text-sub);margin-bottom:6px;text-transform:uppercase;letter-spacing:.3px;}
  input[type=text],input[type=tel],textarea{width:100%;background:#181b25;border:1px solid var(--border);border-radius:9px;
    padding:10px 12px;color:var(--text);font-size:14px;font-family:inherit;margin-bottom:14px;}
  textarea{resize:vertical;min-height:60px;}
  .row-toggle{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .row-toggle .lbl{font-size:14px;font-weight:600;}
  .switch{position:relative;width:44px;height:24px;flex-shrink:0;}
  .switch input{opacity:0;width:0;height:0;}
  .slider{position:absolute;inset:0;background:#333;border-radius:12px;cursor:pointer;transition:.2s;}
  .slider::before{content:'';position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;}
  input:checked + .slider{background:var(--brand-blue);}
  input:checked + .slider::before{transform:translateX(20px);}
  .logo-zone{border:2px dashed var(--border);border-radius:12px;padding:16px;text-align:center;cursor:pointer;margin-bottom:14px;}
  .logo-zone img{max-height:110px;border-radius:8px;margin-bottom:8px;}
  .btn{width:100%;background:var(--brand-blue);color:#fff;border:none;border-radius:10px;padding:13px;font-size:14.5px;
    font-weight:700;cursor:pointer;}
  .link-box{background:#181b25;border:1px solid var(--border);border-radius:9px;padding:10px 12px;font-size:12.5px;
    color:var(--text-sub);word-break:break-all;margin-bottom:14px;}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0F6E56;color:#fff;padding:10px 18px;
    border-radius:9px;font-size:13.5px;font-weight:700;display:none;}
</style>
</head>
<body>
<div class="wrap">
  <h1><i class="bi bi-shop"></i> Vidriera digital</h1>
  <div class="sub">Panel oculto — <%= empresaNombre || 'este cliente' %></div>

  <div class="card">
    <div class="row-toggle">
      <span class="lbl">Catálogo activado</span>
      <label class="switch"><input type="checkbox" id="f_activa" <%= settings.activa ? 'checked' : '' %>><span class="slider"></span></label>
    </div>
    <div class="row-toggle">
      <span class="lbl">Mostrar precios</span>
      <label class="switch"><input type="checkbox" id="f_precios" <%= settings.mostrarPrecios ? 'checked' : '' %>><span class="slider"></span></label>
    </div>
  </div>

  <div class="card">
    <label>WhatsApp del negocio (con código de país, sin +)</label>
    <input type="tel" id="f_whatsapp" placeholder="5493834000000" value="<%= settings.vidriera_whatsapp || '' %>">

    <label>Mensaje inicial del pedido</label>
    <textarea id="f_mensaje"><%= settings.vidriera_mensaje || '' %></textarea>

    <label>Foto de portada</label>
    <div class="logo-zone" id="logoZone">
      <img id="portadaPreview" src="<%= settings.vidriera_portada || '' %>" style="<%= settings.vidriera_portada ? '' : 'display:none;' %>">
      <div id="logoZoneTxt"><i class="bi bi-image" style="font-size:22px;opacity:.5;"></i><div style="margin-top:6px;font-size:13px;color:var(--text-sub);">Click para elegir foto del local</div></div>
    </div>
    <input type="file" id="f_portada_file" accept="image/*" style="display:none;">
  </div>

  <div class="link-box"><i class="bi bi-link-45deg"></i> Link para compartir: <b>https://<%= empresaNombre ? '' : '' %>TU-DOMINIO/vidriera</b></div>

  <button class="btn" onclick="guardar()">Guardar cambios</button>
</div>

<div class="toast" id="toast">Guardado ✓</div>

<script>
const CLAVE = <%- JSON.stringify(clave || '') %>;
let portadaBase64 = null;

document.getElementById('logoZone').addEventListener('click', () => document.getElementById('f_portada_file').click());
document.getElementById('f_portada_file').addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const MAX = 1000; let w = img.width, h = img.height;
      if (w > MAX || h > MAX) { if (w > h) { h = Math.round(h*MAX/w); w = MAX; } else { w = Math.round(w*MAX/h); h = MAX; } }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      portadaBase64 = canvas.toDataURL('image/jpeg', 0.8);
      document.getElementById('portadaPreview').src = portadaBase64;
      document.getElementById('portadaPreview').style.display = 'block';
      document.getElementById('logoZoneTxt').style.display = 'none';
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
});

async function guardar(){
  const body = {
    clave: CLAVE,
    vidriera_activa: document.getElementById('f_activa').checked ? '1' : '0',
    vidriera_mostrar_precios: document.getElementById('f_precios').checked ? '1' : '0',
    vidriera_whatsapp: document.getElementById('f_whatsapp').value.trim(),
    vidriera_mensaje: document.getElementById('f_mensaje').value.trim(),
  };
  if (portadaBase64) body.vidriera_portada = portadaBase64;
  try {
    const r = await fetch('/admin/vidriera/api/guardar?clave=' + encodeURIComponent(CLAVE), {
      method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const data = await r.json();
    if (!data.ok) { alert('Error: ' + (data.error || 'no se pudo guardar')); return; }
    const t = document.getElementById('toast');
    t.style.display = 'block';
    setTimeout(()=>{ t.style.display = 'none'; }, 1800);
  } catch(e) { alert('Error de red: ' + e.message); }
}
</script>
</body>
</html>
