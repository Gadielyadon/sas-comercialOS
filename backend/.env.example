# ─────────────────────────────────────────────────────────────
# ComercialOS — Variables de entorno
# Copiá este archivo como .env y completá los valores
# NUNCA subas el archivo .env al repositorio
# ─────────────────────────────────────────────────────────────

# Entorno: development | production
NODE_ENV=production

# Puerto en el que corre la app (Nginx hace proxy a este puerto)
PORT=3000

# Secret para las sesiones — generá uno aleatorio largo y seguro
# Podés usar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-string-largo-y-aleatorio

# Clave de la API de Anthropic — necesaria para "Inventario · Carga automática"
# (escaneo de facturas de proveedores con IA). Se consigue en console.anthropic.com
ANTHROPIC_API_KEY=

# Clave para activar/administrar el Catálogo digital (Vidriera) de ESTE cliente.
# Elegí una clave propia para cada cliente — NUNCA la misma en dos negocios.
# Sin esto configurado, el catálogo no se puede activar.
VIDRIERA_ADMIN_KEY=